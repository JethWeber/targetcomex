<!-- NavMenu.razor -->
<nav class="target-navbar">
    <div class="navbar-container">
        <!-- Logo -->
        <div class="brand">
            <a href="/">
                <img src="logo-1.png" height="36" alt="Target Logo" />
            </a>
        </div>

        <!-- Links Desktop -->
        <div class="nav-links">
            <NavLink href="/" class="nav-link" Match="NavLinkMatch.All">Início</NavLink>
            <NavLink href="/produtos" class="nav-link">Produtos</NavLink>
            <NavLink href="/servicos" class="nav-link">Serviços</NavLink>
            <NavLink href="/sobre" class="nav-link">Sobre</NavLink>
            <NavLink href="/contacto" class="nav-link">Contactos</NavLink>
        </div>

        <!-- Auth + Mobile Menu Button -->
        <div class="nav-actions">
            <a href="login" class="btn-login">Entrar</a>
            <button class="hamburger" id="hamburger">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
        <div class="mobile-links">
            <NavLink href="" class="mobile-link">Início</NavLink>
            <NavLink href="produtos" class="mobile-link">Produtos</NavLink>
            <NavLink href="ia" class="mobile-link">IA Recomenda</NavLink>
            <NavLink href="sobre" class="mobile-link">Sobre</NavLink>
            <a href="login" class="btn-login mobile-btn">Entrar</a>
        </div>
    </div>
</nav>

<style>
    .target-navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background: rgba(0, 0, 0, 0.95);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(0, 242, 255, 0.15);
        z-index: 1000;
        transition: all 0.3s ease;
    }

    .navbar-container {
        max-width: 1300px;
        margin: 0 auto;
        padding: 0 40px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .brand img {
        transition: transform 0.3s ease;
    }

    .brand:hover img {
        transform: scale(1.08);
    }

    .nav-links {
        display: flex;
        gap: 32px;
        align-items: center;
    }

    .nav-link {
        color: #aaa;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.25s ease;
        position: relative;
    }

    .nav-link:hover,
    .nav-link.active {
        color: #00f2ff;
    }

    .nav-link.active::after {
        content: '';
        position: absolute;
        bottom: -6px;
        left: 0;
        width: 100%;
        height: 2px;
        background: #00f2ff;
        box-shadow: 0 0 8px #00f2ff;
    }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .btn-login {
        border: 1px solid #00f2ff;
        color: #00f2ff;
        padding: 10px 24px;
        border-radius: 999px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .btn-login:hover {
        background: #00f2ff;
        color: #000;
        box-shadow: 0 0 20px rgba(0, 242, 255, 0.4);
    }

    /* Hamburger */
    .hamburger {
        display: none;
        flex-direction: column;
        gap: 5px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
    }

    .hamburger span {
        width: 28px;
        height: 2px;
        background: #00f2ff;
        transition: all 0.3s ease;
    }

    /* Mobile Menu */
    .mobile-menu {
        display: none;
        position: absolute;
        top: 80px;
        left: 0;
        right: 0;
        background: #0a0a0a;
        border-top: 1px solid rgba(0, 242, 255, 0.15);
        padding: 20px;
    }

    .mobile-links {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .mobile-link {
        color: #ddd;
        text-decoration: none;
        font-size: 1.1rem;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    /* Responsividade */
    @@media (max-width: 992px) {
        .nav-links {
            display: none;
        }
        .hamburger {
            display: flex;
        }
        .mobile-menu.show {
            display: block;
        }
    }
</style>

<script>
    const hamburger = document.getElementById('hamburger');
    const mobileMenu = document.getElementById('mobileMenu');

    hamburger.addEventListener('click', () => {
        mobileMenu.classList.toggle('show');
        
        // Animação do hamburger (opcional)
        const spans = hamburger.querySelectorAll('span');
        if (mobileMenu.classList.contains('show')) {
            spans[0].style.transform = 'rotate(45deg) translate(5px, 5px)';
            spans[1].style.opacity = '0';
            spans[2].style.transform = 'rotate(-45deg) translate(7px, -6px)';
        } else {
            spans[0].style.transform = 'none';
            spans[1].style.opacity = '1';
            spans[2].style.transform = 'none';
        }
    });
</script>