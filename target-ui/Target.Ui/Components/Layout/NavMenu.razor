<!-- NavMenu.razor -->
@inject Target.Ui.Services.AuthService AuthService
<nav class="target-navbar">
    <div class="navbar-container">
        <!-- Logo -->
        <div class="brand">
            <a href="/">
                <img src="logo-1.png" height="36" alt="Target Logo" />
            </a>
        </div>

        <!-- Links Desktop -->
        <div class="nav-links">
            <NavLink href="/" class="nav-link" Match="NavLinkMatch.All">Início</NavLink>
            <NavLink href="/produtos" class="nav-link">Produtos</NavLink>
            <NavLink href="/servicos" class="nav-link">Serviços</NavLink>
            <NavLink href="/sobre" class="nav-link">Sobre</NavLink>
            <NavLink href="/contacto" class="nav-link">Contactos</NavLink>
        </div>

        <!-- Auth + Mobile Menu Button -->
        <div class="nav-actions">
            @if (!isAuthenticated)
            {
                <a href="login" class="btn-login">Entrar</a>
            }
            else
            {
                <button class="btn-login" @onclick="ToggleProfile">Perfil</button>
            }
            <button class="hamburger" id="hamburger">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
        <div class="mobile-links">
            <NavLink href="" class="mobile-link">Início</NavLink>
            <NavLink href="produtos" class="mobile-link">Produtos</NavLink>
            <NavLink href="ia" class="mobile-link">IA Recomenda</NavLink>
            <NavLink href="sobre" class="mobile-link">Sobre</NavLink>
            @if (!isAuthenticated)
            {
                <a href="login" class="btn-login mobile-btn">Entrar</a>
            }
            else
            {
                <button class="btn-login mobile-btn" @onclick="ToggleProfile">Perfil</button>
            }
        </div>
    </div>
</nav>

<!-- Perfil Modal -->
@if (showProfileModal)
{
    <div class="modal-backdrop" @onclick="CloseProfile"></div>
    <div class="profile-modal">
        <div class="profile-content">
            <h3>Perfil</h3>
            <div class="profile-actions">
                @if (roleNormalized == "cliente")
                {
                    <NavLink href="/area-cliente" class="btn-login" @onclick="CloseProfile">Área do Cliente</NavLink>
                }
                <button class="btn-login" @onclick="OnLogout">Sair</button>
            </div>
            <button class="modal-close" @onclick="CloseProfile">Fechar</button>
        </div>
    </div>
}

@code {
    private bool isAuthenticated = false;
    private string? userRole;
    private string? roleNormalized;
    private bool showProfileModal = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthService.InitAsync();
            isAuthenticated = await AuthService.IsAuthenticatedAsync();
            userRole = await AuthService.GetRoleAsync();
            roleNormalized = userRole?.Trim().ToLowerInvariant();
            StateHasChanged();
        }
    }

    private void ToggleProfile()
    {
        showProfileModal = !showProfileModal;
    }

    private void CloseProfile()
    {
        showProfileModal = false;
    }

    private async Task OnLogout()
    {
        showProfileModal = false;
        await AuthService.LogoutAsync();
    }
}

<style>
    .target-navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background: rgba(0, 0, 0, 0.95);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(0, 242, 255, 0.15);
        z-index: 1000;
        transition: all 0.3s ease;
    }

    .navbar-container {
        max-width: 1300px;
        margin: 0 auto;
        padding: 0 40px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .brand img {
        transition: transform 0.3s ease;
    }

    .brand:hover img {
        transform: scale(1.08);
    }

    .nav-links {
        display: flex;
        gap: 32px;
        align-items: center;
    }

    .nav-link {
        color: #aaa;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.25s ease;
        position: relative;
    }

    .nav-link:hover,
    .nav-link.active {
        color: #00f2ff;
    }

    .nav-link.active::after {
        content: '';
        position: absolute;
        bottom: -6px;
        left: 0;
        width: 100%;
        height: 2px;
        background: #00f2ff;
        box-shadow: 0 0 8px #00f2ff;
    }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .btn-login {
        border: 1px solid #00f2ff;
        color: #00f2ff;
        padding: 10px 24px;
        border-radius: 999px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .btn-login:hover {
        background: #00f2ff;
        color: #000;
        box-shadow: 0 0 20px rgba(0, 242, 255, 0.4);
    }

    /* Hamburger */
    .hamburger {
        display: none;
        flex-direction: column;
        gap: 5px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
    }

    .hamburger span {
        width: 28px;
        height: 2px;
        background: #00f2ff;
        transition: all 0.3s ease;
    }

    /* Mobile Menu */
    .mobile-menu {
        display: none;
        position: absolute;
        top: 80px;
        left: 0;
        right: 0;
        background: #0a0a0a;
        border-top: 1px solid rgba(0, 242, 255, 0.15);
        padding: 20px;
    }

    .mobile-links {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .mobile-link {
        color: #ddd;
        text-decoration: none;
        font-size: 1.1rem;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    /* Perfil Modal */
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.6);
        z-index: 1100;
    }

    .profile-modal {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: #0f0f10;
        border: 1px solid rgba(0,242,255,0.12);
        padding: 18px;
        border-radius: 8px;
        z-index: 1110;
        min-width: 260px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.6);
    }

    .profile-content h3 {
        margin: 0 0 12px 0;
        color: #fff;
    }

    .profile-actions { display:flex; gap:10px; align-items:center; }

    .modal-close { margin-top:12px; background:transparent; border:1px solid rgba(255,255,255,0.04); color:#bbb; padding:6px 10px; border-radius:6px; }

    /* Responsividade */
    @@media (max-width: 992px) {
        .nav-links {
            display: none;
        }
        .hamburger {
            display: flex;
        }
        .mobile-menu.show {
            display: block;
        }
    }
</style>

<script>
    const hamburger = document.getElementById('hamburger');
    const mobileMenu = document.getElementById('mobileMenu');

    hamburger.addEventListener('click', () => {
        mobileMenu.classList.toggle('show');
        
        // Animação do hamburger (opcional)
        const spans = hamburger.querySelectorAll('span');
        if (mobileMenu.classList.contains('show')) {
            spans[0].style.transform = 'rotate(45deg) translate(5px, 5px)';
            spans[1].style.opacity = '0';
            spans[2].style.transform = 'rotate(-45deg) translate(7px, -6px)';
        } else {
            spans[0].style.transform = 'none';
            spans[1].style.opacity = '1';
            spans[2].style.transform = 'none';
        }
    });
</script>