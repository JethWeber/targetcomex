@page "/admin"
@rendermode InteractiveServer
@layout EmptyLayout
@using Microsoft.AspNetCore.Components.Forms
@inject ApiClient Api
@inject AuthService AuthService
@inject NavigationManager Nav

<h2 class="sr-only">Painel de Administração — Target Comex</h2>

<!-- ═══════════════════════════════════════════════════
     ADMIN DASHBOARD — TARGET COMEX
     Identidade: Cyberpunk / Ciano · Preto · Roxo
═══════════════════════════════════════════════════ -->

<div class="adm-shell">

    <!-- ══ SIDEBAR ══ -->
    <aside class="adm-side @(SideOpen ? "open" : "")">
        <div class="adm-logo">
            <span class="adm-logo-t">T</span>
            <div>
                <div class="adm-logo-name">TARGET</div>
                <div class="adm-logo-sub">ADMIN CORE</div>
            </div>
        </div>

        <nav class="adm-nav">
            <div class="adm-nav-group">SISTEMA</div>
            @foreach (var item in NavItems)
            {
                var it = item;
                <button class="adm-nav-item @(ActiveTab == it.Id ? "on" : "")"
                        @onclick="() => { ActiveTab = it.Id; SideOpen = false; }">
                    <span class="adm-nav-ico">@((MarkupString)it.Icon)</span>
                    <span class="adm-nav-lbl">@it.Label</span>
                    @if (it.Badge > 0)
                    {
                        <span class="adm-badge">@it.Badge</span>
                    }
                </button>
            }

            <div class="adm-nav-group" style="margin-top:18px">SESSÃO</div>
            <button class="adm-nav-item adm-nav-danger" @onclick="Logout">
                <span class="adm-nav-ico">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                </span>
                <span class="adm-nav-lbl">Terminar Sessão</span>
            </button>
        </nav>

        <div class="adm-side-foot">
            <div class="adm-admin-av">AD</div>
            <div>
                <div class="adm-admin-name">Admin Root</div>
                <div class="adm-admin-role">Nível 5 · Acesso Total</div>
            </div>
            <div class="adm-status-dot"></div>
        </div>
    </aside>

    <!-- ══ MAIN ══ -->
    <main class="adm-main">

        <!-- Top bar -->
        <header class="adm-topbar">
            <button class="adm-menu-btn" @onclick="() => SideOpen = !SideOpen">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <line x1="3" y1="12" x2="21" y2="12"/>
                    <line x1="3" y1="18" x2="21" y2="18"/>
                </svg>
            </button>
            <div class="adm-breadcrumb">
                <span class="adm-bc-root">TARGET / ADMIN</span>
                <span class="adm-bc-sep">›</span>
                <span class="adm-bc-cur">@NavItems.FirstOrDefault(n => n.Id == ActiveTab)?.Label</span>
            </div>
            <div class="adm-topbar-right">
                <div class="adm-topbar-time">@DateTime.Now.ToString("HH:mm")</div>
                <div class="adm-notif">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                    <span class="adm-notif-dot"></span>
                </div>
            </div>
        </header>

        <!-- ══════ OVERVIEW ══════ -->
        @if (ActiveTab == "overview")
        {
            <div class="adm-content">
                <div class="adm-page-hdr">
                    <h1 class="adm-page-title">VISÃO GERAL</h1>
                    <p class="adm-page-sub">Sistema operacional · Todos os módulos activos</p>
                </div>

                <!-- KPI cards -->
                <div class="adm-kpis">
                    @foreach (var kpi in Kpis)
                    {
                        <div class="adm-kpi @kpi.Color">
                            <div class="adm-kpi-top">
                                <span class="adm-kpi-lbl">@kpi.Label</span>
                                <span class="adm-kpi-ico">@((MarkupString)kpi.Icon)</span>
                            </div>
                            <div class="adm-kpi-val">@kpi.Value</div>
                            <div class="adm-kpi-delta @(kpi.DeltaUp ? "up" : "down")">
                                @(kpi.DeltaUp ? "▲" : "▼") @kpi.Delta este mês
                            </div>
                        </div>
                    }
                </div>

                <!-- Reservas recentes + actividade -->
                <div class="adm-grid2">
                    <div class="adm-panel">
                        <div class="adm-panel-hdr">
                            <span class="adm-panel-title">RESERVAS RECENTES</span>
                            <button class="adm-btn-ghost" @onclick='() => ActiveTab = "reservas"'>Ver todas</button>
                        </div>
                        <table class="adm-table">
                            <thead>
                                <tr>
                                    <th>ID</th><th>Cliente</th><th>Veículo</th><th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Reservas.Take(5))
                                {
                                    <tr>
                                        <td class="adm-mono">#@r.Id</td>
                                        <td>@r.Cliente</td>
                                        <td class="adm-dim">@r.Veiculo</td>
                                        <td><span class="adm-pill @EstadoClass(r.Estado)">@r.Estado</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="adm-panel">
                        <div class="adm-panel-hdr">
                            <span class="adm-panel-title">LOG DE ACTIVIDADE</span>
                        </div>
                        <div class="adm-log">
                            @foreach (var log in Logs)
                            {
                                <div class="adm-log-item">
                                    <span class="adm-log-dot @log.Type"></span>
                                    <div>
                                        <div class="adm-log-msg">@log.Msg</div>
                                        <div class="adm-log-time">@log.Time</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ══════ CARROS ══════ -->
        @if (ActiveTab == "carros")
        {
            <div class="adm-content">
                <div class="adm-page-hdr">
                    <div>
                        <h1 class="adm-page-title">GESTÃO DE CARROS</h1>
                        <p class="adm-page-sub">@Carros.Count veículos no sistema</p>
                    </div>
                    <button class="adm-btn-primary" @onclick="AbrirModalCarro">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        Novo Veículo
                    </button>
                </div>

                <!-- Filtros -->
                <div class="adm-filters">
                    <input class="adm-search" type="text" placeholder="Pesquisar marca, modelo..." @bind="FiltroCarros" @bind:event="oninput" />
                    <select class="adm-select" @bind="FiltroEstadoCarro">
                        <option value="">Todos os estados</option>
                        <option>Disponível</option>
                        <option>Reservado</option>
                        <option>Vendido</option>
                    </select>
                </div>

                <!-- Cards de veículos -->
                <div class="adm-car-grid">
                    @foreach (var c in CarrosFiltrados)
                    {
                        var carro = c;
                        <div class="adm-car-card">
                            <div class="adm-car-img-wrap">
                                <img src="@(string.IsNullOrEmpty(carro.ImagemUrl) ? "img/cars/default.jpg" : carro.ImagemUrl)"
                                     alt="@carro.Marca @carro.Modelo"
                                     class="adm-car-img"
                                     loading="lazy" />
                                <div class="adm-car-badge">@carro.Combustivel</div>
                                <span class="adm-pill @EstadoCarroClass(carro.Estado) adm-car-estado-pill">@carro.Estado</span>
                                <div class="adm-car-id adm-mono">#@carro.Id</div>
                            </div>
                            <div class="adm-car-body">
                                <div class="adm-car-meta">
                                    <span class="adm-car-ano">@carro.Ano</span>
                                    <span class="adm-car-transm">@carro.Transmissao</span>
                                </div>
                                <h4 class="adm-car-name">@carro.Marca @carro.Modelo</h4>
                                <div class="adm-car-specs">
                                    @if (!string.IsNullOrEmpty(carro.Motor))
                                    {
                                        <span>⚙ @carro.Motor</span>
                                    }
                                    @if (carro.Potencia.HasValue && carro.Potencia > 0)
                                    {
                                        <span>🏎 @carro.Potencia cv</span>
                                    }
                                    @if (!string.IsNullOrEmpty(carro.Localizacao))
                                    {
                                        <span>📍 @carro.Localizacao</span>
                                    }
                                </div>
                                <div class="adm-car-footer">
                                    <div class="adm-car-price adm-cyan adm-mono">AOA @carro.Preco.ToString("N0")</div>
                                    <div class="adm-actions">
                                        <button class="adm-act-btn" title="Editar" @onclick="() => EditarCarro(carro)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                        </button>
                                        <button class="adm-act-btn adm-act-danger" title="Eliminar" @onclick="() => EliminarCarro(carro.Id)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (!CarrosFiltrados.Any())
                {
                    <div class="adm-empty">Nenhum veículo encontrado</div>
                }
            </div>
        }

        <!-- ══════ UTILIZADORES ══════ -->
        @if (ActiveTab == "users")
        {
            <div class="adm-content">
                <div class="adm-page-hdr">
                    <div>
                        <h1 class="adm-page-title">UTILIZADORES</h1>
                        <p class="adm-page-sub">@Utilizadores.Count contas registadas</p>
                    </div>
                    <button class="adm-btn-primary">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        Novo Utilizador
                    </button>
                </div>

                <div class="adm-filters">
                    <input class="adm-search" type="text" placeholder="Nome, telefone..." @bind="FiltroUsers" @bind:event="oninput" />
                    <select class="adm-select" @bind="FiltroPerfilUser">
                        <option value="">Todos os perfis</option>
                        <option>Admin</option>
                        <option>Cliente</option>
                    </select>
                </div>

                <div class="adm-user-grid">
                    @foreach (var u in UtilizadoresFiltrados)
                    {
                        var user = u;
                        <div class="adm-user-card">
                            <div class="adm-user-av">@user.Iniciais</div>
                            <div class="adm-user-info">
                                <div class="adm-user-name">@user.Nome</div>
                                <div class="adm-user-tel">@user.Telefone</div>
                                <div class="adm-user-meta">
                                    <span>@user.Provincia</span>
                                    <span class="adm-pill @(user.Perfil == "Admin" ? "adm-pill-admin" : "adm-pill-info")">@user.Perfil</span>
                                </div>
                            </div>
                            <div class="adm-user-actions">
                                <button class="adm-act-btn" title="Editar">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </button>
                                <button class="adm-act-btn adm-act-danger" title="Eliminar" @onclick="() => EliminarUser(user.Id)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                @if (!UtilizadoresFiltrados.Any())
                {
                    <div class="adm-empty">Nenhum utilizador encontrado</div>
                }
            </div>
        }

        <!-- ══════ RESERVAS ══════ -->
        @if (ActiveTab == "reservas")
        {
            <div class="adm-content">
                <div class="adm-page-hdr">
                    <div>
                        <h1 class="adm-page-title">RESERVAS</h1>
                        <p class="adm-page-sub">@Reservas.Count reservas no sistema</p>
                    </div>
                </div>

                <div class="adm-filters">
                    <select class="adm-select" @bind="FiltroEstadoReserva">
                        <option value="">Todos os estados</option>
                        <option>Pendente</option>
                        <option>Confirmada</option>
                        <option>Cancelada</option>
                        <option>Concluída</option>
                    </select>
                </div>

                <div class="adm-reservas">
                    @foreach (var r in ReservasFiltradas)
                    {
                        var res = r;
                        <div class="adm-res-card">
                            <div class="adm-res-id adm-mono">#@res.Id</div>
                            <div class="adm-res-info">
                                <div class="adm-res-cliente">@res.Cliente</div>
                                <div class="adm-res-veiculo">@res.Veiculo</div>
                                <div class="adm-res-data adm-dim">@res.Data</div>
                            </div>
                            <div class="adm-res-preco adm-cyan adm-mono">@res.Preco.ToString("N0") AOA</div>
                            <div class="adm-res-estado">
                                <span class="adm-pill @EstadoClass(res.Estado)">@res.Estado</span>
                            </div>
                            <div class="adm-res-actions">
                                @foreach (var s in EstadosSeguintes(res.Estado))
                                {
                                    var estado = s;
                                    <button class="adm-btn-estado @EstadoBtnClass(estado)"
                                            @onclick="() => MudarEstadoReserva(res.Id, estado)">
                                        @estado
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (!ReservasFiltradas.Any())
                {
                    <div class="adm-empty">Nenhuma reserva encontrada</div>
                }
            </div>
        }

    </main>
</div>

<!-- ══ MODAL CARRO ══ -->
@if (ModalCarroAberto)
{
    <div class="adm-modal-bg" @onclick="FecharModalCarro">
        <div class="adm-modal" @onclick:stopPropagation>
            <div class="adm-modal-hdr">
                <h2 class="adm-modal-title">@(CarroEdit?.Id == 0 ? "NOVO VEÍCULO" : "EDITAR VEÍCULO")</h2>
                <button class="adm-modal-close" @onclick="FecharModalCarro">✕</button>
            </div>
            @if (CarroEdit != null)
            {
                <div class="adm-modal-body">

                    <!-- Progresso do wizard -->
                    <div class="adm-wiz-progtext">Passo @CarroStep de @CarroTotalSteps</div>
                    <div class="adm-wiz-progbar">
                        <div class="adm-wiz-progfill" style="width: @(CarroStep * 100 / CarroTotalSteps)%"></div>
                    </div>
                    <div class="adm-wiz-steps">
                        @for (int i = 1; i <= CarroTotalSteps; i++)
                        {
                            int idx = i;
                            <div class="adm-wiz-dot @(idx < CarroStep ? "done" : idx == CarroStep ? "active" : "")">
                                @if (idx < CarroStep) { <span>✓</span> } else { <span>@idx</span> }
                            </div>
                            @if (i < CarroTotalSteps)
                            {
                                <div class="adm-wiz-line @(idx < CarroStep ? "done" : "")"></div>
                            }
                        }
                    </div>

                    <!-- PASSO 1: IDENTIFICAÇÃO -->
                    @if (CarroStep == 1)
                    {
                        <h3 class="adm-wiz-title">IDENTIFICAÇÃO</h3>
                        <p class="adm-wiz-sub">Dados básicos do veículo</p>

                        <div class="adm-row2">
                            <div class="adm-field">
                                <label>Marca <span class="req">*</span></label>
                                <input class="adm-inp" type="text" @bind="CarroEdit.Marca" placeholder="Toyota" />
                            </div>
                            <div class="adm-field">
                                <label>Modelo <span class="req">*</span></label>
                                <input class="adm-inp" type="text" @bind="CarroEdit.Modelo" placeholder="Corolla" />
                            </div>
                        </div>
                        <div class="adm-row2">
                            <div class="adm-field">
                                <label>Ano <span class="req">*</span></label>
                                <input class="adm-inp" type="number" @bind="CarroEdit.Ano" min="2000" max="2026" />
                            </div>
                            <div class="adm-field">
                                <label>Estilo</label>
                                <select class="adm-inp" @bind="CarroEdit.Estilo">
                                    <option value="">— Seleccionar —</option>
                                    <option>Sedan</option>
                                    <option>SUV</option>
                                    <option>Pick-up</option>
                                    <option>Hatchback</option>
                                    <option>Coupé</option>
                                    <option>Monovolume</option>
                                </select>
                            </div>
                        </div>
                    }

                    <!-- PASSO 2: ESPECIFICAÇÕES -->
                    @if (CarroStep == 2)
                    {
                        <h3 class="adm-wiz-title">ESPECIFICAÇÕES TÉCNICAS</h3>
                        <p class="adm-wiz-sub">Motor, transmissão e estado de uso</p>

                        <div class="adm-row2">
                            <div class="adm-field">
                                <label>Combustível</label>
                                <select class="adm-inp" @bind="CarroEdit.Combustivel">
                                    <option>Gasolina</option>
                                    <option>Gasóleo</option>
                                    <option>Híbrido</option>
                                    <option>Eléctrico</option>
                                </select>
                            </div>
                            <div class="adm-field">
                                <label>Transmissão</label>
                                <select class="adm-inp" @bind="CarroEdit.Transmissao">
                                    <option>Automática</option>
                                    <option>Manual</option>
                                </select>
                            </div>
                        </div>
                        <div class="adm-row2">
                            <div class="adm-field">
                                <label>Motor</label>
                                <input class="adm-inp" type="text" @bind="CarroEdit.Motor" placeholder="2.0 TDI" />
                            </div>
                            <div class="adm-field">
                                <label>Potência (CV)</label>
                                <input class="adm-inp" type="number" @bind="CarroEdit.Potencia" placeholder="150" />
                            </div>
                        </div>
                        <div class="adm-row2">
                            <div class="adm-field">
                                <label>Cor</label>
                                <input class="adm-inp" type="text" @bind="CarroEdit.Cor" placeholder="Preto" />
                            </div>
                            <div class="adm-field">
                                <label>Quilometragem (km)</label>
                                <input class="adm-inp" type="number" @bind="CarroEdit.Quilometragem" placeholder="0" />
                            </div>
                        </div>
                    }

                    <!-- PASSO 3: LOCALIZAÇÃO & DESCRIÇÃO -->
                    @if (CarroStep == 3)
                    {
                        <h3 class="adm-wiz-title">LOCALIZAÇÃO &amp; DESCRIÇÃO</h3>
                        <p class="adm-wiz-sub">Onde está e o que o torna especial</p>

                        <div class="adm-field">
                            <label>Localização</label>
                            <input class="adm-inp" type="text" @bind="CarroEdit.Localizacao" placeholder="Luanda · Talatona" />
                        </div>
                        <div class="adm-field">
                            <label>Descrição</label>
                            <textarea class="adm-inp adm-textarea" @bind="CarroEdit.Descricao" placeholder="Descrição do veículo..."></textarea>
                        </div>
                        <div class="adm-field">
                            <label>Estado</label>
                            <select class="adm-inp" @bind="CarroEdit.Estado">
                                <option>Disponível</option>
                                <option>Reservado</option>
                                <option>Vendido</option>
                            </select>
                        </div>
                    }

                    <!-- PASSO 4: IMAGEM & PREÇO -->
                    @if (CarroStep == 4)
                    {
                        <h3 class="adm-wiz-title">IMAGEM &amp; PREÇO</h3>
                        <p class="adm-wiz-sub">Última etapa antes de publicar</p>

                        <div class="adm-field">
                            <label>Fotografia do Veículo</label>
                            <div class="adm-upload-zone @(string.IsNullOrEmpty(ImagemPreviewUrl) ? "" : "has-image")">
                                @if (!string.IsNullOrEmpty(ImagemPreviewUrl))
                                {
                                    <img src="@ImagemPreviewUrl" alt="Pré-visualização" class="adm-upload-preview" />
                                    <button type="button" class="adm-upload-remove" @onclick="RemoverImagem" @onclick:stopPropagation>
                                        ✕ Remover
                                    </button>
                                }
                                else
                                {
                                    <div class="adm-upload-placeholder">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="30" height="30">
                                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                            <polyline points="7 9 12 4 17 9" />
                                            <line x1="12" y1="4" x2="12" y2="16" />
                                        </svg>
                                        <span class="adm-upload-title">Clique ou arraste uma imagem</span>
                                        <span class="adm-upload-hint">PNG ou JPG · até 5MB</span>
                                    </div>
                                }
                                <InputFile class="adm-upload-input" OnChange="OnImagemSelecionada" accept="image/*" />
                            </div>
                            @if (UploadEmProgresso)
                            {
                                <div class="adm-upload-status">A carregar imagem...</div>
                            }
                            @if (!string.IsNullOrEmpty(UploadErro))
                            {
                                <div class="adm-erro">@UploadErro</div>
                            }
                        </div>

                        <div class="adm-field">
                            <label>Preço (AOA) <span class="req">*</span></label>
                            <input class="adm-inp" type="number" @bind="CarroEdit.Preco" />
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(ModalErro))
                    {
                        <div class="adm-erro">@ModalErro</div>
                    }
                </div>
                <div class="adm-modal-foot">
                    <button class="adm-btn-ghost" @onclick="FecharModalCarro">Cancelar</button>
                    <div class="adm-modal-foot-right">
                        @if (CarroStep > 1)
                        {
                            <button class="adm-btn-back-step" @onclick="VoltarCarroStep">← Voltar</button>
                        }
                        @if (CarroStep < CarroTotalSteps)
                        {
                            <button class="adm-btn-primary" @onclick="AvancarCarroStep">Continuar →</button>
                        }
                        else
                        {
                            <button class="adm-btn-primary" @onclick="async () => await SalvarCarro()">
                                @(CarroEdit.Id == 0 ? "Adicionar" : "Guardar")
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private string ActiveTab = "overview";
    private bool SideOpen = false;

    /* ── Filtros ─────────────────────────── */
    private string FiltroCarros = "";
    private string FiltroEstadoCarro = "";
    private string FiltroUsers = "";
    private string FiltroPerfilUser = "";
    private string FiltroEstadoReserva = "";

    /* ── Modal Carro ─────────────────────── */
    private bool ModalCarroAberto = false;
    private Carro? CarroEdit;
    private string ModalErro = "";

    /* ── Wizard de passos do carro ────────── */
    private int CarroStep = 1;
    private const int CarroTotalSteps = 4;

    /* ── Upload de imagem ─────────────────── */
    private string? ImagemPreviewUrl;
    private bool UploadEmProgresso = false;
    private string UploadErro = "";
    private const long TamanhoMaxImagemBytes = 5 * 1024 * 1024;


    /* ══ NAV ══ */
    private List<NavItem> NavItems = new()
    {
        new("overview",  "OVERVIEW",     Svg.Dashboard, 0),
        new("carros",    "CARROS",        Svg.Car,       0),
        new("users",     "UTILIZADORES",  Svg.Users,     0),
        new("reservas",  "RESERVAS",      Svg.Reservas,  3),
    };

    /* ══ KPIs ══ */
    private List<Kpi> Kpis = new()
    {
        new("Total Veículos",  "—",  "+0", true, "kpi-cyan",   Svg.Car),
        new("Utilizadores",    "—",  "+0", true, "kpi-purple", Svg.Users),
        new("Reservas Activas","—",  "+0", true, "kpi-green",  Svg.Reservas),
        new("Receita (AOA)",   "—",  "+0", true, "kpi-gold",   Svg.Money),
    };

    /* ══ LOGS ══ */
    private List<LogEntry> Logs = new()
    {
        new("Nova reserva #RES-041 criada", "há 2 min",  "info"),
        new("Carro #C-022 marcado como Vendido", "há 8 min", "success"),
        new("Utilizador João Malheiro registado", "há 14 min","info"),
        new("Reserva #RES-038 cancelada pelo cliente", "há 31 min","warn"),
        new("Carro #C-009 actualizado", "há 1h","info"),
        new("Login de admin detectado (IP 197.x)", "há 2h","warn"),
    };

    private bool isLoading = true;
    private string? apiError;

    /* ══ CARROS ══ */
    private List<Carro> Carros = new();

    private IEnumerable<Carro> CarrosFiltrados => Carros
        .Where(c => string.IsNullOrEmpty(FiltroCarros)
                    || ($"{c.Marca} {c.Modelo}").Contains(FiltroCarros, StringComparison.OrdinalIgnoreCase))
        .Where(c => string.IsNullOrEmpty(FiltroEstadoCarro) || c.Estado == FiltroEstadoCarro);

    /* ══ UTILIZADORES ══ */
    private List<UsuarioDto> Utilizadores = new();

    private IEnumerable<UsuarioDto> UtilizadoresFiltrados => Utilizadores
        .Where(u => string.IsNullOrEmpty(FiltroUsers)
                    || u.Nome.Contains(FiltroUsers, StringComparison.OrdinalIgnoreCase)
                    || (u.Telefone?.Contains(FiltroUsers, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(u => string.IsNullOrEmpty(FiltroPerfilUser) || u.Perfil == FiltroPerfilUser);

    /* ══ RESERVAS ══ */
    private List<ReservaUi> Reservas = new();

    private IEnumerable<ReservaUi> ReservasFiltradas => Reservas
        .Where(r => string.IsNullOrEmpty(FiltroEstadoReserva) || r.Estado == FiltroEstadoReserva)
        .OrderByDescending(r => r.Id);

    /* ══ ACÇÕES ══ */
    private void AbrirModalCarro()
    {
        CarroEdit = new Carro
        {
            Id            = 0,
            Marca         = "",
            Modelo        = "",
            Ano           = DateTime.Now.Year,
            Preco         = 0,
            Combustivel   = "Gasolina",
            Transmissao   = "Automática",
            Estado        = "Disponível",
            Cor           = null,
            Estilo        = null,
            Motor         = null,
            Potencia      = null,
            Descricao     = null,
            ImagemUrl     = null,
            Localizacao   = null,
            Quilometragem = null
        };
        ModalErro = "";
        CarroStep = 1;
        ImagemPreviewUrl = null;
        UploadErro = "";
        ModalCarroAberto = true;
    }

    private void EditarCarro(Carro c)
    {
        CarroEdit = new Carro
        {
            Id            = c.Id,
            Marca         = c.Marca,
            Modelo        = c.Modelo,
            Ano           = c.Ano,
            Preco         = c.Preco,
            Combustivel   = c.Combustivel,
            Transmissao   = c.Transmissao,
            Estado        = c.Estado,
            Cor           = c.Cor,
            Estilo        = c.Estilo,
            Motor         = c.Motor,
            Potencia      = c.Potencia,
            Descricao     = c.Descricao,
            ImagemUrl     = c.ImagemUrl,
            Localizacao   = c.Localizacao,
            Quilometragem = c.Quilometragem
        };
        ModalErro = "";
        CarroStep = 1;
        ImagemPreviewUrl = c.ImagemUrl;
        UploadErro = "";
        ModalCarroAberto = true;
    }

    private async Task SalvarCarro()
    {
        if (CarroEdit == null) return;
        if (string.IsNullOrWhiteSpace(CarroEdit.Marca) || string.IsNullOrWhiteSpace(CarroEdit.Modelo))
        { ModalErro = "Marca e Modelo são obrigatórios."; return; }
        if (CarroEdit.Preco <= 0)
        { ModalErro = "Insira um preço válido."; return; }

        var request = new CreateVeiculoRequest
        {
            Marca         = CarroEdit.Marca,
            Modelo        = CarroEdit.Modelo,
            Ano           = CarroEdit.Ano,
            Preco         = CarroEdit.Preco,
            Combustivel   = CarroEdit.Combustivel,
            Transmissao   = CarroEdit.Transmissao,
            Cor           = CarroEdit.Cor,
            Estilo        = CarroEdit.Estilo,
            Motor         = CarroEdit.Motor,
            Potencia      = CarroEdit.Potencia,
            Descricao     = CarroEdit.Descricao,
            ImagemUrl     = CarroEdit.ImagemUrl,
            Localizacao   = CarroEdit.Localizacao,
            Quilometragem = CarroEdit.Quilometragem,
            Disponivel    = CarroEdit.Estado == "Disponível"
        };

        if (CarroEdit.Id == 0)
        {
            var result = await Api.CreateVeiculoAsync(request);
            if (result.Success)
            {
                Carros.Add(new Carro
                {
                    Id            = result.Data!.Id,
                    Marca         = result.Data.Marca,
                    Modelo        = result.Data.Modelo,
                    Ano           = result.Data.Ano,
                    Preco         = (long)Math.Round(result.Data.Preco),
                    Combustivel   = result.Data.Combustivel   ?? "",
                    Transmissao   = result.Data.Transmissao   ?? "",
                    Estado        = result.Data.Disponivel    ? "Disponível" : "Vendido",
                    Cor           = result.Data.Cor,
                    Estilo        = result.Data.Estilo,
                    Motor         = result.Data.Motor,
                    Potencia      = result.Data.Potencia,
                    Descricao     = result.Data.Descricao,
                    ImagemUrl     = result.Data.ImagemUrl,
                    Localizacao   = result.Data.Localizacao,
                    Quilometragem = result.Data.Quilometragem
                });
                FecharModalCarro();
            }
            else
            {
                ModalErro = result.Error ?? "Erro ao criar veículo.";
            }
        }
        else
        {
            var result = await Api.UpdateVeiculoAsync(CarroEdit.Id, request);
            if (result.Success)
            {
                var idx = Carros.FindIndex(c => c.Id == CarroEdit.Id);
                if (idx >= 0) Carros[idx] = CarroEdit;
                FecharModalCarro();
            }
            else
            {
                ModalErro = result.Error ?? "Erro ao actualizar veículo.";
            }
        }
    }

    private void FecharModalCarro()
    {
        ModalCarroAberto = false;
        CarroEdit = null;
        ModalErro = "";
        CarroStep = 1;
        ImagemPreviewUrl = null;
        UploadErro = "";
    }

    /* ── Navegação do wizard ──────────────── */
    private void AvancarCarroStep()
    {
        ModalErro = "";
        if (!ValidarCarroStep()) return;
        if (CarroStep < CarroTotalSteps) CarroStep++;
    }

    private void VoltarCarroStep()
    {
        ModalErro = "";
        if (CarroStep > 1) CarroStep--;
    }

    private bool ValidarCarroStep()
    {
        if (CarroEdit == null) return false;

        if (CarroStep == 1)
        {
            if (string.IsNullOrWhiteSpace(CarroEdit.Marca) || string.IsNullOrWhiteSpace(CarroEdit.Modelo))
            { ModalErro = "Marca e Modelo são obrigatórios."; return false; }
            if (CarroEdit.Ano < 2000 || CarroEdit.Ano > 2026)
            { ModalErro = "Insira um ano válido."; return false; }
        }

        return true;
    }

    /* ── Upload de imagem ─────────────────── */
    private async Task OnImagemSelecionada(InputFileChangeEventArgs e)
    {
        UploadErro = "";
        var arquivo = e.File;
        if (arquivo == null) return;

        if (arquivo.Size > TamanhoMaxImagemBytes)
        {
            UploadErro = "A imagem deve ter no máximo 5MB.";
            return;
        }

        UploadEmProgresso = true;
        StateHasChanged();

        try
        {
            using var stream = arquivo.OpenReadStream(TamanhoMaxImagemBytes);
            using var memoria = new MemoryStream();
            await stream.CopyToAsync(memoria);
            var base64 = Convert.ToBase64String(memoria.ToArray());
            var dataUrl = $"data:{arquivo.ContentType};base64,{base64}";

            ImagemPreviewUrl = dataUrl;
            if (CarroEdit != null) CarroEdit.ImagemUrl = dataUrl;
        }
        catch (Exception)
        {
            UploadErro = "Não foi possível carregar a imagem. Tente novamente.";
        }
        finally
        {
            UploadEmProgresso = false;
            StateHasChanged();
        }
    }

    private void RemoverImagem()
    {
        ImagemPreviewUrl = null;
        if (CarroEdit != null) CarroEdit.ImagemUrl = null;
    }

    private async Task EliminarCarro(int id)
    {
        var result = await Api.DeleteVeiculoAsync(id);
        if (result.Success)
        {
            Carros.RemoveAll(c => c.Id == id);
        }
    }

    private async Task EliminarUser(int id)
    {
        var result = await Api.DeleteUsuarioAsync(id);
        if (result.Success)
        {
            Utilizadores.RemoveAll(u => u.Id == id);
        }
    }

    private async Task MudarEstadoReserva(int id, string novoEstado)
    {
        var result = await Api.UpdateReservaEstadoAsync(id, novoEstado);
        if (result.Success)
        {
            var r = Reservas.FirstOrDefault(x => x.Id == id);
            if (r != null) r.Estado = novoEstado;
        }
    }

    private string[] EstadosSeguintes(string estado) => estado switch
    {
        "Pendente"   => new[] { "Confirmada", "Cancelada" },
        "Confirmada" => new[] { "Concluída",  "Cancelada" },
        _            => Array.Empty<string>()
    };

    /* ══ KPIs calculados ══ */
    private void AtualizarKpis()
    {
        Kpis = new()
        {
            new("Total Veículos",
                Carros.Count.ToString(),
                "+0", true, "kpi-cyan", Svg.Car),

            new("Utilizadores",
                Utilizadores.Count.ToString("N0"),
                "+0", true, "kpi-purple", Svg.Users),

            new("Reservas Activas",
                Reservas.Count(r => r.Estado == "Pendente" || r.Estado == "Confirmada").ToString(),
                "+0", true, "kpi-green", Svg.Reservas),

            new("Receita (AOA)",
                FormatReceita(Reservas.Where(r => r.Estado == "Concluída").Sum(r => r.Preco)),
                "+0", true, "kpi-gold", Svg.Money),
        };
    }

    private static string FormatReceita(long total) =>
        total >= 1_000_000_000 ? $"{total / 1_000_000_000.0:F1}B"
        : total >= 1_000_000   ? $"{total / 1_000_000.0:F1}M"
        : total.ToString("N0");

    /* ══ CSS helpers ══ */
    private string EstadoClass(string e) => e switch
    {
        "Pendente"   => "adm-pill-warn",
        "Confirmada" => "adm-pill-info",
        "Concluída"  => "adm-pill-success",
        "Cancelada"  => "adm-pill-danger",
        _            => ""
    };
    private string EstadoCarroClass(string e) => e switch
    {
        "Disponível" => "adm-pill-success",
        "Reservado"  => "adm-pill-warn",
        "Vendido"    => "adm-pill-info",
        _            => ""
    };
    private string EstadoBtnClass(string e) => e switch
    {
        "Confirmada" => "btn-est-confirm",
        "Concluída"  => "btn-est-done",
        "Cancelada"  => "btn-est-cancel",
        _            => ""
    };

    // ── ALTERAÇÃO PRINCIPAL: InitAsync antes de LoadAdminDataAsync ────────────
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AuthService.InitAsync();  // popula TokenStore via JS (contexto seguro)

        var role = await AuthService.GetRoleAsync();
        if (role?.ToLower() != "admin")
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        await LoadAdminDataAsync();
        StateHasChanged();
    }

    private async Task LoadAdminDataAsync()
    {
        isLoading = true;
        apiError  = null;

        var carrosResult = await Api.GetVeiculosAsync();
        if (carrosResult.Success)
        {
            Carros = carrosResult.Data.Select(v => new Carro
            {
                Id            = v.Id,
                Marca         = v.Marca,
                Modelo        = v.Modelo,
                Ano           = v.Ano,
                Preco         = (long)Math.Round(v.Preco),
                Combustivel   = v.Combustivel   ?? string.Empty,
                Transmissao   = v.Transmissao   ?? string.Empty,
                Estado        = v.Disponivel    ? "Disponível" : "Vendido",
                Cor           = v.Cor,
                Estilo        = v.Estilo,
                Motor         = v.Motor,
                Potencia      = v.Potencia,
                Descricao     = v.Descricao,
                ImagemUrl     = v.ImagemUrl,
                Localizacao   = v.Localizacao,
                Quilometragem = v.Quilometragem
            }).ToList();
        }
        else
        {
            apiError = carrosResult.Error;
        }

        var usersResult = await Api.GetUsuariosAsync();
        if (usersResult.Success)
        {
            Utilizadores = usersResult.Data;
        }
        else if (string.IsNullOrEmpty(apiError))
        {
            apiError = usersResult.Error;
        }

        var reservasResult = await Api.GetReservasAsync();
        if (reservasResult.Success)
        {
            var usuariosPorId = Utilizadores.ToDictionary(u => u.Id, u => u);
            var carrosPorId   = Carros.ToDictionary(c => c.Id, c => c);

            Reservas = reservasResult.Data.Select(r => new ReservaUi(
                r.Id,
                r.VeiculoId,
                usuariosPorId.TryGetValue(r.UsuarioId,  out var user)   ? user.Nome              : $"Usuário #{r.UsuarioId}",
                carrosPorId  .TryGetValue(r.VeiculoId,  out var carro)  ? $"{carro.Marca} {carro.Modelo}" : $"Veículo #{r.VeiculoId}",
                r.DataReserva.ToString("dd MMM yyyy"),
                carrosPorId  .TryGetValue(r.VeiculoId,  out var carro2) ? carro2.Preco           : 0L,
                string.IsNullOrWhiteSpace(r.Estado) ? "Pendente" : r.Estado
            )).ToList();

            // Marcar carros com reserva activa como "Reservado"
            var veiculosReservados = Reservas
                .Where(r => r.Estado == "Pendente" || r.Estado == "Confirmada")
                .Select(r => r.VeiculoId)
                .ToHashSet();

            foreach (var carro in Carros.Where(c => c.Estado == "Vendido" && veiculosReservados.Contains(c.Id)))
                carro.Estado = "Reservado";
        }
        else if (string.IsNullOrEmpty(apiError))
        {
            apiError = reservasResult.Error;
        }

        AtualizarKpis();
        isLoading = false;
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
    }

    /* ══ Records ══ */
    private record NavItem(string Id, string Label, string Icon, int Badge);
    private record Kpi(string Label, string Value, string Delta, bool DeltaUp, string Color, string Icon);
    private record LogEntry(string Msg, string Time, string Type);
    private record ReservaUi(int Id, int VeiculoId, string Cliente, string Veiculo, string Data, long Preco, string Estado)
    {
        public string Estado { get; set; } = Estado;
    }

    private class Carro
    {
        public int     Id            { get; set; }
