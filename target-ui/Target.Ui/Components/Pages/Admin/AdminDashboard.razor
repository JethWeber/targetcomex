<style>
/* ════════════════════════════════════════════════════
   FONTES — Sora (texto) · Rajdhani (destaques) · mono (códigos)
════════════════════════════════════════════════════ */
@@import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Sora:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap');

/* ════════════════════════════════════════════════════
   TOKENS — Cyberpunk Target
════════════════════════════════════════════════════ */
:root {
    --c:        #00f2ff;
    --c-dim:    rgba(0,242,255,.1);
    --c-brd:    rgba(0,242,255,.25);
    --purple:   #9b5de5;
    --pur-dim:  rgba(155,93,229,.12);
    --gold:     #ffc94d;
    --gold-dim: rgba(255,201,77,.1);
    --green:    #39ff14;
    --grn-dim:  rgba(57,255,20,.1);
    --red:      #ff3c5c;
    --red-dim:  rgba(255,60,92,.1);
    --warn:     #ffb800;
    --warn-dim: rgba(255,184,0,.1);
    --bg:       #060609;
    --bg2:      #0c0c14;
    --bg3:      #12121e;
    --brd:      rgba(255,255,255,.06);
    --txt:      #eef0fa;
    --dim:      #9b9bc4;
    --r:        10px;
    --side-w:   240px;
    --top-h:    56px;
    --ease:     cubic-bezier(.4,0,.2,1);
    --font:       'Sora', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-disp:  'Rajdhani', 'Sora', sans-serif;
    --font-mono:  'JetBrains Mono', 'Consolas', monospace;
}

/* ════════ RESET ════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
button { border: none; cursor: pointer; font-family: var(--font); }
input, select, textarea { font-family: var(--font); }
a { text-decoration: none; color: inherit; }
.sr-only { position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0); }

/* ════════ SHELL ════════ */
.adm-shell {
    display: grid;
    grid-template-columns: var(--side-w) 1fr;
    min-height: 100vh;
    background: var(--bg);
    color: var(--txt);
    font-family: var(--font);
}

/* ════════ SIDEBAR ════════ */
.adm-side {
    position: sticky;
    top: 0;
    height: 100vh;
    background: var(--bg2);
    border-right: 1px solid var(--brd);
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    z-index: 100;
}
.adm-side::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, transparent, var(--c), transparent);
}
.adm-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 20px 16px;
    border-bottom: 1px solid var(--brd);
}
.adm-logo-t {
    width: 38px; height: 38px;
    background: var(--c);
    color: #000;
    font-size: 1.4rem;
    font-weight: 900;
    display: grid; place-items: center;
    border-radius: 8px;
    flex-shrink: 0;
    box-shadow: 0 0 16px rgba(0,242,255,.4);
}
.adm-logo-name { font-size: .75rem; font-weight: 700; letter-spacing: .14em; color: var(--txt); }
.adm-logo-sub  { font-size: .6rem; color: var(--c); letter-spacing: .1em; }

.adm-nav { flex: 1; padding: 16px 10px; overflow-y: auto; }
.adm-nav-group {
    font-size: .55rem;
    letter-spacing: .14em;
    color: var(--dim);
    padding: 0 10px;
    margin-bottom: 8px;
}
.adm-nav-item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: var(--r);
    background: transparent;
    color: var(--dim);
    font-size: .78rem;
    letter-spacing: .04em;
    text-align: left;
    transition: all .18s var(--ease);
    margin-bottom: 2px;
    position: relative;
}
.adm-nav-item:hover { background: var(--c-dim); color: var(--txt); }
.adm-nav-item.on {
    background: var(--c-dim);
    color: var(--c);
    border: 1px solid var(--c-brd);
}
.adm-nav-item.on::before {
    content: '';
    position: absolute;
    left: 0; top: 20%; bottom: 20%;
    width: 3px;
    background: var(--c);
    border-radius: 0 3px 3px 0;
    box-shadow: 0 0 8px var(--c);
}
.adm-nav-danger { color: var(--red) !important; }
.adm-nav-danger:hover { background: var(--red-dim) !important; }
.adm-nav-ico { width: 18px; height: 18px; flex-shrink: 0; display: grid; place-items: center; }
.adm-nav-lbl { flex: 1; }
.adm-badge {
    background: var(--warn);
    color: #000;
    font-size: .6rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 100px;
}
.adm-side-foot {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-top: 1px solid var(--brd);
    background: var(--bg);
}
.adm-admin-av {
    width: 34px; height: 34px;
    border-radius: 50%;
    background: var(--pur-dim);
    border: 1px solid var(--purple);
    display: grid; place-items: center;
    font-size: .75rem;
    font-weight: 700;
    color: var(--purple);
    flex-shrink: 0;
}
.adm-admin-name { font-size: .78rem; color: var(--txt); }
.adm-admin-role { font-size: .62rem; color: var(--c); }
.adm-status-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px var(--green);
    margin-left: auto;
    animation: pulse 2s ease-in-out infinite;
}
@@keyframes pulse { 0%,100%{opacity:1}50%{opacity:.3} }

/* ════════ MAIN ════════ */
.adm-main {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    overflow-x: hidden;
}

/* ════════ TOPBAR ════════ */
.adm-topbar {
    height: var(--top-h);
    background: var(--bg2);
    border-bottom: 1px solid var(--brd);
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 24px;
    position: sticky;
    top: 0;
    z-index: 50;
}
.adm-menu-btn { background: transparent; color: var(--dim); display: none; padding: 4px; }
.adm-breadcrumb { display: flex; align-items: center; gap: 8px; }
.adm-bc-root { font-size: .68rem; color: var(--dim); letter-spacing: .08em; }
.adm-bc-sep  { color: var(--dim); font-size: .8rem; }
.adm-bc-cur  { font-size: .68rem; color: var(--c); letter-spacing: .08em; }
.adm-topbar-right { margin-left: auto; display: flex; align-items: center; gap: 16px; }
.adm-topbar-time { font-size: .72rem; color: var(--dim); font-variant-numeric: tabular-nums; }
.adm-notif { position: relative; color: var(--dim); cursor: pointer; transition: color .2s; }
.adm-notif:hover { color: var(--c); }
.adm-notif-dot {
    position: absolute; top: -2px; right: -2px;
    width: 7px; height: 7px;
    background: var(--warn);
    border-radius: 50%;
    border: 1px solid var(--bg2);
}

/* ════════ CONTENT ════════ */
.adm-content {
    flex: 1;
    padding: 28px 28px 40px;
    max-width: 1200px;
    width: 100%;
}
.adm-page-hdr {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 28px;
    gap: 16px;
    flex-wrap: wrap;
}
.adm-page-title { font-size: 1.3rem; font-weight: 700; letter-spacing: .12em; color: var(--txt); }
.adm-page-sub   { font-size: .78rem; color: var(--dim); margin-top: 4px; }

/* ════════ KPIs ════════ */
.adm-kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 28px;
}
.adm-kpi {
    background: var(--bg2);
    border: 1px solid var(--brd);
    border-radius: var(--r);
    padding: 20px;
    position: relative;
    overflow: hidden;
    transition: border-color .2s, transform .2s;
}
.adm-kpi:hover { transform: translateY(-3px); }
.adm-kpi::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; }
.kpi-cyan   { border-color: rgba(0,242,255,.2); }
.kpi-cyan::before   { background: var(--c);      box-shadow: 0 0 8px var(--c); }
.kpi-purple { border-color: rgba(155,93,229,.2); }
.kpi-purple::before { background: var(--purple); box-shadow: 0 0 8px var(--purple); }
.kpi-green  { border-color: rgba(57,255,20,.2); }
.kpi-green::before  { background: var(--green);  box-shadow: 0 0 8px var(--green); }
.kpi-gold   { border-color: rgba(255,201,77,.2); }
.kpi-gold::before   { background: var(--gold);   box-shadow: 0 0 8px var(--gold); }
.adm-kpi-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }
.adm-kpi-lbl { font-size: .65rem; color: var(--dim); letter-spacing: .08em; text-transform: uppercase; }
.adm-kpi-ico { color: var(--dim); opacity: .6; }
.adm-kpi-val { font-size: 1.9rem; font-weight: 700; color: var(--txt); margin-bottom: 6px; }
.adm-kpi-delta      { font-size: .7rem; }
.adm-kpi-delta.up   { color: var(--green); }
.adm-kpi-delta.down { color: var(--red); }

/* ════════ GRID 2 ════════ */
.adm-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

/* ════════ PANEL ════════ */
.adm-panel {
    background: var(--bg2);
    border: 1px solid var(--brd);
    border-radius: var(--r);
    overflow: hidden;
}
.adm-panel-hdr {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px;
    border-bottom: 1px solid var(--brd);
}
.adm-panel-title { font-size: .68rem; letter-spacing: .1em; color: var(--dim); }

/* ════════ TABLE ════════ */
.adm-table { width: 100%; border-collapse: collapse; font-size: .82rem; }
.adm-table th {
    text-align: left;
    font-size: .62rem;
    letter-spacing: .08em;
    color: var(--dim);
    padding: 10px 18px;
    border-bottom: 1px solid var(--brd);
    background: var(--bg);
}
.adm-table td {
    padding: 12px 18px;
    border-bottom: 1px solid rgba(255,255,255,.03);
    color: var(--txt);
    vertical-align: middle;
}
.adm-table tr:hover td { background: rgba(0,242,255,.02); }

/* ════════ LOG ════════ */
.adm-log { padding: 10px 18px; display: flex; flex-direction: column; gap: 14px; }
.adm-log-item { display: flex; align-items: flex-start; gap: 12px; }
.adm-log-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; margin-top: 4px; }
.adm-log-dot.info    { background: var(--c); }
.adm-log-dot.success { background: var(--green); }
.adm-log-dot.warn    { background: var(--warn); }
.adm-log-dot.danger  { background: var(--red); }
.adm-log-msg  { font-size: .8rem; color: var(--txt); line-height: 1.4; }
.adm-log-time { font-size: .68rem; color: var(--dim); margin-top: 2px; }

/* ════════ PILLS ════════ */
.adm-pill {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 100px;
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .04em;
}
.adm-pill-success { background: var(--grn-dim);  color: var(--green);  border: 1px solid rgba(57,255,20,.2); }
.adm-pill-warn    { background: var(--warn-dim); color: var(--warn);   border: 1px solid rgba(255,184,0,.2); }
.adm-pill-info    { background: var(--c-dim);    color: var(--c);      border: 1px solid var(--c-brd); }
.adm-pill-danger  { background: var(--red-dim);  color: var(--red);    border: 1px solid rgba(255,60,92,.2); }
.adm-pill-admin   { background: var(--pur-dim);  color: var(--purple); border: 1px solid rgba(155,93,229,.2); }

/* ════════ FILTROS ════════ */
.adm-filters { display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
.adm-search {
    flex: 1;
    min-width: 200px;
    height: 40px;
    background: var(--bg2);
    border: 1px solid var(--brd);
    border-radius: var(--r);
    color: var(--txt);
    padding: 0 14px;
    font-size: .82rem;
    outline: none;
    transition: border-color .2s;
}
.adm-search:focus { border-color: var(--c-brd); box-shadow: 0 0 0 3px rgba(0,242,255,.06); }
.adm-search::placeholder { color: var(--dim); }
.adm-select {
    height: 40px;
    background: var(--bg2);
    border: 1px solid var(--brd);
    border-radius: var(--r);
    color: var(--txt);
    padding: 0 14px;
    font-size: .82rem;
    outline: none;
    cursor: pointer;
    transition: border-color .2s;
}
.adm-select:focus { border-color: var(--c-brd); }

/* ════════ ACTIONS ════════ */
.adm-actions { display: flex; gap: 6px; }
.adm-act-btn {
    width: 30px; height: 30px;
    background: var(--bg3);
    border: 1px solid var(--brd);
    border-radius: 7px;
    color: var(--dim);
    display: grid; place-items: center;
    transition: all .18s;
}
.adm-act-btn:hover     { border-color: var(--c-brd); color: var(--c); }
.adm-act-danger:hover  { border-color: rgba(255,60,92,.3); color: var(--red); }

/* ════════ BUTTONS ════════ */
.adm-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: var(--c);
    color: #000;
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .06em;
    padding: 10px 20px;
    border-radius: var(--r);
    border: none;
    transition: all .2s;
}
.adm-btn-primary:hover { background: #1af6ff; box-shadow: 0 0 16px rgba(0,242,255,.3); }
.adm-btn-ghost {
    background: transparent;
    border: 1px solid var(--brd);
    color: var(--dim);
    font-size: .74rem;
    padding: 7px 14px;
    border-radius: var(--r);
    transition: all .18s;
}
.adm-btn-ghost:hover { border-color: var(--c-brd); color: var(--c); }

/* ════════ CAR CARDS (admin) ════════ */
.adm-car-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 20px;
}
.adm-car-card {
    background: var(--bg2);
    border: 1px solid var(--brd);
    border-radius: var(--r);
    overflow: hidden;
    transition: border-color .3s, box-shadow .3s, transform .3s;
}
.adm-car-card:hover {
    border-color: var(--c-brd);
    box-shadow: 0 0 28px rgba(0,242,255,.12);
    transform: translateY(-3px);
}
.adm-car-img-wrap {
    position: relative;
    height: 180px;
    background: var(--bg);
    overflow: hidden;
}
.adm-car-img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform .5s ease;
}
.adm-car-card:hover .adm-car-img { transform: scale(1.05); }
.adm-car-badge {
    position: absolute;
    top: 10px; left: 10px;
    background: rgba(0,0,0,.65);
    color: var(--c);
    font-size: .65rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 100px;
    border: 1px solid var(--c-brd);
    text-transform: uppercase;
    letter-spacing: .06em;
}
.adm-car-estado-pill {
    position: absolute;
    top: 10px; right: 10px;
}
.adm-car-id {
    position: absolute;
    bottom: 8px; left: 10px;
    font-size: .65rem;
    color: var(--dim);
    background: rgba(0,0,0,.55);
    padding: 2px 7px;
    border-radius: 6px;
}
.adm-car-body { padding: 16px; }
.adm-car-meta { display: flex; gap: 8px; margin-bottom: 6px; }
.adm-car-ano, .adm-car-transm {
    font-size: .68rem;
    color: var(--dim);
    background: rgba(255,255,255,.05);
    padding: 2px 8px;
    border-radius: 6px;
    text-transform: uppercase;
    letter-spacing: .05em;
}
.adm-car-name {
    font-size: .95rem;
    font-weight: 700;
    color: var(--txt);
    margin-bottom: 8px;
    line-height: 1.3;
}
.adm-car-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-bottom: 14px;
    min-height: 20px;
}
.adm-car-specs span { font-size: .75rem; color: var(--dim); }
.adm-car-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.adm-car-price { font-size: 1rem; font-weight: 800; }

/* ════════ USER CARDS ════════ */
.adm-user-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
}
.adm-user-card {
    background: var(--bg2);
    border: 1px solid var(--brd);
    border-radius: var(--r);
    padding: 18px;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    transition: border-color .2s, transform .2s;
}
.adm-user-card:hover { border-color: rgba(0,242,255,.18); transform: translateY(-2px); }
.adm-user-av {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--c-dim);
    border: 1px solid var(--c-brd);
    display: grid; place-items: center;
    font-size: .78rem;
    font-weight: 700;
    color: var(--c);
    flex-shrink: 0;
}
.adm-user-info { flex: 1; }
.adm-user-name { font-size: .88rem; font-weight: 600; color: var(--txt); margin-bottom: 3px; }
.adm-user-tel  { font-size: .75rem; color: var(--dim); margin-bottom: 8px; }
.adm-user-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.adm-user-meta > span:first-child { font-size: .7rem; color: var(--dim); }
.adm-user-actions { display: flex; flex-direction: column; gap: 6px; }

/* ════════ RESERVAS ════════ */
.adm-reservas { display: flex; flex-direction: column; gap: 12px; }
.adm-res-card {
    background: var(--bg2);
    border: 1px solid var(--brd);
    border-radius: var(--r);
    padding: 18px 20px;
    display: flex;
    align-items: center;
    gap: 20px;
    transition: border-color .2s;
    flex-wrap: wrap;
}
.adm-res-card:hover { border-color: rgba(0,242,255,.15); }
.adm-res-id      { font-size: .8rem; color: var(--dim); min-width: 54px; }
.adm-res-info    { flex: 1; min-width: 180px; }
.adm-res-cliente { font-size: .9rem; font-weight: 600; color: var(--txt); }
.adm-res-veiculo { font-size: .78rem; color: var(--dim); margin-top: 2px; }
.adm-res-data    { font-size: .72rem; color: var(--dim); margin-top: 3px; }
.adm-res-preco   { font-size: .85rem; min-width: 160px; }
.adm-res-estado  { min-width: 90px; }
.adm-res-actions { display: flex; gap: 8px; flex-wrap: wrap; }
.adm-btn-estado {
    font-size: .7rem;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 7px;
    border: 1px solid;
    cursor: pointer;
    transition: all .18s;
    letter-spacing: .03em;
}
.btn-est-confirm { background: var(--c-dim);    border-color: var(--c-brd);             color: var(--c); }
.btn-est-confirm:hover { background: var(--c); color: #000; }
.btn-est-done    { background: var(--grn-dim);  border-color: rgba(57,255,20,.2);        color: var(--green); }
.btn-est-done:hover    { background: var(--green); color: #000; }
.btn-est-cancel  { background: var(--red-dim);  border-color: rgba(255,60,92,.2);        color: var(--red); }
.btn-est-cancel:hover  { background: var(--red); color: #fff; }

/* ════════ MODAL ════════ */
.adm-modal-bg {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.7);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 200;
    padding: 20px;
}
.adm-modal {
    background: var(--bg2);
    border: 1px solid var(--c-brd);
    border-radius: 16px;
    width: 100%;
    max-width: 600px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 0 40px rgba(0,242,255,.15);
}
.adm-modal-hdr {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 24px;
    border-bottom: 1px solid var(--brd);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 1;
}
.adm-modal-title { font-size: .9rem; font-weight: 700; letter-spacing: .1em; color: var(--c); }
.adm-modal-close {
    background: transparent;
    color: var(--dim);
    font-size: 1rem;
    width: 28px; height: 28px;
    display: grid; place-items: center;
    border-radius: 6px;
    transition: all .15s;
}
.adm-modal-close:hover { background: var(--red-dim); color: var(--red); }
.adm-modal-body { padding: 24px; }
.adm-modal-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 16px 24px;
    border-top: 1px solid var(--brd);
    background: var(--bg);
    position: sticky;
    bottom: 0;
}
.adm-modal-foot-right { display: flex; gap: 10px; }
.adm-btn-back-step {
    background: transparent;
    border: 1px solid var(--brd);
    color: var(--dim);
    font-size: .78rem;
    padding: 10px 16px;
    border-radius: var(--r);
    transition: all .18s;
}
.adm-btn-back-step:hover { border-color: var(--c-brd); color: var(--c); }

.adm-field { margin-bottom: 16px; }
.adm-field label { display: block; font-size: .72rem; color: var(--dim); letter-spacing: .06em; margin-bottom: 7px; }
.adm-inp {
    width: 100%;
    height: 44px;
    background: var(--bg);
    border: 1px solid var(--brd);
    border-radius: var(--r);
    color: var(--txt);
    padding: 0 14px;
    font-size: .85rem;
    outline: none;
    transition: border-color .2s;
}
.adm-inp:focus { border-color: var(--c-brd); box-shadow: 0 0 0 3px rgba(0,242,255,.06); }
select.adm-inp { appearance: none; cursor: pointer; }
.adm-textarea {
    height: 80px !important;
    padding-top: 10px !important;
    resize: vertical;
}
.adm-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.adm-erro {
    background: var(--red-dim);
    border: 1px solid rgba(255,60,92,.25);
    border-radius: var(--r);
    padding: 10px 14px;
    color: var(--red);
    font-size: .8rem;
    margin-top: 4px;
}

/* ════════ MISC ════════ */
.adm-mono       { font-family: var(--font-mono); }
.adm-cyan       { color: var(--c); }
.adm-dim        { color: var(--dim); }
.adm-cell-title { font-weight: 600; color: var(--txt); }
.adm-empty      { text-align: center; color: var(--dim); padding: 40px; font-size: .85rem; }
.req            { color: var(--c); }

/* ════════════════════════════════════════════════════
   TIPOGRAFIA — destaques em Rajdhani, leitura em Sora
════════════════════════════════════════════════════ */
.adm-logo-name, .adm-logo-sub, .adm-nav-group, .adm-nav-lbl, .adm-admin-role,
.adm-bc-root, .adm-bc-cur, .adm-page-title, .adm-panel-title, .adm-kpi-lbl,
.adm-car-badge, .adm-modal-title, .adm-btn-primary, .adm-btn-ghost,
.adm-btn-back-step, .adm-pill, .adm-badge, .adm-car-ano, .adm-car-transm,
.adm-btn-estado, .adm-wiz-title, .adm-wiz-dot, .adm-wiz-progtext,
.adm-upload-title {
    font-family: var(--font-disp);
}
.adm-page-title  { letter-spacing: .07em; }
.adm-nav-group   { letter-spacing: .1em; }
.adm-bc-root,
.adm-bc-cur      { letter-spacing: .05em; }
.adm-modal-title { letter-spacing: .07em; }
.adm-logo-sub    { letter-spacing: .08em; }
.adm-nav-item    { font-weight: 500; }

/* ════════════════════════════════════════════════════
   WIZARD — passos do formulário de veículo
════════════════════════════════════════════════════ */
.adm-wiz-progtext { text-align: right; font-size: .72rem; color: var(--dim); margin-bottom: 8px; }
.adm-wiz-progbar {
    height: 3px;
    background: rgba(255,255,255,.07);
    border-radius: 3px;
    margin-bottom: 22px;
    overflow: hidden;
}
.adm-wiz-progfill {
    height: 100%;
    background: linear-gradient(90deg, #00d9ff, var(--c));
    border-radius: 3px;
