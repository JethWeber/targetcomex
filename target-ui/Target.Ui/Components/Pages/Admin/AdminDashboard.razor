    /* ══ Ciclo de vida ══ */
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AuthService.InitAsync();

        var role = await AuthService.GetRoleAsync();
        if (role?.ToLower() != "admin")
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        await LoadAdminDataAsync();
        StateHasChanged();
    }

    private async Task LoadAdminDataAsync()
    {
        isLoading = true;
        apiError  = null;

        var carrosResult = await Api.GetVeiculosAsync();
        if (carrosResult.Success)
        {
            Carros = carrosResult.Data.Select(v => new Carro
            {
                Id            = v.Id,
                Marca         = v.Marca,
                Modelo        = v.Modelo,
                Ano           = v.Ano,
                Preco         = (long)Math.Round(v.Preco),
                Combustivel   = v.Combustivel  ?? string.Empty,
                Transmissao   = v.Transmissao  ?? string.Empty,
                Estado        = v.Disponivel   ? "Disponível" : "Vendido",
                Cor           = v.Cor,
                Estilo        = v.Estilo,
                Motor         = v.Motor,
                Potencia      = v.Potencia,
                Descricao     = v.Descricao,
                ImagemUrl     = v.ImagemUrl,
                Localizacao   = v.Localizacao,
                Quilometragem = v.Quilometragem,
                GaleriaUrls   = new() // Galeria não vem no VeiculoDto; lista começa vazia
            }).ToList();
        }
        else
        {
            apiError = carrosResult.Error;
        }

        var usersResult = await Api.GetUsuariosAsync();
        if (usersResult.Success)
            Utilizadores = usersResult.Data;
        else if (string.IsNullOrEmpty(apiError))
            apiError = usersResult.Error;

        var reservasResult = await Api.GetReservasAsync();
        if (reservasResult.Success)
        {
            var usuariosPorId = Utilizadores.ToDictionary(u => u.Id, u => u);
            var carrosPorId   = Carros.ToDictionary(c => c.Id, c => c);

            Reservas = reservasResult.Data.Select(r => new ReservaUi(
                r.Id,
                r.VeiculoId,
                usuariosPorId.TryGetValue(r.UsuarioId, out var usr) ? usr.Nome : $"Usuário #{r.UsuarioId}",
                carrosPorId.TryGetValue(r.VeiculoId, out var car)   ? $"{car.Marca} {car.Modelo}" : $"Veículo #{r.VeiculoId}",
                r.DataReserva.ToString("dd MMM yyyy"),
                carrosPorId.TryGetValue(r.VeiculoId, out var car2)  ? car2.Preco : 0L,
                string.IsNullOrWhiteSpace(r.Estado) ? "Pendente" : r.Estado
            )).ToList();

            var veiculosReservados = Reservas
                .Where(r => r.Estado == "Pendente" || r.Estado == "Confirmada")
                .Select(r => r.VeiculoId)
                .ToHashSet();

            foreach (var c in Carros.Where(c => c.Estado == "Vendido" && veiculosReservados.Contains(c.Id)))
                c.Estado = "Reservado";
        }
        else if (string.IsNullOrEmpty(apiError))
        {
            apiError = reservasResult.Error;
        }

        AtualizarKpis();
        isLoading = false;
    }

