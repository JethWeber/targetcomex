    private void FecharModalUser()
    {
        ModalUserAberto = false;
        UserEdit      = null;
        ModalUserErro = "";
        SalvandoUser  = false;
    }

    private async Task SalvarUser()
    {
        if (UserEdit == null) return;

        if (string.IsNullOrWhiteSpace(UserEdit.Nome))
        { ModalUserErro = "O nome é obrigatório."; return; }

        if (UserEdit.Id == 0)
        {
            if (string.IsNullOrWhiteSpace(UserEdit.Email))
            { ModalUserErro = "O e-mail é obrigatório."; return; }
            if (string.IsNullOrWhiteSpace(UserEdit.Senha) || UserEdit.Senha.Length < 6)
            { ModalUserErro = "A senha deve ter pelo menos 6 caracteres."; return; }
        }

        SalvandoUser  = true;
        ModalUserErro = "";

        if (UserEdit.Id == 0)
        {
            var request = new RegisterRequest
            {
                Nome                 = UserEdit.Nome,
                Email                = UserEdit.Email,
                Senha                = UserEdit.Senha,
                Telefone             = UserEdit.Telefone,
                DataNascimento       = UserEdit.DataNascimento,
                Genero               = UserEdit.Genero,
                EstadoCivil          = UserEdit.EstadoCivil,
                NumeroFilhos         = UserEdit.NumeroFilhos,
                Profissao            = UserEdit.Profissao,
                FaixaRendaMensal     = UserEdit.FaixaRendaMensal,
                InteressesPrincipais = string.IsNullOrWhiteSpace(UserEdit.InteressesPrincipais)
                    ? null
                    : UserEdit.InteressesPrincipais
                        .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                        .ToList(),
                Provincia = UserEdit.Provincia,
                Municipio = UserEdit.Municipio,
                Bairro    = UserEdit.Bairro
            };

            var result = await Api.RegisterAsync(request);
            if (result.Success)
            {
                await ReloadUsuariosAsync();
                FecharModalUser();
                ShowToast("Utilizador criado com sucesso.", "success");
            }
            else
            {
                ModalUserErro = MensagemAmigavel(result.Error) ?? "Erro ao criar utilizador.";
                SalvandoUser = false;
            }
        }
        else
        {
            var request = new UpdateUsuarioRequest
            {
                Nome                 = UserEdit.Nome,
                Telefone             = UserEdit.Telefone,
                DataNascimento       = UserEdit.DataNascimento,
                Genero               = UserEdit.Genero,
                EstadoCivil          = UserEdit.EstadoCivil,
                NumeroFilhos         = UserEdit.NumeroFilhos,
                Profissao            = UserEdit.Profissao,
                FaixaRendaMensal     = UserEdit.FaixaRendaMensal,
                InteressesPrincipais = UserEdit.InteressesPrincipais,
                TipoDeUsoPretendido  = UserEdit.TipoDeUsoPretendido
            };

            var result = await Api.UpdateUsuarioAsync(UserEdit.Id, request);
            if (result.Success)
            {
                await ReloadUsuariosAsync();
                FecharModalUser();
                ShowToast("Utilizador actualizado com sucesso.", "success");
            }
            else
            {
                ModalUserErro = MensagemAmigavel(result.Error) ?? "Erro ao actualizar utilizador.";
                SalvandoUser = false;
            }
        }
    }

    private async Task ReloadUsuariosAsync()
