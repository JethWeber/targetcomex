    /* ══ Confirmação genérica ══ */
    private void AbrirConfirmacao(string titulo, string msg, Func<Task> accao)
    {
        ConfirmacaoTitulo = titulo;
        ConfirmacaoMsg    = msg;
        ConfirmacaoAccao  = accao;
        ConfirmacaoVisivel = true;
    }

    private void CancelarConfirmacao()
    {
        ConfirmacaoVisivel = false;
        ConfirmacaoAccao   = null;
    }

    private async Task ConfirmarAccao()
    {
        var accao = ConfirmacaoAccao;
        ConfirmacaoVisivel = false;
        ConfirmacaoAccao   = null;
        if (accao != null) await accao();
    }

    /* ══ Toast ══ */
    private void ShowToast(string msg, string type = "error")
    {
        ToastMsg  = msg;
        ToastType = type;
        ToastCts?.Cancel();
        ToastCts = new CancellationTokenSource();
        var token = ToastCts.Token;
        _ = HideToastAfterDelay(token);
    }

    private async Task HideToastAfterDelay(CancellationToken token)
    {
        try
        {
            await Task.Delay(4500, token);
            if (!token.IsCancellationRequested)
            {
                ToastMsg = null;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }

    private string? MensagemAmigavel(string? erro)
    {
        if (string.IsNullOrWhiteSpace(erro)) return null;
        var trimmed = erro.Trim();
        if (trimmed.StartsWith("<")) return null;
        return trimmed.Length > 200 ? trimmed[..200] + "…" : trimmed;
    }

    /* ══ KPIs calculados ══ */
    private void AtualizarKpis()
    {
        Kpis = new()
        {
            new("Total Veículos",
                Carros.Count.ToString(),
                "+0", true, "kpi-cyan", Svg.Car),

            new("Utilizadores",
                Utilizadores.Count.ToString("N0"),
                "+0", true, "kpi-purple", Svg.Users),

            new("Reservas Activas",
                Reservas.Count(r => r.Estado == "Pendente" || r.Estado == "Confirmada").ToString(),
                "+0", true, "kpi-green", Svg.Reservas),

            new("Receita (AOA)",
                FormatReceita(Reservas.Where(r => r.Estado == "Concluída").Sum(r => r.Preco)),
                "+0", true, "kpi-gold", Svg.Money),
        };
    }

    private static string FormatReceita(long total) =>
        total >= 1_000_000_000 ? $"{total / 1_000_000_000.0:F1}B"
        : total >= 1_000_000   ? $"{total / 1_000_000.0:F1}M"
        : total.ToString("N0");

