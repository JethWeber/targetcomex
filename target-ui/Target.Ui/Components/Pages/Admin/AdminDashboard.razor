@code {
    private string ActiveTab = "overview";
    private bool SideOpen = false;

    /* ── Toast ───────────────────────────── */
    private string? ToastMsg;
    private string ToastType = "error";
    private CancellationTokenSource? ToastCts;

    /* ── Confirmação de eliminação ────────── */
    private bool ConfirmacaoVisivel = false;
    private string ConfirmacaoTitulo = "";
    private string ConfirmacaoMsg = "";
    private Func<Task>? ConfirmacaoAccao;

    /* ── Filtros ─────────────────────────── */
    private string FiltroCarros = "";
    private string FiltroEstadoCarro = "";
    private string FiltroUsers = "";
    private string FiltroPerfilUser = "";
    private string FiltroEstadoReserva = "";

    /* ── Modal Carro ─────────────────────── */
    private bool ModalCarroAberto = false;
    private Carro? CarroEdit;
    private string ModalErro = "";
    private string EstadoSelecionado = "Disponível";

    /* ── Upload de ficheiros (Capa + Galeria) ── */
    private FileUploadData? capaUpload;
    private List<FileUploadData> galeriaUploads = new();
    private string? CapaPreviewUrl;
    private List<string> GaleriaPreviewUrls = new();
    private const long TamanhoMaxImagemBytes = 5 * 1024 * 1024; // 5 MB
    private string UploadErro = "";
    private bool UploadEmProgresso = false;

    /* ── Wizard de passos do carro ────────── */
    private int CarroStep = 1;
    private const int CarroTotalSteps = 5;

    /* ── Modal Utilizador ─────────────────── */
    private bool ModalUserAberto = false;
    private UserEditModel? UserEdit;
    private string ModalUserErro = "";
    private bool SalvandoUser = false;

    /* ── Estado de carregamento ─────────────── */
    private bool isLoading = true;
    private string? apiError;

    /* ══ NAV ══ */
    private List<NavItem> NavItems = new()
    {
        new("overview",  "OVERVIEW",     Svg.Dashboard, 0),
        new("carros",    "CARROS",        Svg.Car,       0),
        new("users",     "UTILIZADORES",  Svg.Users,     0),
        new("reservas",  "RESERVAS",      Svg.Reservas,  3),
    };

    /* ══ KPIs ══ */
    private List<Kpi> Kpis = new()
    {
        new("Total Veículos",   "—", "+0", true, "kpi-cyan",   Svg.Car),
        new("Utilizadores",     "—", "+0", true, "kpi-purple", Svg.Users),
        new("Reservas Activas", "—", "+0", true, "kpi-green",  Svg.Reservas),
        new("Receita (AOA)",    "—", "+0", true, "kpi-gold",   Svg.Money),
    };

    /* ══ LOGS ══ */
    private List<LogEntry> Logs = new()
    {
        new("Nova reserva #RES-041 criada",               "há 2 min",  "info"),
        new("Carro #C-022 marcado como Vendido",          "há 8 min",  "success"),
        new("Utilizador João Malheiro registado",         "há 14 min", "info"),
        new("Reserva #RES-038 cancelada pelo cliente",    "há 31 min", "warn"),
        new("Carro #C-009 actualizado",                   "há 1h",     "info"),
        new("Login de admin detectado (IP 197.x)",        "há 2h",     "warn"),
    };

    /* ══ CARROS ══ */
    private List<Carro> Carros = new();

    private IEnumerable<Carro> CarrosFiltrados => Carros
        .Where(c => string.IsNullOrEmpty(FiltroCarros)
                    || ($"{c.Marca} {c.Modelo}").Contains(FiltroCarros, StringComparison.OrdinalIgnoreCase))
        .Where(c => string.IsNullOrEmpty(FiltroEstadoCarro) || c.Estado == FiltroEstadoCarro);

    /* ══ UTILIZADORES ══ */
    private List<UsuarioDto> Utilizadores = new();

    private IEnumerable<UsuarioDto> UtilizadoresFiltrados => Utilizadores
        .Where(u => string.IsNullOrEmpty(FiltroUsers)
                    || u.Nome.Contains(FiltroUsers, StringComparison.OrdinalIgnoreCase)
                    || (u.Telefone?.Contains(FiltroUsers, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(u => string.IsNullOrEmpty(FiltroPerfilUser) || u.Perfil == FiltroPerfilUser);

    /* ══ RESERVAS ══ */
    private List<ReservaUi> Reservas = new();

    private IEnumerable<ReservaUi> ReservasFiltradas => Reservas
        .Where(r => string.IsNullOrEmpty(FiltroEstadoReserva) || r.Estado == FiltroEstadoReserva)
        .OrderByDescending(r => r.Id);

    /* ══ ACÇÕES — CARROS ══ */
    private void AbrirModalCarro(Carro? carro = null)
    {
        ModalErro = "";
        CarroStep = 1;
        LimparEstadoUploads();

        if (carro == null)
        {
            CarroEdit = new Carro
            {
                Ano   = DateTime.Now.Year,
                Estado = "Disponível"
            };
            EstadoSelecionado = "Disponível";
        }
        else
        {
            CarroEdit = new Carro
            {
                Id            = carro.Id,
                Marca         = carro.Marca,
                Modelo        = carro.Modelo,
                Ano           = carro.Ano,
                Descricao     = carro.Descricao,
                ImagemUrl     = carro.ImagemUrl,
                Cor           = carro.Cor,
                Estilo        = carro.Estilo,
                Combustivel   = carro.Combustivel,
                Motor         = carro.Motor,
                Potencia      = carro.Potencia,
                Transmissao   = carro.Transmissao,
                Localizacao   = carro.Localizacao,
                Quilometragem = carro.Quilometragem,
                Preco         = carro.Preco,
                Estado        = carro.Estado,
                GaleriaUrls   = new List<string>(carro.GaleriaUrls)
            };

            EstadoSelecionado = CarroEdit.Estado == "Disponível" ? "Disponível" : CarroEdit.Estado;

            // Pré-visualizações das imagens da galeria já existentes
            foreach (var url in carro.GaleriaUrls.Where(u => !string.IsNullOrEmpty(u)))
                GaleriaPreviewUrls.Add(url);
        }

        ModalCarroAberto = true;
    }

    private void FecharModalCarro()
    {
        ModalCarroAberto = false;
        CarroEdit = null;
        ModalErro = "";
        CarroStep = 1;
        LimparEstadoUploads();
    }

    private void AvancarCarroStep()
    {
        if (CarroEdit == null) return;
        ModalErro = "";
        if (!ValidarCarroStep()) return;
        if (CarroStep < CarroTotalSteps) CarroStep++;
    }

    private void VoltarCarroStep()
    {
        ModalErro = "";
        if (CarroStep > 1) CarroStep--;
    }

    private bool ValidarCarroStep()
    {
        if (CarroEdit == null) return false;

        if (CarroStep == 1)
        {
            if (string.IsNullOrWhiteSpace(CarroEdit.Marca) || string.IsNullOrWhiteSpace(CarroEdit.Modelo))
            { ModalErro = "Marca e Modelo são obrigatórios."; return false; }
            if (CarroEdit.Ano < 2000 || CarroEdit.Ano > 2030)
            { ModalErro = "Insira um ano válido (2000 – 2030)."; return false; }
        }
        else if (CarroStep == 4)
        {
            if (CarroEdit.Preco <= 0)
            { ModalErro = "Insira um preço válido maior que zero."; return false; }
        }

        return true;
    }

    private void EditarCarro(Carro c) => AbrirModalCarro(c);

    // Wrapper sem parâmetro para o botão "Novo Veículo" no markup
    private void AbrirModalCarroNovo() => AbrirModalCarro(null);

    /* ── Upload — Capa ───────────────────────────────────────────────── */
    private async Task OnCapaSelecionada(InputFileChangeEventArgs e)
    {
        UploadErro = "";
        var arquivo = e.File;
        if (arquivo == null) return;

        if (arquivo.Size > TamanhoMaxImagemBytes)
        { UploadErro = "A imagem de capa deve ter no máximo 5 MB."; return; }

        using var stream  = arquivo.OpenReadStream(TamanhoMaxImagemBytes);
        using var memoria = new MemoryStream();
        await stream.CopyToAsync(memoria);
        var bytes = memoria.ToArray();
        
        capaUpload = new FileUploadData
        {
            FileName = arquivo.Name,
            ContentType = arquivo.ContentType,
            Bytes = bytes
        };
        
        CapaPreviewUrl = $"data:{arquivo.ContentType};base64,{Convert.ToBase64String(bytes)}";
    }

    /* ── Upload — Galeria ────────────────────────────────────────────── */
    private async Task OnGaleriaSelecionada(InputFileChangeEventArgs e)
    {
        UploadErro = "";
        var arquivos = e.GetMultipleFiles(4);

        foreach (var arquivo in arquivos)
        {
            if (galeriaUploads.Count >= 4)
            { UploadErro = "Atingiu o limite máximo de 4 imagens na galeria."; break; }

            if (arquivo.Size > TamanhoMaxImagemBytes)
            { UploadErro = $"O ficheiro '{arquivo.Name}' excede o limite de 5 MB."; continue; }

            using var stream  = arquivo.OpenReadStream(TamanhoMaxImagemBytes);
            using var memoria = new MemoryStream();
            await stream.CopyToAsync(memoria);
                var bytes = memoria.ToArray();
                galeriaUploads.Add(new FileUploadData
                {
                    FileName = arquivo.Name,
                    ContentType = arquivo.ContentType,
                    Bytes = bytes
                });
                GaleriaPreviewUrls.Add($"data:{arquivo.ContentType};base64,{Convert.ToBase64String(bytes)}");
        }
    }

    private void LimparEstadoUploads()
    {
        capaUpload = null;
        galeriaUploads.Clear();
        CapaPreviewUrl = null;
        GaleriaPreviewUrls.Clear();
        UploadErro = "";
        UploadEmProgresso = false;
    }

    /* ── Guardar Carro ───────────────────────────────────────────────── */
    private async Task SalvarCarro()
    {
        if (CarroEdit == null) return;

        UploadEmProgresso = true;
        ModalErro = "";

        try
        {
            // 1. Gerar o sufixo aleatório solicitado
            string randomSufix = new Random().Next(10000, 99999).ToString();

            // 2. Limpar a marca e o modelo para um nome seguro de ficheiro
            string marcaLimpa = System.Text.RegularExpressions.Regex.Replace(CarroEdit.Marca ?? "", @"[^a-zA-Z0-9]", "").ToLower();
            string modeloLimpo = System.Text.RegularExpressions.Regex.Replace(CarroEdit.Modelo ?? "", @"[^a-zA-Z0-9]", "").ToLower();
            string baseNome = $"{marcaLimpa}_{modeloLimpo}_{CarroEdit.Ano}_{randomSufix}";

            // 3. Garantir a criação da pasta física local no wwwroot do Blazor
            string uploadFolder = Path.Combine(Env.WebRootPath, "Uploads", "Veiculos");
            if (!Directory.Exists(uploadFolder))
            {
                Directory.CreateDirectory(uploadFolder);
            }

            // 4. Processar e salvar o arquivo físico da imagem de CAPA (se houver novo)
            if (capaUpload != null)
            {
                string ext = Path.GetExtension(capaUpload.FileName);
                string nomeFinalCapa = $"{baseNome}-capa{ext}";
                string caminhoFisicoCapa = Path.Combine(uploadFolder, nomeFinalCapa);

                await System.IO.File.WriteAllBytesAsync(caminhoFisicoCapa, capaUpload.Bytes);

                // Atualiza a URL que vai no JSON para a API
                CarroEdit.ImagemUrl = $"/Uploads/Veiculos/{nomeFinalCapa}";
            }
            else if (string.IsNullOrEmpty(CarroEdit.ImagemUrl))
            {
                CarroEdit.ImagemUrl = "/img/cars/default.jpg";
            }

            // 5. Processar e salvar os arquivos físicos da GALERIA (se houverem)
            if (galeriaUploads != null && galeriaUploads.Count > 0)
            {
                if (CarroEdit.ImagensAdicionais == null) 
                    CarroEdit.ImagensAdicionais = new List<VeiculoImagemDto>();

                int index = CarroEdit.ImagensAdicionais.Count + 1;
                foreach (var uploadData in galeriaUploads)
                {
                    string ext = Path.GetExtension(uploadData.FileName);
                    string nomeFinalGaleria = $"{baseNome}-galeria{index}{ext}";
                    string caminhoFisicoGaleria = Path.Combine(uploadFolder, nomeFinalGaleria);

                    await System.IO.File.WriteAllBytesAsync(caminhoFisicoGaleria, uploadData.Bytes);

                    // Adiciona o DTO correto esperado pela sua classe local Carro
                    CarroEdit.ImagensAdicionais.Add(new VeiculoImagemDto
                    {
                        Id = 0,
                        VeiculoId = CarroEdit.Id,
                        ImagemUrl = $"/Uploads/Veiculos/{nomeFinalGaleria}"
                    });

                    index++;
                }
            }

            // 6. Preparar e enviar o mapeamento correto via JSON para o seu ApiClient
            if (CarroEdit.Id == 0)
            {
                // Criar novo veículo
                var req = new CreateVeiculoRequest
                {
                    Marca = CarroEdit.Marca,
                    Modelo = CarroEdit.Modelo,
                    Ano = CarroEdit.Ano,
                    Descricao = CarroEdit.Descricao,
                    ImagemUrl = CarroEdit.ImagemUrl,
                    Cor = CarroEdit.Cor,
                    Estilo = CarroEdit.Estilo,
                    Combustivel = CarroEdit.Combustivel,
                    Quilometragem = CarroEdit.Quilometragem,
                    Preco = CarroEdit.Preco,
                    Disponivel = (EstadoSelecionado == "Disponível"),
                    Galeria = CarroEdit.ImagensAdicionais.Select(x => new VeiculoImagemDto { ImagemUrl = x.ImagemUrl }).ToList()
                };

                var res = await Api.CreateVeiculoAsync(req);
                if (res.Success)
                {
                    ModalCarroAberto = false;
                    capaUpload = null;
                    galeriaUploads.Clear();
                    ShowToast("Veículo cadastrado com sucesso!", "success");
                    await LoadAdminDataAsync();
                }
                else
                {
                    ModalErro = res.Error ?? "Erro desconhecido ao criar veículo.";
                }
            }
            else
            {
                // Atualizar veículo existente
                var req = new UpdateVeiculoRequest
                {
                    Marca = CarroEdit.Marca,
                    Modelo = CarroEdit.Modelo,
                    Ano = CarroEdit.Ano,
                    Descricao = CarroEdit.Descricao,
                    ImagemUrl = CarroEdit.ImagemUrl,
                    Cor = CarroEdit.Cor,
                    Estilo = CarroEdit.Estilo,
                    Combustivel = CarroEdit.Combustivel,
                    Quilometragem = CarroEdit.Quilometragem,
                    Preco = CarroEdit.Preco,
                    Disponivel = (EstadoSelecionado == "Disponível"),
                    Galeria = CarroEdit.ImagensAdicionais.Select(x => new VeiculoImagemDto { ImagemUrl = x.ImagemUrl }).ToList()
                };

                var res = await Api.UpdateVeiculoAsync(CarroEdit.Id, req);
                if (res.Success)
                {
                    ModalCarroAberto = false;
                    capaUpload = null;
                    galeriaUploads.Clear();
                    ShowToast("Veículo atualizado com sucesso!", "success");
                    await LoadAdminDataAsync();
                }
                else
                {
                    ModalErro = res.Error ?? "Erro desconhecido ao atualizar veículo.";
                }
            }
        }
        catch (Exception ex)
        {
            ModalErro = $"Erro no processamento local das imagens: {ex.Message}";
        }
        finally
        {
            UploadEmProgresso = false;
        }
    }
   
