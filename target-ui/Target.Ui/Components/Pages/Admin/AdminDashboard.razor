<style>
/* ════════════════════════════════════════════════════
   FONTES — Sora (texto) · Rajdhani (destaques) · mono (códigos)
════════════════════════════════════════════════════ */
@@import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Sora:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap');

/* ════════════════════════════════════════════════════
   TOKENS — Cyberpunk Target
════════════════════════════════════════════════════ */
:root {
    --c:        #00f2ff;
    --c-dim:    rgba(0,242,255,.1);
    --c-brd:    rgba(0,242,255,.25);
    --purple:   #9b5de5;
    --pur-dim:  rgba(155,93,229,.12);
    --gold:     #ffc94d;
    --gold-dim: rgba(255,201,77,.1);
    --green:    #39ff14;
    --grn-dim:  rgba(57,255,20,.1);
    --red:      #ff3c5c;
    --red-dim:  rgba(255,60,92,.1);
    --warn:     #ffb800;
    --warn-dim: rgba(255,184,0,.1);
    --bg:       #060609;
    --bg2:      #0c0c14;
    --bg3:      #12121e;
    --brd:      rgba(255,255,255,.06);
    --txt:      #eef0fa;
    --dim:      #9b9bc4;
