@code {
    // Gestão de Estados de Abas
    private string abaAtiva = "painel";

    class ClienteData {
        public string Nome { get; set; } = string.Empty;
        public string Telefone { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Localizacao { get; set; } = string.Empty;

        public ClienteData() { }
        public ClienteData(string nome, string telefone, string email, string localizacao)
        {
            Nome = nome;
            Telefone = telefone;
            Email = email;
            Localizacao = localizacao;
        }
    }
    class PedidoModel {
        public string Id { get; set; } = "";
        public DateTime DataPedido { get; set; }
        public string Status { get; set; } = "";
        public string ViaturaNome { get; set; } = "";
        public string ViaturaImagem { get; set; } = "";
        public string TipoPedido { get; set; } = "";
        public string Showroom { get; set; } = "";
        public decimal Preco { get; set; }
    }

    private ClienteData cliente = new ClienteData("Aníbal Manuel", "+244 923 456 789", "anibal.manuel@targetcomex.ao", "Luanda, Angola");
    private ClienteData clienteForm = new ClienteData("", "", "", "");
    private List<PedidoModel> pedidos = new();
    private int? userId;
    private bool isLoading = true;
    private string? apiError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (!await AuthService.IsAuthenticatedAsync())
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        await LoadClienteAsync();
        StateHasChanged();
    }

    async Task LoadClienteAsync()
    {
        userId = await AuthService.GetUserIdAsync();
        if (userId == null)
        {
            apiError = "Utilizador não autenticado.";
            isLoading = false;
            return;
        }

        var userResult = await Api.GetUsuarioAsync(userId.Value);
        if (userResult.Success && userResult.Data != null)
        {
            var user = userResult.Data;
            cliente = new ClienteData(
                user.Nome,
                user.Telefone ?? string.Empty,
                user.Email,
                user.Endereco != null ? $"{user.Endereco.Provincia}, {user.Endereco.Municipio}" : "Luanda, Angola"
            );
            clienteForm = new ClienteData(cliente.Nome, cliente.Telefone, cliente.Email, cliente.Localizacao);
        }
        else
        {
            apiError = userResult.Error ?? "Erro ao carregar perfil.";
        }

        var historyResult = await Api.GetHistoricoComprasPorUsuarioAsync(userId.Value);
        if (historyResult.Success)
        {
            pedidos = historyResult.Data.Select(MapHistoricoParaPedido).ToList();
        }
        else
        {
            apiError = historyResult.Error ?? "Erro ao carregar pedidos.";
        }

        isLoading = false;
    }

    private static PedidoModel MapHistoricoParaPedido(HistoricoCompraDto dto)
    {
        return new PedidoModel
        {
            Id = $"TC-{dto.Id:D4}",
            DataPedido = dto.DataCompra,
            Status = "Concluído",
            ViaturaNome = dto.Veiculo != null ? $"{dto.Veiculo.Marca} {dto.Veiculo.Modelo}" : "Viatura",
            ViaturaImagem = dto.Veiculo?.ImagemUrl ?? "https://images.unsplash.com/photo-1549399542-7e3f8b79c341?auto=format&fit=crop&q=80&w=400",
            TipoPedido = "Compra",
            Showroom = dto.Veiculo?.Localizacao ?? "Samba",
            Preco = dto.ValorPago
        };
    }

    private async Task SalvarDados()
    {
        if (userId == null)
            return;

        var request = new UpdateUsuarioRequest
        {
            Nome = clienteForm.Nome,
            Telefone = clienteForm.Telefone,
            // O e-mail não pode ser alterado através do perfil do cliente.
            // A localização continua sendo mantida somente na UI por enquanto.
        };

        var result = await Api.UpdateUsuarioAsync(userId.Value, request);
        if (result.Success)
        {
            cliente = new ClienteData(clienteForm.Nome, clienteForm.Telefone, clienteForm.Email, clienteForm.Localizacao);
            abaAtiva = "painel";
        }
        else
        {
            apiError = result.Error ?? "Erro ao atualizar perfil.";
        }
    }

    private void MudarAba(string novaAba)
    {
        abaAtiva = novaAba;
    }

    private void CancelarPedido(string id)
    {
        var pedido = pedidos.FirstOrDefault(p => p.Id == id);
        if (pedido != null)
        {
            pedido.Status = "Cancelado";
        }
    }
}