@page "/area-cliente"
@rendermode InteractiveServer
@using System.Linq
@inject ApiClient Api
@inject AuthService AuthService
@inject NavigationManager Nav

<div class="tc-dashboard-container">
    <!-- EFEITOS DE FUNDO CYBERPUNK -->
    <div class="tc-grid-overlay"></div>
    <div class="tc-glow-orb-1"></div>
    <div class="tc-glow-orb-2"></div>

    <!-- ══════════════════════════════════════════════════════
         SIDEBAR ESQUERDA: NAVEGAÇÃO POR ABAS + PERFIL RESUMIDO
         ══════════════════════════════════════════════════════ -->
    <aside class="tc-sidebar">
        <!-- HEADER DO PERFIL -->
        <div class="tc-profile-section">
            <div class="tc-avatar-wrapper">
                <div class="tc-avatar-inner">
                    @cliente.Nome[0].ToString().ToUpper()
                </div>
                <div class="tc-avatar-pulse"></div>
            </div>
            <h3 class="tc-profile-name">@cliente.Nome.Split(' ').FirstOrDefault()</h3>
            <span class="tc-profile-status">
                <span class="tc-status-dot"></span> Cliente Target VIP
            </span>
        </div>

        <!-- MENU DE ABAS LATERAIS -->
        <nav class="tc-nav-menu">
            <button class="tc-nav-link @(abaAtiva == "painel" ? "active" : "")" @onclick='() => MudarAba("painel")'>
                <span class="tc-nav-icon">📊</span>
                <span class="tc-nav-text">Painel Geral</span>
                <span class="tc-nav-indicator"></span>
            </button>
            <button class="tc-nav-link @(abaAtiva == "pedidos" ? "active" : "")" @onclick='() => MudarAba("pedidos")'>
                <span class="tc-nav-icon">🚘</span>
                <span class="tc-nav-text">Meus Pedidos</span>
                <span class="tc-nav-badge">@pedidos.Count</span>
                <span class="tc-nav-indicator"></span>
            </button>
            <button class="tc-nav-link @(abaAtiva == "perfil" ? "active" : "")" @onclick='() => MudarAba("perfil")'>
                <span class="tc-nav-icon">👤</span>
                <span class="tc-nav-text">Dados Pessoais</span>
                <span class="tc-nav-indicator"></span>
            </button>
        </nav>

        <!-- FOOTER DA SIDEBAR -->
        <div class="tc-sidebar-footer">
            <div class="tc-ia-badge">
                <div class="tc-ia-core"></div>
                <span>TARGET IA • ATIVA</span>
            </div>
        </div>
    </aside>

    <!-- ══════════════════════════════════════════════════════
         CONTEÚDO PRINCIPAL (MUDANÇA DINÂMICA DE ABAS)
         ══════════════════════════════════════════════════════ -->
    <main class="tc-main-content">
        
        <!-- ─── ABA 1: PAINEL GERAL ─── -->
        @if (abaAtiva == "painel")
        {
            <div class="tc-view-fade-in">
                <div class="tc-page-header">
                    <h1 class="tc-page-title">Bem-vindo ao seu <span class="text-neon">Hub</span></h1>
                    <p class="tc-page-subtitle">Monitore os seus interesses, agendamentos e interações com a nossa inteligência de mercado.</p>
                </div>

                <!-- CARDS DE MÉTRICAS RÁPIDAS -->
                <div class="tc-metrics-grid">
                    <div class="tc-metric-card" @onclick='() => MudarAba("pedidos")'>
                        <div class="tc-metric-icon">📦</div>
                        <div class="tc-metric-info">
                            <span class="tc-metric-label">Pedidos Ativos</span>
                            <span class="tc-metric-value">@pedidos.Count(p => p.Status != "Cancelado")</span>
                        </div>
                    </div>
                    <div class="tc-metric-card">
                        <div class="tc-metric-icon">⚡</div>
                        <div class="tc-metric-info">
                            <span class="tc-metric-label">Score de Afinidade IA</span>
                            <span class="tc-metric-value" style="color: var(--cyan);">94%</span>
                        </div>
                    </div>
                    <div class="tc-metric-card">
                        <div class="tc-metric-icon">📍</div>
                        <div class="tc-metric-info">
                            <span class="tc-metric-label">Showroom Preferido</span>
                            <span class="tc-metric-value">Samba</span>
                        </div>
                    </div>
                </div>

                <!-- RECOMENDAÇÃO DA IA INTELIGENTE -->
                <div class="tc-ia-panel">
                    <div class="tc-ia-header">
                        <span class="tc-ia-icon-spark">✦</span>
                        <h3>Sugestão da Inteligência Artificial Target</h3>
                    </div>
                    <p class="tc-ia-text">
                        Detectamos o seu interesse pelo segmento SUV de alta performance. Com base na sua localização em <strong>@cliente.Localizacao</strong>, o novo lote do <strong>BAIC X55 II</strong> já se encontra disponível para Test Drive exclusivo no Showroom do Morro Bento. Gostaria de agendar?
                    </p>
                    <div class="tc-ia-actions">
                        <button class="tc-btn tc-btn-primary" @onclick='() => MudarAba("pedidos")'>Verificar Disponibilidade</button>
                    </div>
                </div>
            </div>
        }

        <!-- ─── ABA 2: MEUS PEDIDOS E RESERVAS ─── -->
        @if (abaAtiva == "pedidos")
        {
            <div class="tc-view-fade-in">
                <div class="tc-page-header">
                    <h1 class="tc-page-title">As Suas <span class="text-neon">Viaturas</span></h1>
                    <p class="tc-page-subtitle">Acompanhe o estado de processamento de reservas de compra e agendamentos de Test Drive.</p>
                </div>

                <div class="tc-orders-stack">
                    @foreach (var p in pedidos)
                    {
                        <div class="tc-order-glow-card @p.Status.ToLower()">
                            <div class="tc-og-line"></div>
                            <div class="tc-og-content">
                                <div class="tc-og-left">
                                    <div class="tc-img-container">
                                        <div class="tc-img-scan"></div>
                                        <img src="@p.ViaturaImagem" alt="@p.ViaturaNome" />
                                    </div>
                                    <div class="tc-og-details">
                                        <div class="tc-og-meta">
                                            <span class="tc-og-id">#@p.Id</span>
                                            <span class="tc-og-dot-sep">·</span>
                                            <span class="tc-og-date">@p.DataPedido.ToString("dd MMM yyyy")</span>
                                        </div>
                                        <h3 class="tc-og-title">@p.ViaturaNome</h3>
                                        <div class="tc-og-tags">
                                            <span class="tc-tag-pill">@p.TipoPedido</span>
                                            <span class="tc-tag-pill">Showroom: @p.Showroom</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="tc-og-right">
                                    <div class="tc-og-price-status">
                                        <span class="tc-og-price">AOA @p.Preco.ToString("N0").Replace(",", ".")</span>
                                        <span class="tc-badge-status @p.Status.ToLower()">
                                            <span class="tc-b-dot"></span> @p.Status
                                        </span>
                                    </div>
                                    <div class="tc-og-actions">
                                        @if (p.Status != "Cancelado" && p.Status != "Concluído")
                                        {
                                            <button class="tc-btn tc-btn-danger" @onclick="() => CancelarPedido(p.Id)">
                                                Cancelar
                                            </button>
                                        }
                                        <a href="/contacto" class="tc-btn tc-btn-secondary">Suporte</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ─── ABA 3: DADOS PESSOAIS (FORMULÁRIO PREMIUM) ─── -->
        @if (abaAtiva == "perfil")
        {
            <div class="tc-view-fade-in">
                <div class="tc-page-header">
                    <h1 class="tc-page-title">Configurações de <span class="text-neon">Perfil</span></h1>
                    <p class="tc-page-subtitle">Atualize as suas informações de contacto e credenciais de segurança na plataforma.</p>
                </div>

                <div class="tc-form-card">
                    <div class="tc-form-grid">
                        <div class="tc-input-group">
                            <label class="tc-input-label">Nome Completo</label>
                            <div class="tc-input-wrapper">
                                <span class="tc-input-icon">👤</span>
                                <input class="tc-input-field" type="text" @bind="clienteForm.Nome" />
                            </div>
                        </div>

                        <div class="tc-input-group">
                            <label class="tc-input-label">Terminal Telefónico</label>
                            <div class="tc-input-wrapper">
                                <span class="tc-input-icon">📞</span>
                                <input class="tc-input-field" type="tel" @bind="clienteForm.Telefone" />
                            </div>
                        </div>

                        <div class="tc-input-group">
                            <label class="tc-input-label">Correio Eletrónico (E-mail)</label>
                            <div class="tc-input-wrapper">
                                <span class="tc-input-icon">✉️</span>
                                <input class="tc-input-field" type="email" value="@clienteForm.Email" disabled />
                            </div>
                            <small class="tc-input-note">O e-mail não pode ser alterado aqui.</small>
                        </div>

                        <div class="tc-input-group">
                            <label class="tc-input-label">Província / Cidade de Residência</label>
                            <div class="tc-input-wrapper">
                                <span class="tc-input-icon">📍</span>
                                <input class="tc-input-field" type="text" @bind="clienteForm.Localizacao" />
                            </div>
                        </div>
                    </div>

                    <div class="tc-form-actions">
                        <button class="tc-btn tc-btn-primary" @onclick="SalvarDados">
                            Salvar Alterações
                        </button>
                        <button class="tc-btn tc-btn-ghost" @onclick='() => MudarAba("painel")'>
                            Descartar
                        </button>
                    </div>
                </div>
            </div>
        }
    </main>
</div>

<!-- ══════════════════════════════════════════════════════
     FOLHA DE ESTILO - ARQUITETURA CYBERPUNK PREMIUM
     ══════════════════════════════════════════════════════ -->
<style>
    :root {
        --cyan: #00f2ff;
        --cyan-rgb: 0, 242, 255;
        --bg-cyber: #050508;
        --panel-bg: rgba(13, 13, 18, 0.7);
        --panel-border: rgba(0, 242, 255, 0.08);
        --panel-border-glow: rgba(0, 242, 255, 0.2);
        --text-primary: #ffffff;
        --text-secondary: #8fa0a6;
        --radius-lg: 20px;
        --radius-md: 12px;
        --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    /* CONTAINER PRINCIPAL DO DASHBOARD */
    .tc-dashboard-container {
        position: relative;
        display: grid;
        grid-template-columns: 300px 1fr;
        min-height: 100vh;
        background: var(--bg-cyber);
        color: var(--text-primary);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        overflow: hidden;
    }

    /* EFEITOS DE AMBIENTE NEON DE FUNDO */
    .tc-grid-overlay {
        position: absolute; inset: 0; pointer-events: none; opacity: 0.15;
        background-image: linear-gradient(rgba(0, 242, 255, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 242, 255, 0.05) 1px, transparent 1px);
        background-size: 40px 40px; z-index: 1;
    }
    .tc-glow-orb-1 {
        position: absolute; top: -200px; right: -200px; width: 600px; height: 600px;
        background: radial-gradient(circle, rgba(var(--cyan-rgb), 0.08) 0%, transparent 70%); pointer-events: none; z-index: 1;
    }
    .tc-glow-orb-2 {
        position: absolute; bottom: -200px; left: -100px; width: 500px; height: 500px;
        background: radial-gradient(circle, rgba(147, 51, 234, 0.06) 0%, transparent 70%); pointer-events: none; z-index: 1;
    }

    /* SIDEBAR COMPACTA E ULTRA MODERNA */
    .tc-sidebar {
        position: relative;
        background: rgba(8, 8, 12, 0.85);
        border-right: 1px solid var(--panel-border);
        backdrop-filter: blur(20px);
        padding: 40px 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        z-index: 10;
    }

    .tc-profile-section { text-align: center; margin-bottom: 40px; }
    .tc-avatar-wrapper { position: relative; width: 80px; height: 80px; margin: 0 auto 16px; }
    .tc-avatar-inner {
        width: 100%; height: 100%; background: linear-gradient(135deg, rgba(var(--cyan-rgb), 0.15), rgba(147, 51, 234, 0.15));
        border: 2px solid var(--cyan); border-radius: 50%; display: grid; place-items: center;
        font-size: 2rem; font-weight: 800; color: var(--cyan); box-shadow: 0 0 20px rgba(var(--cyan-rgb), 0.2);
    }
    .tc-avatar-pulse {
        position: absolute; inset: -4px; border: 1px solid rgba(var(--cyan-rgb), 0.3); border-radius: 50%;
        animation: pulseAvatar 2s infinite linear; pointer-events: none;
    }
    @@keyframes pulseAvatar { 0% { transform: scale(1); opacity: 1; } 100% { transform: scale(1.15); opacity: 0; } }
    
    .tc-profile-name { font-size: 1.25rem; font-weight: 700; margin-bottom: 6px; letter-spacing: -0.02em; }
    .tc-profile-status { display: inline-flex; align-items: center; gap: 6px; font-size: 0.75rem; color: var(--text-secondary); background: rgba(255,255,255,0.03); padding: 4px 12px; border-radius: 100px; border: 1px solid rgba(255,255,255,0.05); }
    .tc-status-dot { width: 6px; height: 6px; background: #10b981; border-radius: 50%; box-shadow: 0 0 8px #10b981; }

    /* NAVEGAÇÃO DE ABAS LATERAIS INTERATIVAS */
    .tc-nav-menu { display: flex; flex-direction: column; gap: 8px; flex: 1; }
    .tc-nav-link {
        position: relative; display: flex; align-items: center; gap: 14px; background: transparent;
        border: none; padding: 14px 16px; border-radius: var(--radius-md); color: var(--text-secondary);
        font-weight: 600; font-size: 0.92rem; text-align: left; cursor: pointer; transition: var(--transition);
    }
    .tc-nav-link:hover { background: rgba(255, 255, 255, 0.03); color: #fff; }
    .tc-nav-link.active { background: rgba(0, 242, 255, 0.06); color: var(--cyan); border: 1px solid rgba(0, 242, 255, 0.15); }
    
    .tc-nav-indicator { position: absolute; right: 12px; top: 50%; transform: translateY(-50%) scale(0); width: 6px; height: 6px; background: var(--cyan); border-radius: 50%; box-shadow: 0 0 10px var(--cyan); transition: var(--transition); }
    .tc-nav-link.active .tc-nav-indicator { transform: translateY(-50%) scale(1); }
    .tc-nav-badge { background: rgba(255,255,255,0.1); color: #fff; font-size: 0.72rem; padding: 2px 8px; border-radius: 100px; font-weight: 700; margin-left: auto; }
    .tc-nav-link.active .tc-nav-badge { background: var(--cyan); color: #000; }

    .tc-sidebar-footer { padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.03); }
    .tc-ia-badge { display: flex; align-items: center; gap: 8px; font-size: 0.7rem; font-weight: 800; color: var(--text-secondary); letter-spacing: 0.05em; }
    .tc-ia-core { width: 8px; height: 8px; background: var(--cyan); border-radius: 2px; transform: rotate(45deg); box-shadow: 0 0 8px var(--cyan); animation: spinCore 4s infinite linear; }
    @@keyframes spinCore { 100% { transform: rotate(405deg); } }

    /* CONTEÚDO PRINCIPAL */
    .tc-main-content { position: relative; padding: 60px 50px; z-index: 5; overflow-y: auto; height: 100vh; }
    .tc-view-fade-in { animation: viewFadeIn 0.4s ease-out forwards; }
    @@keyframes viewFadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    .tc-page-header { margin-bottom: 40px; }
    .tc-page-title { font-size: 2.25rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 8px; }
    .text-neon { color: var(--cyan); text-shadow: 0 0 20px rgba(var(--cyan-rgb), 0.3); }
    .tc-page-subtitle { color: var(--text-secondary); font-size: 1rem; max-width: 700px; }

    /* CARDS DE MÉTRICAS */
    .tc-metrics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 32px; }
    .tc-metric-card {
        background: var(--panel-bg); border: 1px solid var(--panel-border); padding: 24px; border-radius: var(--radius-md);
        display: flex; align-items: center; gap: 16px; cursor: pointer; transition: var(--transition); backdrop-filter: blur(10px);
    }
    .tc-metric-card:hover { border-color: var(--panel-border-glow); transform: translateY(-2px); background: rgba(20, 20, 28, 0.8); }
    .tc-metric-icon { font-size: 1.8rem; background: rgba(255,255,255,0.03); width: 48px; height: 48px; display: grid; place-items: center; border-radius: 10px; }
    .tc-metric-info { display: flex; flex-direction: column; }
    .tc-metric-label { font-size: 0.78rem; color: var(--text-secondary); font-weight: 500; text-transform: uppercase; letter-spacing: 0.03em; }
    .tc-metric-value { font-size: 1.35rem; font-weight: 700; margin-top: 2px; }

    /* PAINEL DE INTELIGÊNCIA ARTIFICIAL */
    .tc-ia-panel {
        position: relative; background: linear-gradient(145deg, rgba(13, 25, 35, 0.7) 0%, rgba(15, 10, 28, 0.7) 100%);
        border: 1px solid rgba(var(--cyan-rgb), 0.15); border-radius: var(--radius-lg); padding: 32px; backdrop-filter: blur(10px);
    }
    .tc-ia-header { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; color: var(--cyan); }
    .tc-ia-icon-spark { font-size: 1.4rem; animation: pulseSpark 1.5s infinite ease-in-out; }
    @@keyframes pulseSpark { 0%, 100% { opacity: 0.5; transform: scale(0.9); } 50% { opacity: 1; transform: scale(1.1); text-shadow: 0 0 12px var(--cyan); } }
    .tc-ia-header h3 { font-size: 1.1rem; font-weight: 700; letter-spacing: -0.01em; color: #fff; }
    .tc-ia-text { color: var(--text-secondary); line-height: 1.6; font-size: 0.95rem; margin-bottom: 20px; }

    /* CARDS DE PEDIDOS COM BRILHO ADAPTATIVO */
    .tc-orders-stack { display: flex; flex-direction: column; gap: 20px; }
    .tc-order-glow-card {
        position: relative; background: var(--panel-bg); border: 1px solid var(--panel-border);
        border-radius: var(--radius-lg); overflow: hidden; backdrop-filter: blur(10px); transition: var(--transition);
    }
    .tc-order-glow-card:hover { border-color: rgba(var(--cyan-rgb), 0.25); box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
    
    /* Indicador lateral colorido baseado no status */
    .tc-og-line { position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: #64748b; }
    .tc-order-glow-card.confirmado .tc-og-line { background: #10b981; box-shadow: 0 0 15px #10b981; }
    .tc-order-glow-card.pendente .tc-og-line { background: #f59e0b; box-shadow: 0 0 15px #f59e0b; }
    .tc-order-glow-card.cancelado .tc-og-line { background: #ef4444; }

    .tc-og-content { display: flex; justify-content: space-between; align-items: center; padding: 24px; gap: 30px; }
    .tc-og-left { display: flex; align-items: center; gap: 24px; }
    
    .tc-img-container { position: relative; width: 120px; height: 85px; background: #0c0c12; border-radius: var(--radius-md); overflow: hidden; border: 1px solid rgba(255,255,255,0.03); }
    .tc-img-container img { width: 100%; height: 100%; object-fit: cover; }
    
    .tc-og-details { display: flex; flex-direction: column; gap: 4px; }
    .tc-og-meta { display: flex; align-items: center; gap: 8px; font-size: 0.8rem; }
    .tc-og-id { font-family: monospace; color: var(--cyan); font-weight: 700; }
    .tc-og-date { color: var(--text-secondary); }
    .tc-og-dot-sep { color: rgba(255,255,255,0.15); }
    .tc-og-title { font-size: 1.3rem; font-weight: 700; color: #fff; letter-spacing: -0.02em; }
    
    .tc-og-tags { display: flex; gap: 8px; margin-top: 4px; }
    .tc-tag-pill { font-size: 0.72rem; font-weight: 600; padding: 4px 10px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 6px; color: var(--text-secondary); }

    .tc-og-right { display: flex; align-items: center; gap: 40px; }
    .tc-og-price-status { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
    .tc-og-price { font-size: 1.2rem; font-weight: 800; color: #fff; }
    
    .tc-badge-status { display:inline-flex; align-items:center; gap:6px; font-size:0.72rem; font-weight:700; text-transform:uppercase; padding:4px 12px; border-radius:100px; }
    .tc-badge-status.confirmado { background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); }
    .tc-badge-status.pendente { background: rgba(245, 158, 11, 0.1); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.2); }
    .tc-badge-status.cancelado { background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); }
    .tc-b-dot { width: 5px; height: 5px; background: currentColor; border-radius: 50%; }

    .tc-og-actions { display: flex; gap: 10px; }

    /* BOTÕES COM ATITUDE SCI-FI */
    .tc-btn {
        display: inline-flex; align-items: center; justify-content: center; font-weight: 700;
        font-size: 0.85rem; padding: 10px 20px; border-radius: var(--radius-md); transition: var(--transition);
        cursor: pointer; border: none; white-space: nowrap;
    }
    .tc-btn-primary { background: var(--cyan); color: #000; box-shadow: 0 4px 15px rgba(0, 242, 255, 0.25); }
    .tc-btn-primary:hover { background: #5ef7ff; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(0, 242, 255, 0.4); }
    
    .tc-btn-secondary { background: rgba(255,255,255,0.04); color: #fff; border: 1px solid rgba(255,255,255,0.08); }
    .tc-btn-secondary:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.2); }
    
    .tc-btn-ghost { background: transparent; color: var(--text-secondary); }
    .tc-btn-ghost:hover { color: #fff; }
    
    .tc-btn-danger { background: rgba(239,68,68,0.1); color: #ef4444; border: 1px solid rgba(239,68,68,0.15); }
    .tc-btn-danger:hover { background: #ef4444; color: #fff; }

    /* FORMULÁRIO DE DADOS DE CONFIGURAÇÃO */
    .tc-form-card { background: var(--panel-bg); border: 1px solid var(--panel-border); padding: 40px; border-radius: var(--radius-lg); backdrop-filter: blur(10px); }
    .tc-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 32px; }
    .tc-input-group { display: flex; flex-direction: column; gap: 8px; }
    .tc-input-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); letter-spacing: 0.05em; }
    
    .tc-input-wrapper { position: relative; display: flex; align-items: center; }
    .tc-input-icon { position: absolute; left: 16px; color: var(--text-secondary); font-size: 0.95rem; pointer-events: none; }
    .tc-input-field {
