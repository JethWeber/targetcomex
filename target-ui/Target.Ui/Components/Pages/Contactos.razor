    record Showroom(string Nome, string Endereco, string Telefone, string Imagem, string Ano, List<string> Marcas);

    List<Showroom> showrooms = new()
    {
        new("Viana",
            "Estrada de Viana, Luanda",
            "+244 959 288 882",
            "img/showroom-viana.jpg",
            "Desde 2007",
            new() { "BAIC", "Multimarca" }),

        new("Samba",
            "Rua da Samba, Luanda",
            "+244 959 288 883",
            "img/showroom-samba.jpg",
            "Desde 2018",
            new() { "Suzuki" }),

        new("Talatona",
            "Via Expressa Sul, Talatona",
            "+244 959 288 884",
            "img/showroom-talatona.jpg",
            "Desde 2021",
            new() { "BAIC", "Forthing" }),

        new("Kilamba",
            "Cidade do Kilamba, Luanda Sul",
            "+244 959 288 885",
            "img/showroom-kilamba.jpg",
            "Recente",
            new() { "Multimarca" }),
    };

    class ContactForm
    {
        public string Nome      { get; set; } = "";
        public string Telefone  { get; set; } = "";
        public string Assunto   { get; set; } = "";
        public string Showroom  { get; set; } = "";
        public string Mensagem  { get; set; } = "";
    }

    ContactForm form    = new();
    bool enviando       = false;
    bool enviado        = false;
    string erroGeral    = "";
    Dictionary<string, string> erros = new();

    bool Validar()
    {
        erros.Clear();
        if (string.IsNullOrWhiteSpace(form.Nome))
            erros["Nome"] = "O nome é obrigatório.";
        if (string.IsNullOrWhiteSpace(form.Telefone))
            erros["Telefone"] = "O telefone é obrigatório.";
        if (string.IsNullOrWhiteSpace(form.Assunto))
            erros["Assunto"] = "Selecione um assunto.";
        if (string.IsNullOrWhiteSpace(form.Mensagem))
            erros["Mensagem"] = "Escreva a sua mensagem.";
        return erros.Count == 0;
    }

    async Task EnviarSMS()
    {
        erroGeral = "";
        if (!Validar()) return;

        enviando = true;
        StateHasChanged();

        try
        {
            // Formata a mensagem SMS
            var showroomTexto = string.IsNullOrEmpty(form.Showroom) ? "Qualquer" : form.Showroom;
            var smsBody = $"[Target Comex]\nNome: {form.Nome}\nTel: {form.Telefone}\nAssunto: {form.Assunto}\nShowroom: {showroomTexto}\nMensagem: {form.Mensagem}";

            // Envia via API SMS — adapte o endpoint e token à sua plataforma (ex: Africa's Talking, Twilio, etc.)
            var payload = new
            {
                to      = "+244959288888",   // número de destino (backoffice Target Comex)
                message = smsBody
            };

            var json    = JsonSerializer.Serialize(payload);
            var content = new StringContent(json, Encoding.UTF8, "application/json");

            // Substitua o URL abaixo pelo endpoint real da sua plataforma SMS
            var http     = HttpFactory.CreateClient("Api");
            var response = await http.PostAsync("api/sms/enviar", content);

            if (response.IsSuccessStatusCode)
            {
                enviado = true;
            }
            else
            {
                erroGeral = "Não foi possível enviar a mensagem. Tente ligar diretamente.";
            }
        }
        catch
        {
            erroGeral = "Erro de ligação. Por favor tente novamente ou ligue-nos.";
        }
        finally
        {
            enviando = false;
            StateHasChanged();
        }
    }

    void ResetForm()
    {
        form    = new();
        enviado = false;
        erros.Clear();
        erroGeral = "";
    }
}

<!-- Scroll Reveal -->
<script>
(function () {
    var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
            if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
        });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

    function observe() {
        document.querySelectorAll('.anim-reveal').forEach(function(el) { io.observe(el); });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', observe);
    else observe();

    new MutationObserver(observe).observe(document.body, { childList: true, subtree: true });
})();
</script>