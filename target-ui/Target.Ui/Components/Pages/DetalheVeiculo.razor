@code {
    [Parameter] public int VeiculoId { get; set; }

    // ── Modelo ──────────────────────────────────────────
    record Veiculo(
        int    Id,
        string Nome,
        string Marca,
        string Combustivel,
        string Transmissao,
        string Motor,
        int    Potencia,
        int    Ano,
        long   Preco,
        int    ScoreIA,
        string Localizacao,
        string Imagem
    );

    record Comentario(string Autor, string Texto, int Avaliacao, DateTime Data, bool IsNew = false);

    // ── Dados ─────────────────────────────────────────────
    List<Veiculo> todos = new()
    {
        new(1,  "BMW M4 Competition",    "BMW",      "Gasolina", "Automática", "3.0L Twin-Turbo",  510,  2023, 420_000_000, 97, "Luanda",   "img/cars/bmw-m4.jpg"),
        new(2,  "Tesla Model S Plaid",   "Tesla",    "Elétrico", "Automática", "Tri-Motor",        1020, 2024, 650_000_000, 99, "Luanda",   "img/cars/tesla-ms.jpg"),
        new(3,  "Mercedes-AMG C63",      "Mercedes", "Híbrido",  "Automática", "2.0L Turbo-Híb",  680,  2024, 580_000_000, 95, "Benguela", "img/cars/amg-c63.jpg"),
        new(4,  "Toyota GR Supra 3.0",   "Toyota",   "Gasolina", "Manual",     "3.0L Turbo",       382,  2022, 280_000_000, 88, "Luanda",   "img/cars/supra.jpg"),
        new(5,  "Audi RS6 Avant",        "Audi",     "Gasolina", "Automática", "4.0L V8 Turbo",    600,  2023, 510_000_000, 94, "Lubango",  "img/cars/rs6.jpg"),
        new(6,  "Hyundai IONIQ 6",       "Hyundai",  "Elétrico", "Automática", "Dual Motor",       320,  2024, 210_000_000, 91, "Luanda",   "img/cars/ioniq6.jpg"),
        new(7,  "BMW iX M60",            "BMW",      "Elétrico", "Automática", "Dual Motor",       619,  2024, 720_000_000, 96, "Luanda",   "img/cars/bmw-ix.jpg"),
        new(8,  "Mercedes EQS 450+",     "Mercedes", "Elétrico", "Automática", "Single Motor",     329,  2023, 480_000_000, 93, "Benguela", "img/cars/eqs.jpg"),
        new(9,  "Audi Q8 e-tron",        "Audi",     "Elétrico", "Automática", "Dual Motor",       408,  2024, 550_000_000, 92, "Luanda",   "img/cars/q8-etron.jpg"),
        new(10, "Toyota bZ4X",           "Toyota",   "Elétrico", "Automática", "Dual Motor",       218,  2023, 180_000_000, 85, "Luanda",   "img/cars/bz4x.jpg"),
        new(11, "BMW 330e",              "BMW",      "Híbrido",  "Automática", "2.0L Turbo-Híb",  293,  2022, 260_000_000, 87, "Malanje",  "img/cars/330e.jpg"),
        new(12, "Mercedes C 300 e",      "Mercedes", "Híbrido",  "Automática", "2.0L Turbo-Híb",  313,  2023, 370_000_000, 89, "Luanda",   "img/cars/c300e.jpg"),
    };

    Veiculo? veiculo;
    List<Veiculo> outrosVeiculos = new();
    List<string> fotos = new();
    string fotoPrincipal = "";
    bool isFav = false;

    // ── Comentários ─────────────────────────────────────
    List<Comentario> comentarios = new()
    {
        new("Carlos M.",   "Testei este carro e fiquei impressionado com a resposta do motor. Vale cada kwanza!", 5, DateTime.Now.AddDays(-3)),
        new("Ana Ferreira","Relação custo-benefício excelente para o mercado angolano. Recomendo vivamente.", 4, DateTime.Now.AddDays(-7)),
    };

    string novoAutor  = "";
    string novoTexto  = "";
    int    novaAvaliacao = 0;
    bool   mostrarSucesso = false;

    bool PodeSubmeter => !string.IsNullOrWhiteSpace(novoAutor)
                      && !string.IsNullOrWhiteSpace(novoTexto)
                      && novaAvaliacao > 0;

    protected override void OnParametersSet()
    {
        Console.WriteLine($"VeiculoId recebido: {VeiculoId}");
        veiculo = todos.FirstOrDefault(v => v.Id == VeiculoId) ?? todos[0];
        outrosVeiculos = todos.Where(v => v.Id != veiculo!.Id).OrderByDescending(v => v.ScoreIA).ToList();

        // Simula múltiplas fotos reutilizando a imagem principal
        fotos = new List<string> {
            veiculo!.Imagem,
            outrosVeiculos.ElementAtOrDefault(0)?.Imagem ?? veiculo.Imagem,
            outrosVeiculos.ElementAtOrDefault(1)?.Imagem ?? veiculo.Imagem,
            outrosVeiculos.ElementAtOrDefault(2)?.Imagem ?? veiculo.Imagem,
        };
        fotoPrincipal = fotos[0];
    }

    async Task SubmeterComentario()
    {
        if (!PodeSubmeter) return;

        var novo = new Comentario(novoAutor.Trim(), novoTexto.Trim(), novaAvaliacao, DateTime.Now, true);
        comentarios.Add(novo);

        novoAutor     = "";
        novoTexto     = "";
        novaAvaliacao = 0;
        mostrarSucesso = true;

        await Task.Delay(3200);
        mostrarSucesso = false;
    }
}
