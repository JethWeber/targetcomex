@page "/detalhes-veiculo/{VeiculoId:int}"
@using System.Linq

<!-- ══════════════════════════════════════════════════════
     DETALHE DO VEÍCULO
══════════════════════════════════════════════════════ -->

@if (veiculo == null)
{
    <div class="dv-loading">
        <div class="dv-spinner"></div>
        <p>A carregar veículo...</p>
    </div>
}
else
{
<!-- ── HERO IMAGEM PRINCIPAL ── -->
<section class="dv-hero">
    <div class="dv-hero-img-wrap">
        <img src="@fotoPrincipal" alt="@veiculo.Nome" class="dv-hero-img" />
        <div class="dv-hero-overlay"></div>
        <div class="dv-scan-line"></div>
    </div>

    <div class="dv-hero-content">
        <a href="/produtos" class="dv-back-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M19 12H5M5 12l7-7M5 12l7 7"/>
            </svg>
            Voltar ao Catálogo
        </a>

        <div class="dv-hero-meta">
            <span class="dv-badge-fuel">@veiculo.Combustivel</span>
            <span class="dv-badge-score">⚡ @veiculo.ScoreIA% IA Match</span>
        </div>

        <h1 class="dv-hero-title">@veiculo.Nome</h1>

        <div class="dv-hero-quick">
            <div class="dv-quick-item">
                <span class="dv-quick-value">@veiculo.Potencia</span>
                <span class="dv-quick-label">cv</span>
            </div>
            <div class="dv-quick-sep"></div>
            <div class="dv-quick-item">
                <span class="dv-quick-value">@veiculo.Ano</span>
                <span class="dv-quick-label">Ano</span>
            </div>
            <div class="dv-quick-sep"></div>
            <div class="dv-quick-item">
                <span class="dv-quick-value">@veiculo.Transmissao</span>
                <span class="dv-quick-label">Câmbio</span>
            </div>
        </div>

        <div class="dv-hero-price">
            <span class="dv-price-label">Preço</span>
            <span class="dv-price-value">AOA @veiculo.Preco.ToString("N0").Replace(",",".")</span>
        </div>
    </div>
</section>

<!-- ── BODY ── -->
<div class="dv-body">

    <!-- COLUNA PRINCIPAL -->
    <main class="dv-main">

        <!-- GALERIA -->
        <section class="dv-section dv-gallery-section">
            <h2 class="dv-section-title">
                <span class="dv-title-line"></span>
                Galeria de Fotos
            </h2>
            <div class="dv-gallery">
                @for (int i = 0; i < fotos.Count; i++)
                {
                    var idx = i;
                    <div class="dv-thumb @(fotoPrincipal == fotos[idx] ? "active" : "")"
                         @onclick="() => fotoPrincipal = fotos[idx]">
                        <img src="@fotos[idx]" alt="Foto @(idx+1)" />
                        <div class="dv-thumb-overlay"></div>
                    </div>
                }
            </div>
        </section>

        <!-- ESPECIFICAÇÕES TÉCNICAS -->
        <section class="dv-section">
            <h2 class="dv-section-title">
                <span class="dv-title-line"></span>
                Especificações Técnicas
            </h2>
            <div class="dv-specs-grid">
                <div class="dv-spec-card">
                    <div class="dv-spec-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
                        </svg>
                    </div>
                    <div class="dv-spec-info">
                        <span class="dv-spec-label">Motor</span>
                        <span class="dv-spec-value">@veiculo.Motor</span>
                    </div>
                </div>
                <div class="dv-spec-card">
                    <div class="dv-spec-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                        </svg>
                    </div>
                    <div class="dv-spec-info">
                        <span class="dv-spec-label">Potência</span>
                        <span class="dv-spec-value">@veiculo.Potencia cv</span>
                    </div>
                </div>
                <div class="dv-spec-card">
                    <div class="dv-spec-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                        </svg>
                    </div>
                    <div class="dv-spec-info">
                        <span class="dv-spec-label">Ano</span>
                        <span class="dv-spec-value">@veiculo.Ano</span>
                    </div>
                </div>
                <div class="dv-spec-card">
                    <div class="dv-spec-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                        </svg>
                    </div>
                    <div class="dv-spec-info">
                        <span class="dv-spec-label">Combustível</span>
                        <span class="dv-spec-value">@veiculo.Combustivel</span>
                    </div>
                </div>
                <div class="dv-spec-card">
                    <div class="dv-spec-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <circle cx="12" cy="12" r="10"/><path d="M4.93 4.93 19.07 19.07"/>
                        </svg>
                    </div>
                    <div class="dv-spec-info">
                        <span class="dv-spec-label">Transmissão</span>
                        <span class="dv-spec-value">@veiculo.Transmissao</span>
                    </div>
                </div>
                <div class="dv-spec-card">
                    <div class="dv-spec-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                        </svg>
                    </div>
                    <div class="dv-spec-info">
                        <span class="dv-spec-label">Localização</span>
                        <span class="dv-spec-value">@veiculo.Localizacao</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- PORQUE ESTE CARRO (IA) -->
        <section class="dv-section">
            <div class="dv-ai-card">
                <div class="dv-ai-header">
                    <div class="dv-ai-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="dv-ai-label">Análise por Inteligência Artificial</div>
                        <h3 class="dv-ai-title">Por que este carro combina com você</h3>
                    </div>
                    <div class="dv-ai-score-badge">@veiculo.ScoreIA%</div>
                </div>
                <p class="dv-ai-text">
                    A análise com IA identificou que o <strong>@veiculo.Nome</strong> tem uma compatibilidade de
                    <span class="dv-cyan">@veiculo.ScoreIA%</span> com o seu perfil. Com o motor <strong>@veiculo.Motor</strong>
                    e @veiculo.Potencia cv de potência, este veículo encaixa perfeitamente nas preferências registadas:
                    performance elevada, transmissão @veiculo.Transmissao e tecnologia de propulsão @veiculo.Combustivel.
                    A relação custo-benefício está acima da média do mercado angolano, com histórico de manutenção verificado
                    e garantia de procedência documentada.
                </p>
                <div class="dv-ai-bars">
                    <div class="dv-ai-bar-row">
                        <span>Performance</span>
                        <div class="dv-ai-bar-track"><div class="dv-ai-bar-fill" style="width:@(veiculo.Potencia > 500 ? 95 : veiculo.Potencia > 300 ? 80 : 65)%"></div></div>
                        <span class="dv-cyan">@(veiculo.Potencia > 500 ? 95 : veiculo.Potencia > 300 ? 80 : 65)%</span>
                    </div>
                    <div class="dv-ai-bar-row">
                        <span>Eficiência</span>
                        <div class="dv-ai-bar-track"><div class="dv-ai-bar-fill" style="width:@(veiculo.Combustivel == "Elétrico" ? 98 : veiculo.Combustivel == "Híbrido" ? 85 : 68)%"></div></div>
                        <span class="dv-cyan">@(veiculo.Combustivel == "Elétrico" ? 98 : veiculo.Combustivel == "Híbrido" ? 85 : 68)%</span>
                    </div>
                    <div class="dv-ai-bar-row">
                        <span>Custo-Benefício</span>
                        <div class="dv-ai-bar-track"><div class="dv-ai-bar-fill" style="width:@veiculo.ScoreIA%"></div></div>
                        <span class="dv-cyan">@veiculo.ScoreIA%</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══ SECÇÃO DE COMENTÁRIOS ══ -->
        <section class="dv-section dv-comments-section">
            <h2 class="dv-section-title">
                <span class="dv-title-line"></span>
                Comentários <span class="dv-comment-count">(@comentarios.Count)</span>
            </h2>

            <!-- Formulário de novo comentário -->
            <div class="dv-comment-form">
                <div class="dv-cf-header">
                    <div class="dv-cf-avatar">@(string.IsNullOrWhiteSpace(novoAutor) ? "?" : novoAutor[0].ToString().ToUpper())</div>
                    <div class="dv-cf-fields">
                        <input class="dv-cf-input dv-cf-name"
                               type="text"
                               placeholder="O seu nome"
                               @bind="novoAutor"
                               @bind:event="oninput"
                               maxlength="50" />
                        <div class="dv-cf-rating-row">
                            <span class="dv-cf-rating-label">Avaliação:</span>
                            @for (int s = 1; s <= 5; s++)
                            {
                                var star = s;
                                <button class="dv-star @(star <= novaAvaliacao ? "active" : "")"
                                        @onclick="() => novaAvaliacao = star">★</button>
                            }
                        </div>
                    </div>
                </div>
                <textarea class="dv-cf-textarea"
                          placeholder="Partilhe a sua opinião sobre este veículo…"
                          @bind="novoTexto"
                          @bind:event="oninput"
                          rows="4"
                          maxlength="500"></textarea>
                <div class="dv-cf-footer">
                    <span class="dv-char-count">@novoTexto.Length / 500</span>
                    <button class="dv-submit-btn"
                            @onclick="SubmeterComentario"
                            disabled="@(!PodeSubmeter)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
                        </svg>
                        Publicar Comentário
                    </button>
                </div>
                @if (mostrarSucesso)
                {
                    <div class="dv-success-toast">✓ Comentário publicado com sucesso!</div>
                }
            </div>

            <!-- Lista de comentários -->
            @if (!comentarios.Any())
            {
                <div class="dv-no-comments">
                    <div class="dv-no-comments-icon">💬</div>
                    <p>Seja o primeiro a comentar este veículo.</p>
                </div>
            }
            else
            {
                <div class="dv-comment-list">
                    @foreach (var c in comentarios.OrderByDescending(x => x.Data))
                    {
                        <div class="dv-comment-card @(c.IsNew ? "dv-comment-new" : "")">
                            <div class="dv-comment-avatar">@c.Autor[0].ToString().ToUpper()</div>
                            <div class="dv-comment-body">
                                <div class="dv-comment-meta">
                                    <span class="dv-comment-autor">@c.Autor</span>
                                    <div class="dv-comment-stars">
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            <span class="@(s <= c.Avaliacao ? "dv-star-filled" : "dv-star-empty")">★</span>
                                        }
                                    </div>
                                    <span class="dv-comment-data">@c.Data.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <p class="dv-comment-text">@c.Texto</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

    </main>

    <!-- SIDEBAR -->
    <aside class="dv-sidebar">

        <!-- PREÇO -->
        <div class="dv-side-card dv-price-card">
            <div class="dv-price-main">AOA @veiculo.Preco.ToString("N0").Replace(",",".")</div>
            <div class="dv-price-note">Preço de venda • IVA incluído</div>
            <button class="dv-cta-btn dv-cta-primary">Reservar</button>
            <button class="dv-cta-btn dv-cta-secondary">Agendar Test Drive</button>
            <div class="dv-cta-divider">ou</div>
            <button class="dv-cta-btn dv-cta-ghost">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="@(isFav ? "#00f2ff" : "none")" stroke="#00f2ff" stroke-width="2">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
                @(isFav ? "Guardado nos Favoritos" : "Guardar nos Favoritos")
            </button>
        </div>

        <!-- GUY PERFIL (IA) -->
        <div class="dv-side-card">
            <div class="dv-side-title">Guy Perfil</div>
            <div class="dv-profile-tags">
                <span class="dv-ptag">Performance</span>
                <span class="dv-ptag">Tecnologia</span>
                <span class="dv-ptag">@veiculo.Combustivel</span>
                <span class="dv-ptag">Luxo</span>
                <span class="dv-ptag">@veiculo.Transmissao</span>
            </div>
        </div>

        <!-- NOVOS FAVORITOS (outros) -->
        <div class="dv-side-card">
            <div class="dv-side-title">Novos Favoritos</div>
            <div class="dv-favs-list">
                @foreach (var f in outrosVeiculos.Take(3))
                {
                    <div class="dv-fav-item">
                        <img src="@f.Imagem" alt="@f.Nome" class="dv-fav-img" />
                        <div class="dv-fav-info">
                            <div class="dv-fav-name">@f.Nome</div>
                            <div class="dv-fav-price">AOA @(f.Preco / 1_000_000)M</div>
                        </div>
                        <div class="dv-fav-score">@f.ScoreIA%</div>
                    </div>
                }
            </div>
        </div>

        <!-- SCORE BREAKDOWN -->
        <div class="dv-side-card dv-score-card">
            <div class="dv-side-title">Score IA</div>
            <div class="dv-score-ring-wrap">
                <svg class="dv-score-ring" viewBox="0 0 80 80">
                    <circle cx="40" cy="40" r="34" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="7"/>
                    <circle cx="40" cy="40" r="34" fill="none" stroke="#00f2ff" stroke-width="7"
                            stroke-dasharray="@(2 * Math.PI * 34 * veiculo.ScoreIA / 100) @(2 * Math.PI * 34)"
                            stroke-linecap="round"
                            transform="rotate(-90 40 40)"/>
                    <text x="40" y="44" text-anchor="middle" fill="#00f2ff" font-size="14" font-weight="800">@veiculo.ScoreIA%</text>
                </svg>
            </div>
            <p class="dv-score-desc">Compatibilidade com o seu perfil de condutor</p>
        </div>

    </aside>
</div>
}

<!-- ══════════════════════════════════════════════════════
     ESTILOS
══════════════════════════════════════════════════════ -->
<style>
    :root {
        --cyan: #00f2ff;
        --cyan-bright: #40f8ff;
        --cyan-glow: rgba(0,242,255,0.22);
        --bg-dark: #080808;
        --bg-card: #111111;
        --bg-card2: #161616;
        --border: rgba(255,255,255,0.07);
        --border-hover: rgba(0,242,255,0.4);
        --text: #f0f0f0;
        --text-dim: #999;
        --radius: 16px;
        --radius-sm: 10px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    button { border: none; cursor: pointer; font-family: inherit; }
    a { text-decoration: none; }

    /* ── LOADING ── */
    .dv-loading {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        height: 60vh; gap: 20px; color: var(--text-dim);
    }
    .dv-spinner {
        width: 40px; height: 40px;
        border: 3px solid rgba(0,242,255,0.15);
        border-top-color: var(--cyan);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }
    @@keyframes scanMove { 0% { top: -2px; } 100% { top: 100%; } }
    @@keyframes barFill { from { width: 0 !important; } }
    @@keyframes commentSlide {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes successFade {
        0%   { opacity: 0; transform: translateY(6px); }
        15%  { opacity: 1; transform: translateY(0); }
        80%  { opacity: 1; }
        100% { opacity: 0; }
    }

    /* ── HERO ── */
    .dv-hero {
        position: relative;
        height: 70vh;
        min-height: 480px;
        overflow: hidden;
        z-index: 0;
    }
    .dv-hero-img-wrap { position: absolute; inset: 0; }
    .dv-hero-img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
    .dv-hero-overlay {
        position: absolute; inset: 0;
        background: linear-gradient(
            to right,
            rgba(0,0,0,0.92) 0%,
            rgba(0,0,0,0.65) 50%,
            rgba(0,0,0,0.3) 100%
        );
        z-index: 1;
    }
    .dv-scan-line {
        position: absolute; left: 0; right: 0; height: 2px;
        background: linear-gradient(90deg, transparent, var(--cyan), transparent);
        opacity: 0.2; z-index: 2;
        animation: scanMove 7s linear infinite;
    }
    .dv-hero-content {
        position: absolute; inset: 0; z-index: 3;
        display: flex; flex-direction: column; justify-content: flex-end;
        padding: 40px 60px 60px;
        max-width: 700px;
    }
    .dv-back-btn {
        display: inline-flex; align-items: center; gap: 8px;
        color: rgba(255,255,255,0.6); font-size: 0.82rem; font-weight: 600;
        margin-bottom: 32px;
        transition: color 0.2s;
    }
    .dv-back-btn:hover { color: var(--cyan); }
    .dv-hero-meta { display: flex; gap: 10px; margin-bottom: 14px; }
    .dv-badge-fuel, .dv-badge-score {
        font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em;
        text-transform: uppercase; padding: 5px 12px; border-radius: 100px;
    }
    .dv-badge-fuel {
        background: rgba(0,242,255,0.12); color: var(--cyan-bright);
        border: 1px solid rgba(0,242,255,0.35);
    }
    .dv-badge-score {
        background: rgba(255,255,255,0.08); color: #fff;
        border: 1px solid rgba(255,255,255,0.2);
    }
    .dv-hero-title {
        font-size: clamp(2rem, 4.5vw, 3.4rem);
        font-weight: 800; color: #fff; letter-spacing: -0.02em; line-height: 1.1;
        margin-bottom: 24px;
    }
    .dv-hero-quick {
        display: flex; align-items: center; gap: 24px; margin-bottom: 28px;
    }
    .dv-quick-item { display: flex; flex-direction: column; gap: 2px; }
    .dv-quick-value { font-size: 1.3rem; font-weight: 800; color: #fff; }
    .dv-quick-label { font-size: 0.7rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.06em; }
    .dv-quick-sep { width: 1px; height: 36px; background: rgba(255,255,255,0.15); }
    .dv-hero-price { display: flex; flex-direction: column; gap: 2px; }
    .dv-price-label { font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.08em; }
    .dv-price-value { font-size: 1.6rem; font-weight: 800; color: var(--cyan); letter-spacing: -0.01em; }

    /* ── BODY LAYOUT ── */
    .dv-body {
        background: var(--bg-dark);
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 40px;
        max-width: 1480px;
        margin: 0 auto;
        padding: 48px 32px 100px;
        align-items: start;
    }

    /* ── SECTIONS ── */
    .dv-section { margin-bottom: 48px; }
    .dv-section-title {
        display: flex; align-items: center; gap: 14px;
        font-size: 1.1rem; font-weight: 700; color: #fff;
        margin-bottom: 24px; letter-spacing: -0.01em;
    }
    .dv-title-line {
        display: inline-block; width: 4px; height: 22px;
        background: var(--cyan); border-radius: 2px;
        box-shadow: 0 0 10px var(--cyan-glow);
    }
    .dv-comment-count { color: var(--text-dim); font-weight: 500; font-size: 0.9rem; }

    /* ── GALERIA ── */
    .dv-gallery { display: flex; gap: 12px; flex-wrap: wrap; }
    .dv-thumb {
        width: calc(25% - 9px); aspect-ratio: 4/3;
        border-radius: var(--radius-sm); overflow: hidden;
        position: relative; cursor: pointer;
        border: 2px solid transparent;
        transition: border-color 0.2s, transform 0.2s;
    }
    .dv-thumb:hover { transform: translateY(-3px); }
    .dv-thumb.active { border-color: var(--cyan); box-shadow: 0 0 16px var(--cyan-glow); }
    .dv-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .dv-thumb-overlay {
        position: absolute; inset: 0;
        background: rgba(0,242,255,0.0);
        transition: background 0.2s;
    }
    .dv-thumb:hover .dv-thumb-overlay { background: rgba(0,242,255,0.08); }

    /* ── SPECS ── */
    .dv-specs-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
    }
    .dv-spec-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 18px;
        display: flex; gap: 14px; align-items: flex-start;
        transition: border-color 0.25s, box-shadow 0.25s;
    }
    .dv-spec-card:hover {
        border-color: var(--border-hover);
