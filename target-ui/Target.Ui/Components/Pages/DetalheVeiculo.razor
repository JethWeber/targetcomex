        await LoadVeiculoAsync();
        await LoadAvaliacoesAsync();
        await RegistrarHistoricoAsync();
        isLoading = false;
    }

    async Task LoadVeiculoAsync()
    {
        var result = await Api.GetVeiculoAsync(VeiculoId);
        if (!result.Success || result.Data == null)
        {
            apiError = "Não foi possível carregar os detalhes do veículo.";
            veiculo = null;
            return;
        }

        veiculo = MapVeiculo(result.Data);
        matchScore = null;
        isRecommended = false;

        await AuthService.InitAsync();
        isAuthenticated = await AuthService.IsAuthenticatedAsync();

        var allResult = await Api.GetVeiculosAsync();
        todos = allResult.Success && allResult.Data != null ? allResult.Data.Select(MapVeiculo).ToList() : new List<Veiculo>();
        outrosVeiculos = todos.Where(v => v.Id != veiculo.Id).OrderByDescending(v => v.ScoreIA).ToList();

        fotos = new List<string>
        {
            veiculo.Imagem,
            outrosVeiculos.ElementAtOrDefault(0)?.Imagem ?? veiculo.Imagem,
            outrosVeiculos.ElementAtOrDefault(1)?.Imagem ?? veiculo.Imagem,
            outrosVeiculos.ElementAtOrDefault(2)?.Imagem ?? veiculo.Imagem,
            outrosVeiculos.ElementAtOrDefault(3)?.Imagem ?? veiculo.Imagem,
        };
        fotoPrincipal = fotos[0];

        // Carregar nome do utilizador autenticado
        var userId = await AuthService.GetUserIdAsync();
        if (userId != null)
        {
            var userResult = await Api.GetUsuarioAsync(userId.Value);
            if (userResult.Success && userResult.Data != null)
                nomeUsuario = userResult.Data.Nome;

            var recResult = await Api.GetRecomendacoesAsync(userId.Value);
            if (recResult.Success && recResult.Data != null)
            {
                var match = recResult.Data.FirstOrDefault(r => r.VeiculoId == VeiculoId);
                if (match != null)
                {
                    matchScore = match.Score;
                    isRecommended = true;
                }
            }

            // Verificar se já tem reserva para este veículo
            var reservasResult = await Api.GetReservasAsync();
            if (reservasResult.Success)
                jaReservado = reservasResult.Data!.Any(r => r.VeiculoId == veiculo!.Id && r.UsuarioId == userId.Value);
        }
    }

    // Método para reservar o veículo
    async Task ReservarVeiculo()
    {
        if (veiculo == null || jaReservado || isReservando) return;

        var userId = await AuthService.GetUserIdAsync();
        if (userId == null) return;

        isReservando = true;
        StateHasChanged();

        var request = new ReservaRequest
        {
            UsuarioId  = userId.Value,
            VeiculoId  = veiculo.Id,
            TipoPedido = "Online",
            Showroom   = veiculo.Localizacao
        };

        var result = await Api.CriarReservaAsync(request);
        jaReservado  = result.Success;
        isReservando = false;
        StateHasChanged();
    }
    static Veiculo MapVeiculo(VeiculoDto v)
        => new(
            v.Id,
            $"{v.Marca} {v.Modelo}",
            v.Marca,
            v.Combustivel ?? "N/A",
            v.Transmissao ?? "N/A",
            v.Motor ?? "N/A",
            v.Potencia ?? 0,
            v.Ano,
            (long)Math.Round(v.Preco),
            v.Disponivel ? 94 : 78,
            v.Localizacao ?? "Localização não disponível",
            v.ImagemUrl ?? "img/cars/default.jpg"
        );

    async Task LoadAvaliacoesAsync()
    {
        if (veiculo == null)
        {
            comentarios = new();
            return;
        }

        var result = await Api.GetAvaliacoesPorVeiculoAsync(veiculo.Id);
        comentarios = result.Success && result.Data != null
            ? result.Data.Select(MapComentario).ToList()
            : new List<Comentario>();
    }

    static Comentario MapComentario(AvaliacaoDto dto)
        => new(
            $"Cliente #{dto.UsuarioId}",
            dto.Comentario ?? "Comentário não disponível.",
            dto.Nota,
            dto.DataAvaliacao.ToLocalTime()
        );

    async Task RegistrarHistoricoAsync()
    {
        if (veiculo == null)
            return;

        var userId = await AuthService.GetUserIdAsync();
        if (userId == null)
            return;

        await Api.RegistrarHistoricoNavegacaoAsync(userId.Value, veiculo.Id);
    }

    // ── Métodos do Popup ────────────────────────────────
    void AbrirPopup(string imagem)
    {
        imagemPopup = imagem;
        indiceAtual = fotos.IndexOf(imagem);
        mostrarPopup = true;
    }

    void FecharPopup()
    {
        mostrarPopup = false;
        imagemPopup = "";
        indiceAtual = 0;
    }

    void ProximaFoto()
    {
        if (indiceAtual < fotos.Count - 1)
        {
            indiceAtual++;
            imagemPopup = fotos[indiceAtual];
            fotoPrincipal = fotos[indiceAtual];
        }
    }

    async Task SubmeterComentario()
    {
        if (!PodeSubmeter || veiculo == null) return;

        var userId = await AuthService.GetUserIdAsync();
        var request = new AvaliacaoCreateRequest
        {
            VeiculoId = veiculo.Id,
            UsuarioId = userId ?? 0,
            Nota = novaAvaliacao,
            Comentario = novoTexto.Trim()
        };

        if (userId != null)
        {
            var result = await Api.CriarAvaliacaoAsync(request);
            if (result.Success && result.Data != null)
            {
                comentarios.Insert(0, new Comentario(novoAutor.Trim(), novoTexto.Trim(), novaAvaliacao, DateTime.Now, true));
            }
            else
            {
                comentarios.Insert(0, new Comentario("Cliente", novoTexto.Trim(), novaAvaliacao, DateTime.Now, true));
            }
        }
        else
        {
            comentarios.Insert(0, new Comentario("Cliente Anônimo", novoTexto.Trim(), novaAvaliacao, DateTime.Now, true));
        }

        novoAutor = "";
        novoTexto = "";
        novaAvaliacao = 0;
        mostrarSucesso = true;

        await Task.Delay(3200);
        mostrarSucesso = false;
    }

    void FotoAnterior()
    {
        if (indiceAtual > 0)
        {
            indiceAtual--;
            imagemPopup = fotos[indiceAtual];
            fotoPrincipal = fotos[indiceAtual];
        }
    }

    void SelecionarFoto(int indice)
    {
        indiceAtual = indice;
        imagemPopup = fotos[indice];
        fotoPrincipal = fotos[indice];
    }
}
