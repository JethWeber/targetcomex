<!-- ════════════════════════════════════════════════════════
  ██  ESTILOS
  Psicologia das cores:
    Ciano   → tecnologia, confiança, inovação, velocidade
    Preto   → luxo, exclusividade, autoridade, premium
    Branco  → clareza, limpeza, credibilidade
    Dourado (badge) → prestígio, melhor escolha (trigger de decisão)
    Flash magenta   → excitação subliminar no glitch do título
════════════════════════════════════════════════════════ -->
<style>
:root {
    --c:       #00f2ff;          /* ciano principal */
    --c-dim:   rgba(0,242,255,.13);
    --c-glow:  rgba(0,242,255,.28);
    --bg:      #060609;
    --bg-card: #0d0d12;
    --bg-svc:  #0a0a0f;
    --brd:     rgba(255,255,255,.07);
    --brd-a:   rgba(0,242,255,.4);
    --txt:     #e6e6f0;
    --txt-dim: #686882;
    --r:       14px;
    --rs:      8px;
    --ease:    cubic-bezier(.4,0,.2,1);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
button{border:none;cursor:pointer;font-family:inherit;}
a{text-decoration:none;color:inherit;}

/* ── Keyframes ─────────────────────────────────────── */
@@keyframes h-up    {from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}
@@keyframes h-fade  {from{opacity:0}to{opacity:1}}
@@keyframes h-slr   {from{opacity:0;transform:translateX(-28px)}to{opacity:1;transform:none}}
@@keyframes h-sll   {from{opacity:0;transform:translateX(28px)}to{opacity:1;transform:none}}
@@keyframes h-slu   {from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
@@keyframes h-scan  {from{top:-2px}to{top:100%}}
@@keyframes h-pulse {0%,100%{opacity:1}50%{opacity:.25}}
@@keyframes h-tick  {from{transform:translateX(0)}to{transform:translateX(-50%)}}
@@keyframes h-float {0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
@@keyframes h-orbit1{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
@@keyframes h-orbit2{from{transform:rotate(0deg)}to{transform:rotate(-360deg)}}
@@keyframes h-card  {from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
@@keyframes h-barfill{from{transform:scaleX(0)}to{transform:scaleX(1)}}
@@keyframes h-ring  {from{stroke-dashoffset:327}to{stroke-dashoffset:33}}

/* Glitch — estética futurista + excitação subliminar (magenta) */
@@keyframes h-gl1{
    0%,100%{clip-path:inset(0 0 92% 0);transform:translate(-3px,0);color:var(--c)}
    20%{clip-path:inset(20% 0 60% 0);transform:translate(3px,0)}
    40%{clip-path:inset(58% 0 22% 0);transform:translate(-2px,0)}
    60%{clip-path:inset(78% 0 7%  0);transform:translate(2px,0)}
    80%{clip-path:inset(8%  0 75% 0);transform:translate(-3px,0)}
}
@@keyframes h-gl2{
    0%,100%{clip-path:inset(44% 0 36% 0);transform:translate(3px,0);color:#ff2060}
    25%{clip-path:inset(10% 0 76% 0);transform:translate(-3px,0)}
    50%{clip-path:inset(68% 0 14% 0);transform:translate(2px,0);color:var(--c)}
    75%{clip-path:inset(4%  0 90% 0);transform:translate(-2px,0)}
}

/* ── Utilitários de animação ────────────────────────── */
.h-anim-up        {opacity:0;animation:h-up   .7s cubic-bezier(.22,1,.36,1) forwards;animation-delay:var(--d,0s);}
.h-anim-fade      {opacity:0;animation:h-fade  .9s ease forwards;animation-delay:var(--d,0s);}
.h-anim-sl-right  {opacity:0;animation:h-slr  .6s cubic-bezier(.22,1,.36,1) forwards;animation-delay:var(--d,0s);}
.h-anim-sl-left   {opacity:0;animation:h-sll  .6s cubic-bezier(.22,1,.36,1) forwards;animation-delay:var(--d,0s);}
.h-anim-sl-up     {opacity:0;animation:h-slu  .6s cubic-bezier(.22,1,.36,1) forwards;animation-delay:var(--d,0s);}
.h-anim-reveal    {opacity:0;transform:translateY(20px);}
.h-anim-reveal.visible{animation:h-card .55s cubic-bezier(.22,1,.36,1) var(--d,0s) both;}
.h-cyan           {color:var(--c);}

/* ════════════════════════════════════════════════════
   HERO
════════════════════════════════════════════════════ */
.h-hero {
    position:relative;min-height:100svh;
    display:flex;align-items:center;
    padding:100px 48px 60px;
    background:var(--bg);
    overflow:hidden;isolation:isolate;
}
/* Fundo — grid de pontos */
.h-hero-grid {
    position:absolute;inset:0;z-index:1;pointer-events:none;
    background-image:
        linear-gradient(rgba(0,242,255,.045) 1px,transparent 1px),
        linear-gradient(90deg,rgba(0,242,255,.045) 1px,transparent 1px);
    background-size:50px 50px;
}
/* Brilhos radiais (foco visual nos pontos certos — UX) */
.h-hero-glow {
    position:absolute;border-radius:50%;
    pointer-events:none;z-index:2;filter:blur(80px);
}
.h-glow-a {
    width:600px;height:600px;right:-100px;top:-80px;
    background:radial-gradient(circle,rgba(0,242,255,.12) 0%,transparent 70%);
}
.h-glow-b {
    width:400px;height:400px;left:30%;bottom:-50px;
    background:radial-gradient(circle,rgba(0,60,255,.08) 0%,transparent 70%);
}
/* Linha de scan */
.h-scan {
    position:absolute;left:0;right:0;top:-2px;height:2px;z-index:3;pointer-events:none;
    background:linear-gradient(90deg,transparent,var(--c),transparent);
    opacity:.14;animation:h-scan 9s linear infinite;
}
/* Partículas */
.h-particles{position:absolute;inset:0;z-index:2;pointer-events:none;}
.h-p{position:absolute;border-radius:50%;background:var(--c);opacity:.35;}
.h-p1{width:3px;height:3px;top:15%;left:12%;animation:h-float 6s ease-in-out infinite;}
.h-p2{width:2px;height:2px;top:40%;left:5%; animation:h-float 8s ease-in-out .5s infinite;}
.h-p3{width:4px;height:4px;top:65%;left:18%;animation:h-float 7s ease-in-out 1s infinite;}
.h-p4{width:2px;height:2px;top:20%;right:15%;animation:h-float 9s ease-in-out .3s infinite;}
.h-p5{width:3px;height:3px;top:75%;right:20%;animation:h-float 6.5s ease-in-out .8s infinite;}
.h-p6{width:2px;height:2px;top:50%;right:8%; animation:h-float 7.5s ease-in-out 1.5s infinite;}

/* Layout hero — duas colunas */
.h-hero-inner {
    position:relative;z-index:5;
    width:100%;max-width:1400px;margin:0 auto;
    display:grid;grid-template-columns:1fr 1fr;
    gap:40px;align-items:center;
}

/* ── Texto ── */
.h-hero-text{max-width:640px;}

.h-badge {
    display:inline-flex;align-items:center;gap:9px;
    background:rgba(0,242,255,.08);border:1px solid rgba(0,242,255,.26);
    color:var(--c);font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
    padding:7px 18px;border-radius:100px;margin-bottom:28px;
}
.h-badge-dot {
    width:7px;height:7px;border-radius:50%;background:var(--c);
    animation:h-pulse 1.8s ease-in-out infinite;flex-shrink:0;
}

/* Título — hierarquia de 3 linhas (UX: F-pattern scanning) */
.h-title{display:flex;flex-direction:column;line-height:.98;margin-bottom:22px;}
.h-t-sub {
    font-size:clamp(.9rem,1.9vw,1.45rem);
    font-weight:400;letter-spacing:.38em;text-transform:uppercase;
    color:var(--txt-dim);margin-bottom:4px;
}
.h-t-main {
    font-size:clamp(3.2rem,8vw,7.2rem);
    font-weight:900;letter-spacing:-.02em;text-transform:uppercase;
    color:#fff;position:relative;display:inline-block;
}
.h-t-main::before,.h-t-main::after{
    content:attr(data-text);position:absolute;left:0;top:0;
    width:100%;height:100%;font-weight:900;pointer-events:none;
}
.h-t-main::before{animation:h-gl1 4.5s steps(1) infinite;}
.h-t-main::after {animation:h-gl2 4.5s steps(1) infinite;animation-delay:.18s;}
.h-glitch{}/* marcador */
.h-t-foot {
    font-size:clamp(1.1rem,2.6vw,2rem);
    font-weight:700;letter-spacing:.12em;text-transform:uppercase;
    color:rgba(255,255,255,.8);margin-top:4px;
}

.h-subtitle {
    font-size:.98rem;color:var(--txt-dim);line-height:1.75;
    max-width:520px;margin-bottom:34px;
}

/* ── Abas + search ── */
.h-tabs{display:flex;gap:4px;margin-bottom:12px;}
.h-tab{
    display:flex;align-items:center;gap:7px;
    background:rgba(255,255,255,.05);color:var(--txt-dim);
    border:1px solid var(--brd);padding:9px 18px;border-radius:8px;
    font-size:.82rem;font-weight:500;transition:all .2s var(--ease);
}
.h-tab:hover{color:var(--c);border-color:var(--brd-a);}
.h-tab.h-tab-on{background:var(--c-dim);border-color:var(--brd-a);color:#fff;font-weight:700;}

.h-searchbox{
    display:flex;align-items:center;gap:10px;
    background:rgba(255,255,255,.97);
    border:2px solid #e0e0e0;border-radius:var(--r);
    padding:8px 8px 8px 18px;
    box-shadow:0 20px 60px rgba(0,0,0,.55),0 0 0 1px rgba(0,242,255,.07);
    transition:border-color .2s var(--ease);margin-bottom:10px;
}
.h-searchbox:focus-within{border-color:var(--c);}
.h-search-ico{flex-shrink:0;}
.h-search-inp{
    flex:1;border:none;background:transparent;
    color:#111;font-size:.94rem;font-weight:500;outline:none;
}
.h-search-inp::placeholder{color:#aaa;}
.h-search-btn{
    display:flex;align-items:center;gap:7px;
    background:var(--c);color:#000;
    font-size:.86rem;font-weight:800;letter-spacing:.04em;
    padding:12px 22px;border-radius:var(--rs);
    white-space:nowrap;transition:all .2s var(--ease);
}
.h-search-btn:hover{background:#1af6ff;transform:translateY(-2px);box-shadow:0 6px 22px rgba(0,242,255,.4);}
.h-search-hint{font-size:.78rem;color:var(--txt-dim);}
.h-hint-dot{
    display:inline-block;width:6px;height:6px;border-radius:50%;
    background:var(--c);margin-right:6px;vertical-align:middle;
    animation:h-pulse 2s ease-in-out infinite;
}

/* Mini stats abaixo da search */
.h-mini-stats{
    display:flex;align-items:center;gap:20px;
    margin-top:22px;padding-top:22px;
    border-top:1px solid var(--brd);
}
.h-mstat{display:flex;flex-direction:column;gap:2px;}
.h-mstat strong{font-size:1.4rem;font-weight:900;color:#fff;line-height:1;}
.h-mstat span{font-size:.68rem;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--txt-dim);}
.h-mstat-sep{width:1px;height:30px;background:var(--brd);}

/* ── Carro + HUD ── */
.h-hero-car{
    position:relative;
    display:flex;align-items:center;justify-content:center;
}
.h-orbit{
    position:absolute;border-radius:50%;border:1px solid rgba(0,242,255,.1);
    pointer-events:none;
}
.h-orbit-1{width:420px;height:420px;animation:h-orbit1 18s linear infinite;}
.h-orbit-2{width:310px;height:310px;border-color:rgba(0,242,255,.07);animation:h-orbit2 14s linear infinite;}
.h-car-shadow{
    position:absolute;bottom:-5%;left:10%;right:10%;height:40px;
    background:radial-gradient(ellipse,rgba(0,242,255,.22) 0%,transparent 70%);
    filter:blur(14px);pointer-events:none;
}
.h-car-glow{
    position:absolute;inset:10%;
    background:radial-gradient(ellipse,rgba(0,242,255,.07) 0%,transparent 65%);
    pointer-events:none;filter:blur(30px);
}
.h-car-img{
    width:100%;max-width:580px;position:relative;z-index:2;
    animation:h-float 5s ease-in-out infinite;
    filter:drop-shadow(0 20px 40px rgba(0,242,255,.18));
}
/* HUD Badges */
.h-hud{
    position:absolute;z-index:4;
    display:flex;align-items:center;gap:10px;
    background:rgba(10,10,18,.88);backdrop-filter:blur(10px);
    border:1px solid var(--brd-a);border-radius:12px;
    padding:10px 14px;
    box-shadow:0 8px 28px rgba(0,0,0,.5),0 0 0 1px rgba(0,242,255,.08);
}
.h-hud-ico{font-size:1.3rem;}
.h-hud-lbl{font-size:.65rem;color:var(--txt-dim);text-transform:uppercase;letter-spacing:.07em;}
.h-hud-val{font-size:.95rem;font-weight:800;color:#fff;}
.h-hud-tl{top:14%;left:-5%;}
.h-hud-tr{top:14%;right:-5%;}
.h-hud-bot{bottom:10%;left:50%;transform:translateX(-50%);}

/* Scroll cue */
.h-scroll-cue{
    position:absolute;bottom:28px;left:50%;transform:translateX(-50%);z-index:5;
    display:flex;flex-direction:column;align-items:center;gap:8px;
    color:var(--txt-dim);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;
}
.h-scroll-mouse{
    width:22px;height:34px;border:1.5px solid rgba(255,255,255,.25);
    border-radius:11px;display:flex;justify-content:center;padding-top:5px;
}
.h-scroll-wheel{
    width:3px;height:7px;background:var(--c);border-radius:2px;
    animation:h-slu 1.4s ease-in-out infinite;opacity:.7;
}

/* ════════════════════════════════════════════════════
   BRANDS TICKER
════════════════════════════════════════════════════ */
.h-brands-strip{
    background:var(--bg-card);border-top:1px solid var(--brd);
    border-bottom:1px solid var(--brd);padding:18px 0;overflow:hidden;
}
.h-brands-eyebrow{
    text-align:center;font-size:.65rem;font-weight:700;
    letter-spacing:.14em;text-transform:uppercase;
    color:var(--txt-dim);margin-bottom:14px;
}
.h-ticker-mask{overflow:hidden;position:relative;}
/* Efeito fade nas bordas */
.h-ticker-mask::before,.h-ticker-mask::after{
    content:'';position:absolute;top:0;bottom:0;width:120px;z-index:2;pointer-events:none;
}
.h-ticker-mask::before{left:0;background:linear-gradient(to right,var(--bg-card),transparent);}
.h-ticker-mask::after {right:0;background:linear-gradient(to left,var(--bg-card),transparent);}
.h-ticker{
    display:flex;gap:0;white-space:nowrap;
    animation:h-tick 30s linear infinite;
    width:max-content;
}
.h-tick-item{
    font-size:.82rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
    color:var(--txt-dim);padding:0 14px;transition:color .2s;
}
.h-tick-item:hover{color:var(--c);}
.h-tick-dot{color:rgba(0,242,255,.35);font-size:.5rem;vertical-align:middle;padding:0 2px;}

/* ════════════════════════════════════════════════════
   STATS BAR
════════════════════════════════════════════════════ */
.h-stats-bar{
    background:linear-gradient(135deg,#08080d 0%,#0d0d18 50%,#08080d 100%);
    border-bottom:1px solid var(--brd);padding:44px 24px;
}
.h-stats-inner{
    max-width:1100px;margin:0 auto;
    display:flex;align-items:center;justify-content:center;
    gap:40px;flex-wrap:wrap;
}
.h-stat-item{text-align:center;display:flex;flex-direction:column;align-items:center;gap:4px;}
.h-stat-num{font-size:2.6rem;font-weight:900;color:#fff;line-height:1;font-variant-numeric:tabular-nums;}
.h-stat-plus{font-size:1.4rem;font-weight:900;color:var(--c);line-height:1;}
.h-stat-lbl{font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.09em;color:var(--txt-dim);margin-top:2px;}
.h-stat-sep{width:1px;height:50px;background:var(--brd);}
/* número + plus inline */
.h-stat-item{display:flex;flex-direction:column;align-items:center;}
.h-stat-item > span:nth-child(1),
.h-stat-item > span:nth-child(2){display:inline;}
.h-stat-item{flex-direction:row;flex-wrap:wrap;justify-content:center;align-items:baseline;gap:0 4px;}
.h-stat-num,.h-stat-plus{display:inline;}
.h-stat-lbl{width:100%;text-align:center;flex-basis:100%;}

/* ════════════════════════════════════════════════════
   SECTIONS — estilos base
════════════════════════════════════════════════════ */
.h-section{padding:90px 24px;background:var(--bg);max-width:100%;overflow:hidden;}
.h-section-head{text-align:center;margin-bottom:60px;position:relative;}
.h-eyebrow{
    display:inline-block;
    font-size:.7rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
    color:var(--c);background:var(--c-dim);border:1px solid rgba(0,242,255,.25);
    padding:6px 16px;border-radius:100px;margin-bottom:16px;
}
.h-eyebrow-light{color:#fff;background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.18);}
.h-section-title{
    font-size:clamp(1.9rem,4vw,3rem);font-weight:800;
    color:#fff;line-height:1.2;margin-bottom:16px;
}
.h-section-desc{font-size:.95rem;color:var(--txt-dim);max-width:600px;margin:0 auto;line-height:1.75;}
.h-see-all{
    position:absolute;right:0;top:50%;transform:translateY(-50%);
    font-size:.84rem;font-weight:600;color:var(--c);
    border-bottom:1px solid rgba(0,242,255,.3);padding-bottom:2px;
    transition:color .2s;white-space:nowrap;
}
.h-see-all:hover{color:#fff;}

/* ════════════════════════════════════════════════════
   FEATURES
════════════════════════════════════════════════════ */
.h-features-sec{background:#060609;}
.h-feats-grid{
    display:grid;grid-template-columns:repeat(3,1fr);
    gap:22px;max-width:1200px;margin:0 auto;
}
.h-feat{
    background:var(--bg-card);border:1px solid var(--brd);
    border-radius:var(--r);padding:28px;position:relative;overflow:hidden;
    transition:border-color .25s var(--ease),box-shadow .25s var(--ease),transform .25s var(--ease);
}
.h-feat:hover{
    border-color:rgba(0,242,255,.22);
    box-shadow:0 16px 48px rgba(0,0,0,.5),0 0 24px rgba(0,242,255,.1);
    transform:translateY(-4px);
}
/* Card destaque — brilho de borda animado */
.h-feat.h-feat-hl{border-color:rgba(0,242,255,.2);}
.h-feat-glow-border{
    position:absolute;inset:-1px;border-radius:calc(var(--r) + 1px);
    background:conic-gradient(from 0deg,var(--c),transparent 40%,var(--c) 60%,transparent);
    z-index:0;opacity:.15;pointer-events:none;
    animation:h-orbit1 6s linear infinite;
}
.h-feat > *{position:relative;z-index:1;}
.h-feat-new{
    position:absolute;top:16px;right:16px;z-index:2;
    background:var(--c);color:#000;
    font-size:.6rem;font-weight:900;letter-spacing:.1em;
    padding:3px 10px;border-radius:100px;
}
.h-feat-icon-wrap{
    width:54px;height:54px;border-radius:var(--rs);
    background:var(--c-dim);border:1px solid rgba(0,242,255,.2);
    display:grid;place-items:center;margin-bottom:18px;
}
.h-feat-title{font-size:1.02rem;font-weight:700;color:#fff;margin-bottom:10px;}
.h-feat-desc{font-size:.84rem;color:var(--txt-dim);line-height:1.7;margin-bottom:16px;}
.h-feat-link{font-size:.8rem;font-weight:600;color:var(--txt-dim);transition:color .2s;}
.h-feat-link:hover,.h-feat-link.h-cyan{color:var(--c);}

/* ════════════════════════════════════════════════════
   CARS GRID
════════════════════════════════════════════════════ */
.h-cars-sec{background:linear-gradient(to bottom,#060609,#09090f);}
.h-cars-grid{
    display:grid;grid-template-columns:repeat(4,1fr);
    gap:20px;max-width:1320px;margin:0 auto 40px;
}
.h-car-card{
    background:var(--bg-card);border:1px solid var(--brd);border-radius:var(--r);
    overflow:hidden;transition:border-color .25s var(--ease),box-shadow .25s var(--ease),transform .25s var(--ease);
}
.h-car-card:hover{
    border-color:var(--brd-a);
    box-shadow:0 0 0 1px rgba(0,242,255,.08),0 18px 50px rgba(0,0,0,.65),0 0 28px var(--c-glow);
    transform:translateY(-5px);
}
.h-car-hl{border-color:rgba(0,242,255,.2);}
.h-cc-hl-border{
    position:absolute;inset:0;border-radius:var(--r);
    background:radial-gradient(ellipse at top,rgba(0,242,255,.07) 0%,transparent 60%);
    pointer-events:none;
}
.h-cc-media{position:relative;overflow:hidden;height:182px;background:#08080f;}
.h-cc-img{width:100%;height:100%;object-fit:cover;transition:transform .6s var(--ease);}
.h-car-card:hover .h-cc-img{transform:scale(1.07);}
.h-cc-badge{
    position:absolute;top:10px;left:10px;
    background:rgba(0,0,0,.72);backdrop-filter:blur(6px);
    color:var(--c);font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em;
    padding:3px 10px;border-radius:100px;border:1px solid rgba(0,242,255,.3);
}
.h-badge-gold{color:#ffc800;border-color:rgba(255,200,0,.4);}
.h-cc-fav{
    position:absolute;top:10px;right:10px;
    background:rgba(0,0,0,.65);backdrop-filter:blur(6px);
    width:32px;height:32px;border-radius:50%;
    display:grid;place-items:center;
    border:1px solid rgba(255,255,255,.15);transition:all .2s var(--ease);
}
.h-cc-fav:hover,.h-fav-on{background:rgba(0,242,255,.18);border-color:var(--c);}
.h-cc-ia{
    position:absolute;bottom:10px;right:10px;
    background:rgba(0,242,255,.12);backdrop-filter:blur(6px);
    color:var(--c);font-size:.68rem;font-weight:700;
    padding:3px 9px;border-radius:100px;border:1px solid rgba(0,242,255,.25);
}
.h-cc-body{padding:16px 16px 18px;}
.h-cc-meta{display:flex;gap:7px;margin-bottom:5px;}
.h-cc-meta span{
    font-size:.65rem;color:var(--txt-dim);background:rgba(255,255,255,.05);
    padding:3px 8px;border-radius:5px;text-transform:uppercase;letter-spacing:.04em;
}
.h-cc-name{font-size:.98rem;font-weight:700;color:#fff;line-height:1.3;margin-bottom:9px;}
.h-cc-specs{display:flex;flex-wrap:wrap;gap:4px 12px;margin-bottom:14px;}
.h-cc-specs span{font-size:.75rem;color:#555;}
.h-cc-foot{display:flex;justify-content:space-between;align-items:center;}
.h-cc-price{font-size:.88rem;font-weight:800;color:var(--c);font-family:monospace;letter-spacing:.02em;}
.h-cc-old{font-size:.75rem;color:var(--txt-dim);text-decoration:line-through;margin-left:6px;}
.h-cc-btn{
    background:transparent;color:var(--c);
    border:1px solid rgba(0,242,255,.32);
    padding:7px 14px;border-radius:7px;font-size:.76rem;font-weight:600;
    transition:all .2s var(--ease);
}
.h-cc-btn:hover,.h-cc-btn-hl{background:var(--c);color:#000;border-color:var(--c);}
.h-cc-btn-hl:hover{background:#1af6ff;}
.h-cars-cta{text-align:center;}

/* ── Botões globais ── */
.h-btn-primary{
    display:inline-flex;align-items:center;gap:8px;
    background:var(--c);color:#000;
    font-size:.9rem;font-weight:800;letter-spacing:.04em;
    padding:14px 28px;border-radius:var(--rs);
    transition:all .22s var(--ease);white-space:nowrap;
}
.h-btn-primary:hover{background:#1af6ff;transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,242,255,.4);}
.h-btn-outline{
    display:inline-flex;align-items:center;gap:8px;
    background:transparent;color:var(--c);
    border:1.5px solid rgba(0,242,255,.45);
    font-size:.88rem;font-weight:700;
    padding:13px 26px;border-radius:var(--rs);
    transition:all .22s var(--ease);
}
.h-btn-outline:hover{background:var(--c-dim);border-color:var(--c);}
.h-btn-ghost{
    display:inline-flex;align-items:center;gap:8px;
    background:transparent;color:var(--txt-dim);
    border:1px solid var(--brd);
    font-size:.88rem;font-weight:600;
    padding:13px 24px;border-radius:var(--rs);
    transition:all .22s var(--ease);
}
.h-btn-ghost:hover{color:#fff;border-color:rgba(255,255,255,.25);}
.h-btn-ghost-light{
    display:inline-flex;align-items:center;gap:8px;
    background:rgba(255,255,255,.08);color:#fff;
    border:1px solid rgba(255,255,255,.2);
    font-size:.88rem;font-weight:600;
    padding:13px 24px;border-radius:var(--rs);
    transition:all .22s var(--ease);
}
.h-btn-ghost-light:hover{background:rgba(255,255,255,.15);}

/* ════════════════════════════════════════════════════
   SERVIÇOS BAND
════════════════════════════════════════════════════ */
.h-service-band{
    position:relative;overflow:hidden;
    padding:90px 24px;
}
.h-svc-bg{
    position:absolute;inset:0;
    background:linear-gradient(135deg,#07070c 0%,#0b0b16 60%,#050510 100%);
    z-index:0;
}
.h-svc-grid{
    position:absolute;inset:0;z-index:1;pointer-events:none;
    background-image:
        linear-gradient(rgba(0,242,255,.035) 1px,transparent 1px),
        linear-gradient(90deg,rgba(0,242,255,.035) 1px,transparent 1px);
    background-size:48px 48px;
}
.h-svc-inner{
    position:relative;z-index:2;
    max-width:1200px;margin:0 auto;
    display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;
}
.h-svc-title{
    font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:800;
    color:#fff;line-height:1.15;margin:16px 0 18px;
}
.h-svc-desc{font-size:.92rem;color:var(--txt-dim);line-height:1.75;margin-bottom:26px;}
.h-svc-pills{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:30px;}
.h-svc-pill{
    background:rgba(255,255,255,.05);border:1px solid var(--brd);
    color:var(--txt-dim);font-size:.78rem;font-weight:500;
    padding:7px 14px;border-radius:100px;transition:all .2s var(--ease);
}
.h-svc-pill:hover{color:var(--c);border-color:rgba(0,242,255,.35);}
/* Cards de detalhe dos serviços */
.h-svc-cards{display:flex;flex-direction:column;gap:16px;}
.h-svc-card{
    background:rgba(255,255,255,.03);border:1px solid var(--brd);
    border-radius:var(--r);padding:18px 20px;
    display:flex;align-items:center;gap:16px;
    transition:all .22s var(--ease);
}
.h-svc-card:hover{
    border-color:rgba(0,242,255,.2);
    background:rgba(0,242,255,.04);
    transform:translateX(4px);
}
.h-svc-card-icon{
    width:46px;height:46px;flex-shrink:0;
    background:var(--c-dim);border:1px solid rgba(0,242,255,.2);border-radius:var(--rs);
    display:grid;place-items:center;
}
.h-svc-card-title{font-size:.9rem;font-weight:700;color:#fff;margin-bottom:3px;}
.h-svc-card-desc{font-size:.78rem;color:var(--txt-dim);line-height:1.5;}

/* ════════════════════════════════════════════════════
   IA SECTION
════════════════════════════════════════════════════ */
.h-ia-sec{
    position:relative;overflow:hidden;
    background:var(--bg);
}
.h-ia-bg-grid{
    position:absolute;inset:0;z-index:0;
    background-image:
        linear-gradient(rgba(0,242,255,.04) 1px,transparent 1px),
        linear-gradient(90deg,rgba(0,242,255,.04) 1px,transparent 1px);
    background-size:50px 50px;pointer-events:none;
}
.h-ia-bg-glow{
    position:absolute;right:-100px;top:50%;transform:translateY(-50%);
    width:600px;height:600px;border-radius:50%;
    background:radial-gradient(circle,rgba(0,242,255,.08) 0%,transparent 68%);
    pointer-events:none;filter:blur(40px);
}
.h-ia-inner{
    position:relative;z-index:1;
    max-width:1200px;margin:0 auto;
    display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;
}
.h-ia-desc{font-size:.92rem;color:var(--txt-dim);line-height:1.75;margin:18px 0 24px;}
.h-ia-feats{display:flex;flex-direction:column;gap:10px;margin-bottom:30px;}
.h-ia-feat{display:flex;align-items:center;gap:10px;font-size:.87rem;color:var(--txt);}
.h-ia-check{
    width:20px;height:20px;border-radius:50%;flex-shrink:0;
    background:var(--c-dim);border:1px solid rgba(0,242,255,.3);
    display:grid;place-items:center;font-size:.7rem;color:var(--c);font-weight:800;
}
.h-ia-actions{display:flex;gap:14px;flex-wrap:wrap;}
/* Mockup */
.h-ia-mockup-wrap{display:flex;justify-content:center;}
.h-ia-mockup{
    background:rgba(10,10,18,.95);border:1px solid rgba(0,242,255,.22);
    border-radius:20px;padding:28px;width:100%;max-width:340px;
    box-shadow:0 0 0 1px rgba(0,242,255,.05),0 30px 80px rgba(0,0,0,.7);
}
.h-ia-mockup-hdr{
    display:flex;align-items:center;gap:10px;
    margin-bottom:26px;padding-bottom:16px;border-bottom:1px solid var(--brd);
}
.h-ia-dot-pulse{
    width:9px;height:9px;border-radius:50%;background:var(--c);flex-shrink:0;
    animation:h-pulse 1.6s ease-in-out infinite;
}
.h-ia-mockup-lbl{font-size:.78rem;font-weight:600;color:#aaa;}
.h-ring-wrap{position:relative;width:140px;height:140px;margin:0 auto 26px;}
.h-ring-svg{width:100%;height:100%;}
.h-ring-progress{animation:h-ring 2s cubic-bezier(.4,0,.2,1) .5s both;}
.h-ring-inner{
    position:absolute;inset:0;display:flex;flex-direction:column;
    align-items:center;justify-content:center;
}
.h-ring-pct{font-size:2rem;font-weight:900;color:var(--c);line-height:1;}
.h-ring-sub{font-size:.7rem;color:var(--txt-dim);margin-top:4px;}
.h-ia-bars{display:flex;flex-direction:column;gap:12px;margin-bottom:20px;}
.h-ia-bar-row{display:flex;align-items:center;gap:10px;}
.h-ia-bar-lbl{font-size:.73rem;color:var(--txt-dim);width:80px;flex-shrink:0;}
.h-ia-bar-track{flex:1;height:5px;background:rgba(255,255,255,.07);border-radius:3px;overflow:hidden;}
.h-ia-bar{
    height:100%;background:linear-gradient(90deg,var(--c),#00a0b0);border-radius:3px;
    transform-origin:left;animation:h-barfill 1.4s cubic-bezier(.4,0,.2,1) .8s both;
}
.h-ia-bar-val{font-size:.73rem;color:#aaa;width:34px;text-align:right;}
.h-ia-mockup-ftr{
    border-top:1px solid var(--brd);padding-top:14px;
    font-size:.73rem;color:var(--txt-dim);text-align:center;
}

/* ════════════════════════════════════════════════════
   TESTEMUNHOS
════════════════════════════════════════════════════ */
.h-testi-sec{background:linear-gradient(to bottom,#09090f,#060609);}
.h-testi-grid{
    display:grid;grid-template-columns:repeat(3,1fr);gap:22px;
    max-width:1100px;margin:0 auto;
}
.h-testi{
    background:var(--bg-card);border:1px solid var(--brd);
    border-radius:var(--r);padding:28px;position:relative;overflow:hidden;
    transition:all .25s var(--ease);
}
.h-testi:hover{border-color:rgba(0,242,255,.18);transform:translateY(-4px);}
/* Aspas decorativas */
.h-testi::before{
    content:'"';position:absolute;top:10px;right:18px;
    font-size:5.5rem;color:rgba(0,242,255,.04);font-family:Georgia,serif;line-height:1;
}
.h-testi-stars{color:#ffc800;font-size:.88rem;letter-spacing:2px;margin-bottom:14px;}
.h-testi-text{
    font-size:.86rem;color:#bbb;line-height:1.8;margin-bottom:20px;font-style:italic;
}
.h-testi-author{display:flex;align-items:center;gap:12px;}
.h-testi-av{
    width:40px;height:40px;border-radius:50%;flex-shrink:0;
    background:var(--c-dim);border:1px solid rgba(0,242,255,.2);
    display:grid;place-items:center;font-size:.76rem;font-weight:700;color:var(--c);
}
.h-testi-name{font-size:.84rem;font-weight:600;color:#fff;}
.h-testi-city{font-size:.73rem;color:var(--txt-dim);}

/* ════════════════════════════════════════════════════
   SHOWROOM BAND — CTA final
   Imagem de fundo real + overlay dramático
════════════════════════════════════════════════════ */
.h-showroom-band{
    position:relative;overflow:hidden;
    padding:100px 24px;text-align:center;
}
.h-showroom-bg{
    position:absolute;inset:0;
    background:url('img/banner2.jpeg') center/cover no-repeat;
    z-index:0;transform:scale(1.03);
}
.h-showroom-overlay{
    position:absolute;inset:0;z-index:1;
    background:linear-gradient(
        135deg,
        rgba(0,0,0,.88) 0%,
        rgba(0,4,16,.80) 50%,
        rgba(0,0,0,.88) 100%
    );
}
.h-showroom-inner{
    position:relative;z-index:2;
    max-width:700px;margin:0 auto;
}
.h-showroom-title{
    font-size:clamp(2.2rem,5vw,4rem);font-weight:900;
    color:#fff;line-height:1.15;margin:14px 0 16px;
}
.h-showroom-desc{font-size:.96rem;color:rgba(255,255,255,.65);line-height:1.8;margin-bottom:36px;}
.h-showroom-actions{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;}



/* ════════════════════════════════════════════════════
   RESPONSIVE
════════════════════════════════════════════════════ */
@@media(max-width:1200px){
    .h-feats-grid{grid-template-columns:repeat(2,1fr);}
    .h-cars-grid{grid-template-columns:repeat(2,1fr);}
    .h-footer-top{grid-template-columns:1fr 1fr;gap:36px;}
}
@@media(max-width:1024px){
    .h-hero-inner{grid-template-columns:1fr;}
    .h-hero-car{display:none;}  /* esconde carro em tablet */
