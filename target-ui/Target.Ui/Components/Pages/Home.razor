<!-- ── JAVASCRIPT ─────────────────────────────────
     Apenas vanilla JS local, sem bibliotecas externas
──────────────────────────────────────────────── -->
<script>
(function () {
    // ── Scroll reveal ──────────────────────────────
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => {
            if (e.isIntersecting) {
                e.target.classList.add('visible');
            }
        });
    }, { threshold: 0.12 });

    document.querySelectorAll('.anim-reveal').forEach(el => observer.observe(el));

    // ── Contadores animados ────────────────────────
    function animateCounter(el, target) {
        let start = 0;
        const step = target / 80;
        const interval = setInterval(() => {
            start += step;
            if (start >= target) { el.textContent = target.toLocaleString('pt-PT'); clearInterval(interval); return; }
            el.textContent = Math.floor(start).toLocaleString('pt-PT');
        }, 18);
    }

    const statsObs = new IntersectionObserver((entries) => {
        entries.forEach(e => {
            if (e.isIntersecting) {
                const nums = e.target.querySelectorAll('[data-target]');
                nums.forEach(n => animateCounter(n, parseInt(n.dataset.target)));
                statsObs.unobserve(e.target);
            }
        });
    }, { threshold: 0.5 });

    const statsBar = document.querySelector('.stats-bar');
    if (statsBar) statsObs.observe(statsBar);

    // ── Pills da barra de pesquisa ─────────────────
    document.querySelectorAll('.spill').forEach(pill => {
        pill.addEventListener('click', function () {
            document.querySelectorAll('.spill').forEach(p => p.classList.remove('active'));
            this.classList.add('active');
        });
    });

    // ── Favoritar ──────────────────────────────────
    document.querySelectorAll('.car-fav').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.stopPropagation();
            this.classList.toggle('car-fav-active');
            const svg = this.querySelector('svg');
            if (this.classList.contains('car-fav-active')) {
                svg.setAttribute('fill', '#00f2ff');
                svg.setAttribute('stroke', '#00f2ff');
            } else {
                svg.setAttribute('fill', 'none');
                svg.setAttribute('stroke', 'currentColor');
            }
        });
    });

    // ── Parallax suave no hero ─────────────────────
    const carImg = document.querySelector('.car-hero-img');
    if (carImg) {
        document.addEventListener('mousemove', (e) => {
            const cx = window.innerWidth / 2;
            const cy = window.innerHeight / 2;
            const dx = (e.clientX - cx) / cx;
            const dy = (e.clientY - cy) / cy;
            carImg.style.transform = `translateX(${dx * 12}px) translateY(${dy * 6}px)`;
        });
    }
})();
</script>