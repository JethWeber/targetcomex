<section class="brands-section">
    <p class="brands-label">MARCAS DISPONÍVEIS</p>
    <div class="brands-track-wrapper">
        <div class="brands-track">
            @foreach (var brand in new[]{"Toyota","BMW","Mercedes","Mazda","Honda","Audi","Volkswagen","Ford","Hyundai","Kia","Porsche","Ferrari","Toyota","BMW","Mercedes","Mazda","Honda","Audi","Volkswagen","Ford","Hyundai","Kia","Porsche","Ferrari"})
