<!-- ════════════════════════════════════════════════════════
  ██  JAVASCRIPT — 100% local, sem dependências externas
════════════════════════════════════════════════════════ -->
<script>
(function () {
    'use strict';

    /* ── 1. Scroll Reveal (IntersectionObserver) ────────── */
    var revealIO = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
            if (e.isIntersecting) {
                e.target.classList.add('visible');
                revealIO.unobserve(e.target);
            }
        });
    }, { threshold: 0.10, rootMargin: '0px 0px -20px 0px' });

    function observeAll() {
        document.querySelectorAll('.h-anim-reveal:not(.visible)').forEach(function (el) {
            revealIO.observe(el);
        });
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', observeAll);
    } else {
        observeAll();
    }
    new MutationObserver(function (m) {
        if (m.some(function(x){return x.addedNodes.length;})) observeAll();
    }).observe(document.body, { childList: true, subtree: true });


    /* ── 2. Contadores animados na Stats Bar ────────────── */
    function animCount(el, target) {
        var start = 0, dur = 1600, step = 16;
        var inc = target / (dur / step);
        var t = setInterval(function () {
            start += inc;
            if (start >= target) {
                el.textContent = target.toLocaleString('pt-PT');
                clearInterval(t);
            } else {
                el.textContent = Math.floor(start).toLocaleString('pt-PT');
            }
        }, step);
    }
    var statsIO = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
            if (e.isIntersecting) {
                e.target.querySelectorAll('[data-target]').forEach(function (n) {
                    animCount(n, parseInt(n.dataset.target, 10));
                });
                statsIO.unobserve(e.target);
            }
        });
    }, { threshold: 0.5 });
    var sb = document.querySelector('.h-stats-bar');
    if (sb) statsIO.observe(sb);


    /* ── 3. Abas de pesquisa (Catálogo / Test Drive / Serviços) */
    var tabs = document.querySelectorAll('.h-tab');
    var inp  = document.getElementById('h-search-inp');
    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            tabs.forEach(function (t) { t.classList.remove('h-tab-on'); });
            this.classList.add('h-tab-on');
            if (inp && this.dataset.placeholder) {
                inp.placeholder = this.dataset.placeholder;
            }
        });
    });


    /* ── 4. Favoritar nos cards ─────────────────────────── */
    document.addEventListener('click', function (e) {
        var btn = e.target.closest('.h-cc-fav');
        if (!btn) return;
        btn.classList.toggle('h-fav-on');
        var svg = btn.querySelector('svg');
        if (svg) {
            var on = btn.classList.contains('h-fav-on');
            svg.setAttribute('fill',   on ? '#00f2ff' : 'none');
            svg.setAttribute('stroke', on ? '#00f2ff' : 'rgba(255,255,255,.75)');
        }
    });


    /* ── 5. Parallax suave do carro ao mover o rato ──────── */
    var carEl = document.getElementById('h-car-parallax');
    if (carEl) {
        document.addEventListener('mousemove', function (e) {
            var cx = window.innerWidth  / 2;
            var cy = window.innerHeight / 2;
            var dx = (e.clientX - cx) / cx;
            var dy = (e.clientY - cy) / cy;
            carEl.style.transform =
                'translateX(' + (dx * 10) + 'px) translateY(' + (dy * 5 - 8) + 'px)';
        });
    }


    /* ── 6. Ticker — pausa ao passar o rato ─────────────── */
    var ticker = document.querySelector('.h-ticker');
    if (ticker) {
        ticker.addEventListener('mouseenter', function () {
            this.style.animationPlayState = 'paused';
        });
        ticker.addEventListener('mouseleave', function () {
            this.style.animationPlayState = 'running';
        });
    }

})();
</script>