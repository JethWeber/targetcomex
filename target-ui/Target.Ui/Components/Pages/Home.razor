@page "/"

<!-- ═══════════════════════════════════════════════
     TARGET — Página Inicial
     Coloca este ficheiro em: Components/Pages/Home.razor
     Imagens necessárias (já existentes):
       wwwroot/img/carro_hero.png
       wwwroot/img/banner_carro.jpeg
       wwwroot/logo-1.png
═══════════════════════════════════════════════ -->

<!-- ── HERO ─────────────────────────────────── -->
<section class="hero-section">

    <!-- Fundo: grid + radial glow -->
    <div class="hero-bg">
        <div class="grid-overlay"></div>
        <div class="radial-glow"></div>
        <div class="radial-glow glow-2"></div>
    </div>

    <!-- Linha de scan animada sobre o carro -->
    <div class="scan-line"></div>

    <!-- Partículas decorativas -->
    <div class="particles">
        <span class="p p1"></span><span class="p p2"></span>
        <span class="p p3"></span><span class="p p4"></span>
        <span class="p p5"></span><span class="p p6"></span>
        <span class="p p7"></span><span class="p p8"></span>
    </div>

    <!-- Anel orbital ao redor do carro -->
    <div class="orbit-ring orbit-ring-1"></div>
    <div class="orbit-ring orbit-ring-2"></div>

    <!-- Conteúdo Hero -->
    <div class="hero-content">

        <!-- Badge IA -->
        <div class="ai-badge anim-slide-up" style="--d:0.1s">
            <span class="ai-dot"></span>
            <span>Inteligência Artificial Integrada</span>
        </div>

        <!-- Título principal -->
        <h1 class="hero-title anim-slide-up" style="--d:0.25s">
            Encontra o teu<br/>
            <span class="cyan-text typewriter">próximo veículo</span>
        </h1>
        <p class="hero-subtitle anim-slide-up" style="--d:0.4s">
            O marketplace de automóveis mais inteligente de Angola.<br/>
            Recomendações personalizadas por IA, em tempo real.
        </p>

        <!-- Carro hero -->
        <div class="car-wrapper anim-fade-in" style="--d:0.5s; disply: none;">
            <div class="car-shadow"></div>
            <div class="car-glow-ring"></div>
            @* <img src="img/banner21.jpeg" style="disply: none;" class="car-hero-img" alt="Veículo em destaque" /> *@

            <!-- HUD badges flutuantes -->
            <div class="hud-badge hud-left anim-slide-right" style="--d:0.8s">
                <div class="hud-icon">⚡</div>
                <div>
                    <div class="hud-label"></div>
                    <div class="hud-value"></div>
                </div>
            </div>

            <div class="hud-badge hud-right anim-slide-left" style="--d:0.9s">
                <div class="hud-icon"></div>
                <div>
                    <div class="hud-label"></div>
                    <div class="hud-value cyan-text"></div>
                </div>
            </div>

            <div class="hud-badge hud-top anim-slide-down" style="--d:1s">
                <span class="hud-label"></span>
                <span class="hud-value"></span>
            </div>
        </div>

        <!-- Search UI -->
        <div class="search-area anim-slide-up" style="--d:0.6s" >
            <div class="search-pills" style="display:none;">
                <button class="spill active">Comprar</button>
                <button class="spill">Vender</button>
                <button class="spill">IA Recomendação</button>
            </div>

            <div class="search-box">
                <div class="search-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                    </svg>
                </div>
                <input type="text" class="search-input" placeholder="Marca, modelo, ano, preço…" />
                <button class="search-camera" title="Buscar por imagem">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                        <circle cx="12" cy="13" r="4"/>
                    </svg>
                </button>
                <button class="search-btn">Pesquisar</button>
            </div>

            <p class="search-hint">
                <span class="hint-dot"></span>
                Muito mais INTELIGENTE — experimente a busca por imagem
            </p>
        </div>
    </div>

    <!-- Scroll indicator -->
    <div class="scroll-indicator" style="display:none;">
        <div class="scroll-mouse">
            <div class="scroll-wheel"></div>
        </div>
        <span>Deslizar</span>
    </div>
</section>

<!-- ── STATS BAR ──────────────────────────────── -->

<section class="stats-bar">
    <div class="stats-inner">
        <div class="stat-item">
            <span class="stat-num cyan-text" data-target="12400">0</span>
            <span class="stat-plus">+</span>
            <span class="stat-label">Veículos listados</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
            <span class="stat-num cyan-text" data-target="8300">0</span>
            <span class="stat-plus">+</span>
            <span class="stat-label">Vendas realizadas</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
            <span class="stat-num cyan-text" data-target="31000">0</span>
            <span class="stat-plus">+</span>
            <span class="stat-label">Utilizadores activos</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
            <span class="stat-num cyan-text">98</span>
            <span class="stat-plus">%</span>
            <span class="stat-label">Precisão da IA</span>
        </div>
    </div>
</section>

<!-- ── FEATURES ───────────────────────────────── -->
<section class="features-section">
    <div class="section-header">
        <span class="section-tag">PORQUÊ A TARGET?</span>
        <h2 class="section-title">Tecnologia que <span class="cyan-text">transforma</span><br/>a forma de comprar</h2>
    </div>

    <div class="features-grid">
        <div class="feat-card anim-reveal" style="--d:0s">
            <div class="feat-icon-wrap">
                <div class="feat-icon-bg"></div>
                <svg class="feat-icon" viewBox="0 0 24 24" fill="none" stroke="#00f2ff" stroke-width="1.5">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
                    <circle cx="12" cy="17" r=".5" fill="#00f2ff"/>
                </svg>
            </div>
            <h3 class="feat-title">Recomendação por IA</h3>
            <p class="feat-desc">O nosso motor de inteligência artificial analisa o teu perfil e sugere os veículos com maior compatibilidade, com precisão de 98%.</p>
            <div class="feat-arrow">→</div>
        </div>

        <div class="feat-card feat-card-highlight anim-reveal" style="--d:0.15s">
            <div class="feat-glow-border"></div>
            <div class="feat-icon-wrap">
                <div class="feat-icon-bg"></div>
                <svg class="feat-icon" viewBox="0 0 24 24" fill="none" stroke="#00f2ff" stroke-width="1.5">
                    <circle cx="11" cy="11" r="8"/>
                    <path d="m21 21-4.35-4.35"/>
                </svg>
            </div>
            <h3 class="feat-title">Busca por Imagem</h3>
            <p class="feat-desc">Fotografa qualquer carro na rua e a nossa IA identifica o modelo instantaneamente, mostrando as melhores ofertas disponíveis.</p>
            <div class="feat-arrow cyan-text">→</div>
            <div class="feat-badge-new">NOVO</div>
        </div>

        <div class="feat-card anim-reveal" style="--d:0.3s">
            <div class="feat-icon-wrap">
                <div class="feat-icon-bg"></div>
                <svg class="feat-icon" viewBox="0 0 24 24" fill="none" stroke="#00f2ff" stroke-width="1.5">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
            </div>
            <h3 class="feat-title">Transações Seguras</h3>
            <p class="feat-desc">Verificação de identidade, historial do veículo e pagamentos protegidos. Compra e vende com total confiança e tranquilidade.</p>
            <div class="feat-arrow">→</div>
        </div>
    </div>
</section>

