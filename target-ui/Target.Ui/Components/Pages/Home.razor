<!-- ── IA CTA ──────────────────────────────────── -->
<section class="ia-cta-section">
    <div class="ia-cta-bg">
        <div class="ia-cta-grid"></div>
        <div class="ia-cta-glow"></div>
    </div>
    <div class="ia-cta-content">
        <div class="ia-cta-left anim-reveal" style="--d:0s">
            <span class="section-tag">IA RECOMENDAÇÃO</span>
            <h2 class="ia-cta-title">
                A IA encontra o carro<br/>
                <span class="cyan-text">perfeito para ti</span>
            </h2>
            <p class="ia-cta-desc">
                Responde a algumas perguntas sobre as tuas preferências, estilo de vida e orçamento. 
                O nosso motor de IA analisa mais de 50 factores e apresenta os veículos com maior compatibilidade.
            </p>
            <div class="ia-features">
                <div class="ia-feat"><span class="ia-check">✓</span> Análise do teu perfil de condução</div>
                <div class="ia-feat"><span class="ia-check">✓</span> Compatibilidade com o teu estilo de vida</div>
                <div class="ia-feat"><span class="ia-check">✓</span> Melhores preços do mercado angolano</div>
                <div class="ia-feat"><span class="ia-check">✓</span> Historial e verificação do veículo</div>
            </div>
            <div class="ia-cta-actions">
                <a href="/ia" class="btn-cta-primary">
                    <span>Começar agora</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </a>
                <a href="/produtos" class="btn-cta-ghost">Ver todos os veículos</a>
            </div>
        </div>

        <div class="ia-cta-right anim-reveal" style="--d:0.2s">
            <div class="ia-card-mockup">
                <div class="ia-mockup-header">
                    <span class="ia-dot-anim"></span>
                    <span class="ia-mockup-title">Análise TARGET AI</span>
                </div>
                <div class="ia-match-ring-wrap">
                    <svg class="ia-ring-svg" viewBox="0 0 120 120">
                        <circle cx="60" cy="60" r="52" stroke="rgba(0,242,255,0.1)" stroke-width="8" fill="none"/>
                        <circle cx="60" cy="60" r="52" stroke="#00f2ff" stroke-width="8" fill="none"
                            stroke-dasharray="327" stroke-dashoffset="33"
                            stroke-linecap="round" transform="rotate(-90 60 60)" class="ring-progress"/>
                    </svg>
                    <div class="ia-ring-inner">
                        <span class="ia-pct">98%</span>
                        <span class="ia-pct-label">Compatível</span>
                    </div>
                </div>
                <div class="ia-mockup-rows">
                    <div class="ia-row">
                        <span class="ia-row-label">Orçamento</span>
                        <div class="ia-bar-wrap"><div class="ia-bar" style="width:88%"></div></div>
                        <span class="ia-row-val">88%</span>
                    </div>
                    <div class="ia-row">
                        <span class="ia-row-label">Estilo vida</span>
                        <div class="ia-bar-wrap"><div class="ia-bar" style="width:95%"></div></div>
                        <span class="ia-row-val">95%</span>
                    </div>
                    <div class="ia-row">
                        <span class="ia-row-label">Performance</span>
                        <div class="ia-bar-wrap"><div class="ia-bar" style="width:100%"></div></div>
                        <span class="ia-row-val">100%</span>
                    </div>
                    <div class="ia-row">
                        <span class="ia-row-label">Eficiência</span>
                        <div class="ia-bar-wrap"><div class="ia-bar" style="width:76%"></div></div>
                        <span class="ia-row-val">76%</span>
                    </div>
                </div>
                <div class="ia-mockup-footer">
                    <span>Mazda CX-5 2024 — Recomendado por IA</span>
                </div>
            </div>
        </div>
    </div>
</section>

