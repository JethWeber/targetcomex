        <div class="h-scroll-mouse"><div class="h-scroll-wheel"></div></div>
        <span>Deslizar</span>
    </div>
</section>

@code {
    private List<Target.Ui.Services.VeiculoDto> cars = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AuthService.InitAsync();
        var isAuth = await AuthService.IsAuthenticatedAsync();

        if (isAuth)
        {
            var uid = await AuthService.GetUserIdAsync();
            if (uid.HasValue)
            {
                var rec = await ApiClient.GetRecomendacoesAsync(uid.Value);
                if (rec.Success && rec.Data?.Any() == true)
                {
                    foreach (var r in rec.Data.Take(4))
                    {
                        var vres = await ApiClient.GetVeiculoAsync(r.VeiculoId);
                        if (vres.Success && vres.Data != null) cars.Add(vres.Data);
                    }
                }
            }
        }

        if (!cars.Any())
        {
            var top = await ApiClient.GetMaisCompradosAsync(4);
            if (top.Success && top.Data != null)
            {
                foreach (var m in top.Data.Take(4))
                {
                    // Prefer full vehicle payload when available
                    var vres = await ApiClient.GetVeiculoAsync(m.Id);
                    if (vres.Success && vres.Data != null) cars.Add(vres.Data);
                    else
                    {
                        cars.Add(new Target.Ui.Services.VeiculoDto
                        {
                            Id = m.Id,
                            Marca = m.Marca ?? string.Empty,
                            Modelo = m.Modelo ?? string.Empty,
                            Ano = m.Ano,
                            ImagemUrl = m.ImagemUrl,
                            Preco = m.Preco
                        });
                    }
                }
            }
        }

        StateHasChanged();
    }
}


