<!-- ════════════════════════════════════════════════════════
  ██  SECÇÃO 5 — VEÍCULOS EM DESTAQUE
════════════════════════════════════════════════════════ -->
<section class="h-section h-cars-sec">
    <div class="h-section-head">
        <span class="h-eyebrow">DESTAQUES DO SHOWROOM</span>
        <h2 class="h-section-title">
            Veículos <span class="h-cyan">seleccionados</span><br/>
            pelos nossos especialistas
        </h2>
        <a href="/produtos" class="h-see-all">Ver catálogo completo →</a>
    </div>

    <div class="h-cars-grid">

        @if (cars is null || !cars.Any())
        {
            <p>Carregando destaques...</p>
        }
        else
        {
            var count = Math.Min(4, cars.Count);
            for (var idx = 0; idx < count; idx++)
            {
                var car = cars[idx];
                <div class="@($"h-car-card {(idx==1? "h-car-hl" : "")} h-anim-reveal")" style="@($"--d:{idx*0.12}s")">
                    <div class="h-cc-media">
                            <img src='@(car.ImagemUrl ?? "img/banner_carro.jpeg")' alt='@((car.Marca + " " + car.Modelo).Trim())'
                             class="h-cc-img" loading="lazy" />
                        <span class="h-cc-badge">@((car.Estilo ?? car.Combustivel) ?? "")</span>
                        <button class="h-cc-fav" aria-label="Guardar">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                 stroke="rgba(255,255,255,.75)" stroke-width="2">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                            </svg>
                        </button>
                        <span class="h-cc-ia">🎯</span>
                    </div>
                    <div class="h-cc-body">
                        <div class="h-cc-meta"><span>@(car.Ano)</span><span>@(string.IsNullOrWhiteSpace(car.Transmissao)?"Automática":car.Transmissao)</span><span>@(car.Quilometragem.HasValue ? $"{car.Quilometragem} km" : "0 km")</span></div>
                        <h4 class="h-cc-name">@((car.Marca + " " + car.Modelo).Trim())</h4>
                        <div class="h-cc-specs">
                            <span>⚙ @(car.Motor ?? "-")</span>
                            <span>⚡ @(car.Potencia?.ToString() ?? "-") cv</span>
                            <span>📏 @(car.Quilometragem?.ToString() ?? "0") km</span>
                        </div>
                        <div class="h-cc-foot">
                            <span class="h-cc-price">AOA @(((decimal)car.Preco).ToString("N0"))</span>
                            <a href="/produtos" class="h-cc-btn">Ver detalhes</a>
                        </div>
                    </div>
                </div>
            }
        }

    </div>

    <div class="h-cars-cta">
        <a href="/produtos" class="h-btn-outline">
            Ver todos os veículos
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
        </a>
    </div>
</section>


