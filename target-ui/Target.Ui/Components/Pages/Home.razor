<style>

/* ─── VARIÁVEIS ─────────────────────────────────── */
:root {
    --cyan: #00f2ff;
    --cyan-dim: rgba(0, 242, 255, 0.12);
    --cyan-glow: rgba(0, 242, 255, 0.4);
    --bg: #000;
    --bg-1: #080808;
    --bg-2: #0d0d0d;
    --bg-card: #111;
    --border: rgba(255,255,255,0.07);
    --text: #e0e0e0;
    --text-dim: #666;
    --font: -apple-system, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    --radius: 14px;
    --radius-sm: 8px;
}

/* ─── RESET ─────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: var(--font); color: var(--text); }

/* ─── UTILS ─────────────────────────────────────── */
.cyan-text { color: var(--cyan); }

/* ─── ANIMAÇÕES DE ENTRADA ──────────────────────── */
@@keyframes slideUp {
    from { opacity: 0; transform: translateY(40px); }
    to   { opacity: 1; transform: translateY(0); }
}
@@keyframes slideRight {
    from { opacity: 0; transform: translateX(-40px); }
    to   { opacity: 1; transform: translateX(0); }
}
@@keyframes slideLeft {
    from { opacity: 0; transform: translateX(40px); }
    to   { opacity: 1; transform: translateX(0); }
}
@@keyframes slideDown {
    from { opacity: 0; transform: translateY(-30px); }
    to   { opacity: 1; transform: translateY(0); }
}
@@keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
}
.anim-slide-up   { opacity: 0; animation: slideUp   0.7s cubic-bezier(.2,.8,.2,1) var(--d, 0s) forwards; }
.anim-slide-right{ opacity: 0; animation: slideRight 0.7s cubic-bezier(.2,.8,.2,1) var(--d, 0s) forwards; }
.anim-slide-left { opacity: 0; animation: slideLeft  0.7s cubic-bezier(.2,.8,.2,1) var(--d, 0s) forwards; }
.anim-slide-down { opacity: 0; animation: slideDown  0.6s cubic-bezier(.2,.8,.2,1) var(--d, 0s) forwards; }
.anim-fade-in    { opacity: 0; animation: fadeIn     0.8s ease var(--d, 0s) forwards; }

/* Reveal ao scroll — activado por JS abaixo */
.anim-reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(.2,.8,.2,1);
}
.anim-reveal.visible {
    opacity: 1;
    transform: translateY(0);
}
.anim-reveal.visible { transition-delay: var(--d, 0s); }

/* ─── HERO ──────────────────────────────────────── */
.hero-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #000;
    padding-top: 100px;
}

/* Fundo */
.hero-bg {
    position: absolute; inset: 0; pointer-events: none;
}

.grid-overlay {
    position: absolute; inset: 0;
    background-image:
        linear-gradient(rgba(0,242,255,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,242,255,0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    animation: gridFade 3s ease forwards;
}
@@keyframes gridFade {
    from { opacity: 0; } to { opacity: 1; }
}

.radial-glow {
    position: absolute;
    width: 600px; height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0,242,255,0.12) 0%, transparent 70%);
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    animation: glowPulse 4s ease-in-out infinite;
}
.radial-glow.glow-2 {
    width: 900px; height: 900px;
    background: radial-gradient(circle, rgba(0,242,255,0.04) 0%, transparent 70%);
    animation-delay: 2s;
}
@@keyframes glowPulse {
    0%,100% { opacity: 0.6; transform: translate(-50%,-50%) scale(1); }
    50%      { opacity: 1;   transform: translate(-50%,-50%) scale(1.08); }
}

/* Linha de scan */
.scan-line {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--cyan), transparent);
    animation: scanDown 6s linear infinite;
    z-index: 2;
    opacity: 0.5;
}
@@keyframes scanDown {
    0%   { top: 0%;   opacity: 0; }
    5%   { opacity: 0.7; }
    95%  { opacity: 0.7; }
    100% { top: 100%; opacity: 0; }
}

/* Partículas */
.particles { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
.p {
    position: absolute;
    width: 3px; height: 3px;
    border-radius: 50%;
    background: var(--cyan);
    opacity: 0;
    animation: floatParticle linear infinite;
}
.p1  { left: 10%; animation-duration: 8s;  animation-delay: 0s;   top: 80%; }
.p2  { left: 20%; animation-duration: 10s; animation-delay: 1s;   top: 70%; }
.p3  { left: 35%; animation-duration: 7s;  animation-delay: 2s;   top: 90%; }
.p4  { left: 50%; animation-duration: 9s;  animation-delay: 0.5s; top: 75%; }
.p5  { left: 65%; animation-duration: 11s; animation-delay: 3s;   top: 85%; }
.p6  { left: 75%; animation-duration: 6s;  animation-delay: 1.5s; top: 95%; }
.p7  { left: 85%; animation-duration: 8s;  animation-delay: 2.5s; top: 60%; }
.p8  { left: 95%; animation-duration: 10s; animation-delay: 0.8s; top: 80%; }
@@keyframes floatParticle {
    0%   { transform: translateY(0); opacity: 0; }
    10%  { opacity: 0.8; }
    90%  { opacity: 0.5; }
    100% { transform: translateY(-120vh); opacity: 0; }
}

/* Anéis orbitais */
.orbit-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(0,242,255,0.08);
    pointer-events: none;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
}
.orbit-ring-1 {
    width: 700px; height: 700px;
    animation: orbitSpin 30s linear infinite;
    border-style: dashed;
}
.orbit-ring-2 {
    width: 1000px; height: 1000px;
    animation: orbitSpin 50s linear infinite reverse;
}
@@keyframes orbitSpin {
    from { transform: translate(-50%,-50%) rotate(0deg); }
    to   { transform: translate(-50%,-50%) rotate(360deg); }
}

/* ── Hero content ── */
.hero-content {
    position: relative;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 1100px;
    padding: 0 20px;
}

/* Badge IA */
.ai-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0,242,255,0.08);
    border: 1px solid rgba(0,242,255,0.2);
    border-radius: 999px;
    padding: 6px 16px;
    font-size: 0.75rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 20px;
}
.ai-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--cyan);
    animation: dotPulse 1.4s ease infinite;
}
@@keyframes dotPulse {
    0%,100% { box-shadow: 0 0 0 0 var(--cyan-glow); }
    50%      { box-shadow: 0 0 0 6px transparent; }
}

/* Título */
.hero-title {
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -1.5px;
    color: #fff;
    margin-bottom: 16px;
}
.typewriter {
    display: inline-block;
    overflow: hidden;
    border-right: 3px solid var(--cyan);
    white-space: nowrap;
    animation:
        typing 1.5s steps(16, end) 0.8s both,
        cursorBlink 0.75s step-end infinite;
    max-width: 0;
}
@@keyframes typing {
    from { max-width: 0; }
    to   { max-width: 100%; }
}
@@keyframes cursorBlink {
    50% { border-color: transparent; }
}

.hero-subtitle {
    font-size: 1rem;
    color: var(--text-dim);
    line-height: 1.7;
    margin-bottom: 0;
    max-width: 500px;
}

/* Carro */
.car-wrapper {
    position: relative;
    width: 100%;
    max-width: 900px;
    margin: -20px auto -20px;
}
.car-hero-img {
    width: 100%;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 0 60px rgba(0,242,255,0.15));
    animation: carFloat 5s ease-in-out infinite;
}
@@keyframes carFloat {
    0%,100% { transform: translateY(0); }
    50%      { transform: translateY(-14px); }
}
.car-shadow {
    position: absolute;
    bottom: 10%;
    left: 15%; right: 15%;
    height: 30px;
    background: radial-gradient(ellipse, rgba(0,242,255,0.2) 0%, transparent 70%);
    border-radius: 50%;
    animation: shadowPulse 5s ease-in-out infinite;
    filter: blur(8px);
}
@@keyframes shadowPulse {
    0%,100% { opacity: 0.6; transform: scaleX(1); }
    50%      { opacity: 1;   transform: scaleX(0.85); }
}
.car-glow-ring {
    position: absolute;
    inset: -5%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0,242,255,0.06) 0%, transparent 65%);
    animation: glowPulse 4s ease-in-out infinite;
}

/* HUD badges */
.hud-badge {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(0,0,0,0.8);
    border: 1px solid rgba(0,242,255,0.2);
    border-radius: 12px;
    padding: 10px 16px;
    backdrop-filter: blur(10px);
    z-index: 10;
    font-size: 0.8rem;
    animation: hudFloat 3s ease-in-out infinite;
}
.hud-badge.hud-left { top: 35%; left: 2%; animation-delay: 0s; }
.hud-badge.hud-right { top: 35%; right: 2%; animation-delay: 1s; }
.hud-badge.hud-top { top: 8%; left: 50%; transform: translateX(-50%); flex-direction: row; gap: 12px; animation-delay: 0.5s; }
@@keyframes hudFloat {
    0%,100% { transform: translateY(0); }
    50%      { transform: translateY(-6px); }
}
.hud-badge.hud-top { animation-name: hudFloatTop; }
@@keyframes hudFloatTop {
    0%,100% { transform: translateX(-50%) translateY(0); }
    50%      { transform: translateX(-50%) translateY(-6px); }
}
.hud-icon { font-size: 1.4rem; }
.hud-label { font-size: 0.68rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.5px; }
.hud-value { font-size: 1rem; font-weight: 700; color: #fff; }

/* Search area */
.search-area {
    width: 100%;
    max-width: 700px;
    margin-top: 10px;
}
.search-pills {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 14px;
}
.spill {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    color: #aaa;
    padding: 7px 22px;
    border-radius: 999px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.25s;
}
.spill:hover { border-color: var(--cyan); color: var(--cyan); }
.spill.active {
    background: var(--cyan);
    border-color: var(--cyan);
    color: #000;
    font-weight: 700;
    box-shadow: 0 0 20px rgba(0,242,255,0.3);
}

.search-box {
    display: flex;
    align-items: center;
    background: #fff;
    border-radius: 14px;
    padding: 5px 5px 5px 16px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.6), 0 0 0 1px rgba(0,242,255,0.1);
    transition: box-shadow 0.3s;
}
.search-box:focus-within {
    box-shadow: 0 20px 60px rgba(0,0,0,0.6), 0 0 0 2px var(--cyan);
}
.search-icon { color: #999; flex-shrink: 0; display: flex; align-items: center; margin-right: 8px; }
.search-input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 0.95rem;
    color: #111;
    background: transparent;
    padding: 12px 0;
}
.search-camera {
    background: rgba(0,0,0,0.06);
    border: none;
    width: 44px; height: 44px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    color: #555;
    cursor: pointer;
    transition: all 0.2s;
    margin-right: 6px;
}
.search-camera:hover { background: rgba(0,242,255,0.1); color: #00b8c4; }
.search-btn {
    background: var(--cyan);
    border: none;
    padding: 12px 28px;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 700;
    color: #000;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
}
.search-btn:hover { background: #00d4e0; box-shadow: 0 0 25px rgba(0,242,255,0.5); transform: scale(1.02); }

.search-hint {
    margin-top: 10px;
    font-size: 0.75rem;
    color: #555;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}
.hint-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--cyan);
    animation: dotPulse 1.4s ease infinite;
    flex-shrink: 0;
}

/* Scroll indicator */
.scroll-indicator {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: #444;
    font-size: 0.7rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    z-index: 5;
    animation: fadeIn 1s 2s forwards;
    opacity: 0;
}
.scroll-mouse {
    width: 22px; height: 36px;
    border: 2px solid #333;
    border-radius: 12px;
    display: flex; justify-content: center;
    padding-top: 6px;
}
.scroll-wheel {
    width: 3px; height: 7px;
    background: var(--cyan);
    border-radius: 2px;
    animation: scrollWheel 2s ease-in-out infinite;
}
@@keyframes scrollWheel {
    0%,100% { transform: translateY(0); opacity: 1; }
    80%      { transform: translateY(10px); opacity: 0; }
}

/* ─── STATS BAR ─────────────────────────────────── */
/* ─── STATS BAR ─────────────────────────────────── */
.stats-bar {
    background: var(--bg-1);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 32px 20px;
    overflow-x: auto;
}

.stats-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    gap: 20px;
    min-width: max-content;
}

.stat-item {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-direction: row;
    flex-wrap: nowrap;
    white-space: nowrap;
    flex-shrink: 0;
}

.stat-num {
    font-size: clamp(1.3rem, 2vw, 2rem);
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1;
}

.stat-plus {
    font-size: 1rem;
    font-weight: 700;
    color: var(--cyan);
    margin-right: 4px;
    line-height: 1;
}

.stat-label {
    font-size: 0.78rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    align-self: center;
    white-space: nowrap;
}

.stat-divider {
    width: 1px;
    height: 40px;
    background: var(--border);
    flex-shrink: 0;
}

/* ─── SECTIONS COMUNS ───────────────────────────── */
.features-section,
.cars-section,
.testimonials-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 100px 40px;
}

.section-header {
    margin-bottom: 60px;
    position: relative;
}
.section-tag {
    display: inline-block;
    font-size: 0.7rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--cyan);
    background: var(--cyan-dim);
    border: 1px solid rgba(0,242,255,0.2);
    padding: 4px 12px;
    border-radius: 4px;
    margin-bottom: 16px;
}
.section-title {
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.5px;
    color: #fff;
}
.see-all-link {
    position: absolute;
    right: 0; top: 50%;
    transform: translateY(-50%);
    color: var(--cyan);
    font-size: 0.9rem;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: gap 0.2s;
}
.see-all-link:hover { gap: 10px; }

/* ─── FEATURES ──────────────────────────────────── */
.features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
}
.feat-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 36px 28px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(.2,.8,.2,1);
    cursor: pointer;
}
.feat-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0,242,255,0.03), transparent);
    opacity: 0;
    transition: opacity 0.3s;
}
.feat-card:hover { transform: translateY(-6px); border-color: rgba(0,242,255,0.3); }
.feat-card:hover::before { opacity: 1; }

.feat-card-highlight {
    border-color: rgba(0,242,255,0.25);
    background: linear-gradient(135deg, rgba(0,242,255,0.05), var(--bg-card));
}
.feat-glow-border {
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    border: 1px solid var(--cyan);
    opacity: 0.3;
    animation: borderPulse 3s ease-in-out infinite;
}
@@keyframes borderPulse {
    0%,100% { opacity: 0.2; }
    50%      { opacity: 0.5; }
}

.feat-icon-wrap {
    position: relative;
    width: 56px; height: 56px;
    margin-bottom: 24px;
}
.feat-icon-bg {
    position: absolute; inset: 0;
    background: var(--cyan-dim);
    border-radius: 14px;
    animation: iconBgPulse 3s ease-in-out infinite;
}
@@keyframes iconBgPulse {
    0%,100% { transform: scale(1); }
    50%      { transform: scale(1.08); }
}
.feat-icon {
    position: relative;
    width: 28px; height: 28px;
    margin: 14px;
}

.feat-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 10px;
}
.feat-desc {
    font-size: 0.88rem;
    color: var(--text-dim);
    line-height: 1.7;
}
.feat-arrow {
    margin-top: 20px;
    font-size: 1.2rem;
    color: #333;
    transition: all 0.2s;
}
.feat-card:hover .feat-arrow { color: var(--cyan); transform: translateX(6px); }

.feat-badge-new {
    position: absolute;
    top: 20px; right: 20px;
    background: var(--cyan);
    color: #000;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 3px 10px;
    border-radius: 999px;
    animation: badgePop 0.5s cubic-bezier(.4,2,.5,1) 1.5s both;
}
@@keyframes badgePop {
    from { transform: scale(0); }
    to   { transform: scale(1); }
}

/* ─── CARS GRID ─────────────────────────────────── */
/* ─── CARS GRID ─────────────────────────────────── */
.cars-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
}

.car-card {
    width: 100%;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: all 0.3s cubic-bezier(.2,.8,.2,1);
    cursor: pointer;
}

.car-card:hover { 
    transform: translateY(-8px); 
    border-color: rgba(0,242,255,0.2); 
}

.car-card:hover .car-card-img { 
    transform: scale(1.06); 
}

@@media (max-width: 992px) {
    .cars-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@@media (max-width: 576px) {
    .cars-grid {
        grid-template-columns: 1fr;
        gap: 20px;
    }
}
.car-card-media {
    position: relative;
    height: 190px;
    overflow: hidden;
    background: #0a0a0a;
}
.car-card-img {
    width: 100%; height: 100%;
