@page "/produtos"
@rendermode InteractiveServer
@using System.Linq
@inject NavigationManager Nav
@inject ApiClient Api

<!-- ══════════════════════════════════════════════════════
     HERO SECTION
══════════════════════════════════════════════════════ -->
<section class="products-hero">
    <div class="hero-bg-image"></div>
    <div class="hero-overlay"></div>
    <div class="grid-overlay"></div>
    <div class="scan-line"></div>

    <div class="hero-content">
        <div class="ai-badge anim-slide-up" style="--d:0.1s">
            <span class="ai-dot"></span>
            <span>Catálogo Inteligente com IA</span>
        </div>

        <h1 class="hero-title anim-slide-up" style="--d:0.25s">
            O Futuro Move-se<br/>
            <span class="cyan-text glitch-text" data-text="a 300 km/h">a 300 km/h</span>
        </h1>

        <p class="hero-subtitle anim-slide-up" style="--d:0.4s">
            @veiculos.Count veículos verificados • Recomendações por IA com 98% de precisão
        </p>

        <div class="search-area anim-slide-up" style="--d:0.6s">
            <div class="search-box">
                <div class="search-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2.5">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.35-4.35"/>
                    </svg>
                </div>
                <input type="text" class="search-input"
                       placeholder="Pesquisar por marca, modelo..."
                       @bind="termoBusca"
                       @bind:event="oninput"
                       @onkeyup="AplicarFiltros" />
                <button class="search-btn" @onclick="AplicarFiltros">Pesquisar</button>
            </div>
        </div>

        <div class="hero-stats anim-slide-up" style="--d:0.8s">
            <div class="hero-stat">
                <span class="stat-num">@veiculos.Count</span>
                <span class="stat-label">Veículos disponíveis</span>
            </div>
            <div class="hero-stat">
                <span class="stat-num cyan-text">98%</span>
                <span class="stat-label">Precisão IA</span>
            </div>
            <div class="hero-stat">
                <span class="stat-num">@veiculosFiltrados.Count</span>
                <span class="stat-label">Resultados actuais</span>
            </div>
        </div>
    </div>
</section>

<section class="products-highlight">
    <div class="products-highlight-header">
        <div>
            <h2>🔥 Os Mais Comprados</h2>
            <p>Top veículos com maior procura no Target Comex, alimentado pelo histórico de compras.</p>
        </div>
        <span class="products-highlight-count">@maisComprados.Count</span>
    </div>
    <div class="products-highlight-grid">
        @if (maisComprados.Any())
        {
            @foreach (var item in maisComprados)
            {
                <div class="highlight-card">
                    <img src="@item.ImagemUrl" alt="@item.Marca @item.Modelo" loading="lazy" />
                    <div class="highlight-body">
                        <div class="highlight-meta">
                            <span>@item.Marca</span>
                            <span>@item.Ano</span>
                        </div>
                        <h3>@item.Modelo</h3>
                        <div class="highlight-footer">
                            <span>AOA @item.Preco.ToString("N0").Replace(",", ".")</span>
                            <span>@item.TotalCompras compras</span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="highlight-empty">
                Ainda a carregar os veículos mais procurados.
            </div>
        }
    </div>
</section>

<!-- ══════════════════════════════════════════════════════
     FILTROS + RESULTADOS
══════════════════════════════════════════════════════ -->
<section class="products-section">
    <div class="products-container">

        <!-- ── SIDEBAR ── -->
        <aside class="filters-sidebar">
            <div class="filters-header">
                <h3>Filtros Avançados</h3>
                <button class="clear-filters" @onclick="LimparFiltros">Limpar Tudo</button>
            </div>

            <!-- Combustível -->
            <div class="filter-group">
                <label class="filter-label">Tipo de Combustível</label>
                <div class="filter-options">
                    @foreach (var op in opcoesCombus)
                    {
                        <button class="filter-chip @(filtroCombus.Contains(op) ? "active" : "")"
                                @onclick="() => ToggleFiltro(filtroCombus, op)">@op</button>
                    }
                </div>
            </div>

            <!-- Marca -->
            <div class="filter-group">
                <label class="filter-label">Marca</label>
                <div class="filter-options">
                    @foreach (var op in opcoesMarca)
                    {
                        <button class="filter-chip @(filtroMarca.Contains(op) ? "active" : "")"
                                @onclick="() => ToggleFiltro(filtroMarca, op)">@op</button>
                    }
                </div>
            </div>

            <!-- Transmissão -->
            <div class="filter-group">
                <label class="filter-label">Transmissão</label>
                <div class="filter-options">
                    @foreach (var op in opcoesTransm)
                    {
                        <button class="filter-chip @(filtroTransm.Contains(op) ? "active" : "")"
                                @onclick="() => ToggleFiltro(filtroTransm, op)">@op</button>
                    }
                </div>
            </div>

            <!-- Ano -->
            <div class="filter-group">
                <label class="filter-label">Ano mínimo: <span class="cyan-text">@filtroAnoMin</span></label>
                <div class="slider-wrap">
                    <input type="range" class="range-slider"
                           min="2018" max="2025"
                           @bind="filtroAnoMin"
                           @bind:event="oninput"
                           @onchange="AplicarFiltros"
                            />
                    <div class="slider-tooltip" style="left: calc(@(((filtroAnoMin - 2018) * 100.0 / (2025 - 2018)))% )">@filtroAnoMin</div>
                </div>
                <div class="range-labels"><span>2018</span><span>2025</span></div>
            </div>

            <!-- Preço -->
            <div class="filter-group">
                <label class="filter-label">
                    Preço máx: <span class="cyan-text">AOA @filtroPrecoMax.ToString("N0").Replace(",",".")</span>
                </label>
                <div class="slider-wrap">
                    <input type="range" class="range-slider"
                           min="50000000" max="900000000" step="10000000"
                           @bind="filtroPrecoMax"
                           @bind:event="oninput"
                           @onchange="AplicarFiltros"
                           />
                    <div class="slider-tooltip" style="left: calc(@(((filtroPrecoMax - 50_000_000) * 100.0 / (900_000_000 - 50_000_000)))% )">@((filtroPrecoMax/1_000_000).ToString("0"))M</div>
                </div>
                <div class="range-labels"><span>50M</span><span>900M</span></div>
            </div>

            <!-- Ordenação -->
            <div class="filter-group">
                <label class="filter-label">Ordenar por</label>
                <select class="filter-select" @bind="ordenacao" @bind:after="AplicarFiltros">
                    <option value="relevancia">Relevância</option>
                    <option value="preco-asc">Preço ↑</option>
                    <option value="preco-desc">Preço ↓</option>
                    <option value="ano-desc">Mais recentes</option>
                    <option value="nome-asc">Nome A–Z</option>
                </select>
            </div>
        </aside>

        <!-- ── RESULTS AREA ── -->
        <div class="results-area">

            <!-- Barra de resultados -->
            <div class="results-topbar">
                <p class="results-count">
                    <span class="cyan-text">@veiculosFiltrados.Count</span> veículos encontrados
                </p>
                <div class="view-toggle">
                    <button class="view-btn @(viewGrid ? "active" : "")" @onclick="() => viewGrid = true" title="Grelha">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                            <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
                        </svg>
                    </button>
                    <button class="view-btn @(!viewGrid ? "active" : "")" @onclick="() => viewGrid = false" title="Lista">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Cards -->
            @if (!veiculosFiltrados.Any())
            {
                <div class="no-results">
                    <div class="no-results-icon">🔍</div>
                    <h3>Nenhum veículo encontrado</h3>
                    <p>Tente ajustar os filtros ou a pesquisa.</p>
                    <button class="search-btn" @onclick="LimparFiltros">Limpar Filtros</button>
                </div>
            }
            else
            {
                <div class="cars-grid @(viewGrid ? "grid-view" : "list-view")">
                    @foreach (var v in veiculosFiltrados)
                    {
                        <div class="car-card anim-reveal">
                            <div class="car-image-wrap">
                                <img src="@v.Imagem" alt="@v.Nome" class="car-img" loading="lazy" />
                                <div class="car-badge">@v.Combustivel</div>
                                <button class="car-fav @(favoritos.Contains(v.Id) ? "car-fav-active" : "")"
                                        @onclick="() => ToggleFavorito(v.Id)">
                                    <svg width="18" height="18" viewBox="0 0 24 24"
                                         fill="@(favoritos.Contains(v.Id) ? "#00f2ff" : "none")"
                                         stroke="@(favoritos.Contains(v.Id) ? "#00f2ff" : "currentColor")"
                                         stroke-width="2">
                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                                    </svg>
                                </button>
                                <div class="car-score">
                                    <span>⚡</span> @v.ScoreIA% IA
                                </div>
                            </div>
                            <div class="car-body">
                                <div class="car-meta">
                                    <span class="car-ano">@v.Ano</span>
                                    <span class="car-transm">@v.Transmissao</span>
                                </div>
                                <h4 class="car-name">@v.Nome</h4>
                                <div class="car-specs">
                                    <span>🏎 @v.Potencia cv</span>
                                    <span>⚙ @v.Motor</span>
                                    <span>📏 @(new Random(v.Id * 137).Next(8000, 95000).ToString("N0").Replace(",",".")) km</span>
                                </div>
                                <div class="car-footer">
                                    <div class="car-price">AOA @v.Preco.ToString("N0").Replace(",",".")</div>
                                    @* <button class="btn-details" @onclick="() => Navegar(v.Id)">Ver Detalhes</button> *@
                                    <button class="btn-details" @onclick='() => Nav.NavigateTo($"/detalhes-veiculo/{v.Id}")'>
                                        Ver Detalhes
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

        </div>
    </div>
</section>

<!-- ══════════════════════════════════════════════════════
     ESTILOS
══════════════════════════════════════════════════════ -->
<style>
    :root {
        --cyan: #00f2ff;
        --cyan-bright: #40f8ff;
        --cyan-glow: rgba(0,242,255,0.25);
        --text: #f0f0f0;
        --text-dim: #aaaaaa;
        --bg-dark: #080808;
        --bg-card: #111111;
        --bg-card2: #161616;
        --border: rgba(255,255,255,0.08);
        --border-hover: rgba(0,242,255,0.4);
        --radius: 16px;
        --radius-sm: 10px;
    }

    /* ── RESET ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    button { border: none; cursor: pointer; font-family: inherit; }

    /* ── ANIMAÇÕES ── */
    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(28px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes scanMove {
        0%   { top: -2px; }
        100% { top: 100%; }
    }
    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.4; }
    }
    @@keyframes revealFade {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes cardReveal {
        from { opacity: 0; transform: translateY(40px) scale(0.97); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    @@keyframes glitch {
        0%   { clip-path: inset(0 0 98% 0); transform: translate(-3px, 0); }
        10%  { clip-path: inset(30% 0 50% 0); transform: translate(3px, 0); }
        20%  { clip-path: inset(60% 0 20% 0); transform: translate(-2px, 0); }
        30%  { clip-path: inset(10% 0 80% 0); transform: translate(2px, 0); }
        40%  { clip-path: inset(80% 0 5% 0);  transform: translate(-3px, 0); }
        50%  { clip-path: inset(0 0 0 0);      transform: translate(0, 0); }
        100% { clip-path: inset(0 0 0 0);      transform: translate(0, 0); }
    }

    .anim-slide-up {
        opacity: 0;
        animation: slideUp 0.7s cubic-bezier(0.22,1,0.36,1) forwards;
        animation-delay: var(--d, 0s);
    }
    .anim-reveal {
        opacity: 0;
        transform: translateY(40px) scale(0.97);
        transition: opacity 0.6s cubic-bezier(0.22,1,0.36,1),
                    transform 0.6s cubic-bezier(0.22,1,0.36,1);
    }
    .anim-reveal.visible { opacity: 1; transform: translateY(0) scale(1); }

    /* Glitch effect on hero title span */
    .glitch-text {
        position: relative;
        display: inline-block;
    }
    .glitch-text::before,
    .glitch-text::after {
        content: attr(data-text);
        position: absolute;
        left: 0; top: 0;
        color: var(--cyan);
        width: 100%;
    }
    .glitch-text::before {
        text-shadow: 2px 0 #ff00ea;
        animation: glitch 4s infinite linear alternate-reverse;
        opacity: 0.7;
    }
    .glitch-text::after {
        text-shadow: -2px 0 #00f2ff;
        animation: glitch 3.5s infinite linear alternate;
        opacity: 0.5;
    }

    /* Slider tooltip */
    .slider-wrap {
        position: relative;
        padding-bottom: 24px;
    }
    .slider-tooltip {
        position: absolute;
        bottom: 0;
        transform: translateX(-50%);
        background: var(--cyan);
        color: #000;
        font-size: 0.7rem;
        font-weight: 800;
        padding: 2px 7px;
        border-radius: 6px;
        white-space: nowrap;
        pointer-events: none;
        letter-spacing: 0.04em;
        transition: left 0.1s;
    }
    .slider-tooltip::before {
        content: '';
        position: absolute;
        top: -5px;
        left: 50%;
        transform: translateX(-50%);
        border: 3px solid transparent;
        border-bottom-color: var(--cyan);
    }

    /* ════════════════════════════════════
       HERO
    ════════════════════════════════════ */
    .products-hero {
        position: relative;
        min-height: 70vh;
        display: flex;
        align-items: center;
        padding: 130px 40px 90px;
        overflow: hidden;
        z-index: 0;
    }

    /* Imagem de fundo */
    .hero-bg-image {
        position: absolute;
        inset: 0;
        background: url('img/banner2.jpeg') center center / cover no-repeat;
        z-index: 0;
    }

    /* Overlay escuro sobre a imagem */
    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            135deg,
            rgba(0,0,0,0.82) 0%,
            rgba(0,0,0,0.60) 50%,
            rgba(0,0,0,0.75) 100%
        );
        z-index: 1;
    }

    /* Grid de pontos */
    .grid-overlay {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle, rgba(0,242,255,0.08) 1px, transparent 1px);
        background-size: 40px 40px;
        z-index: 2;
        pointer-events: none;
    }

    /* Linha de scan */
    .scan-line {
        position: absolute;
        left: 0; right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--cyan), transparent);
        opacity: 0.25;
        z-index: 3;
        animation: scanMove 6s linear infinite;
    }

    .hero-content {
        position: relative;
        z-index: 4;
        max-width: 820px;
    }

    /* Badge IA */
    .ai-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(0,242,255,0.1);
        border: 1px solid rgba(0,242,255,0.35);
        color: var(--cyan-bright);
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 8px 18px;
        border-radius: 100px;
        margin-bottom: 24px;
    }
    .ai-dot {
        width: 8px; height: 8px;
        background: var(--cyan);
        border-radius: 50%;
        animation: pulse 1.8s ease-in-out infinite;
    }

    /* Título */
    .hero-title {
        font-size: clamp(2.4rem, 5.5vw, 4.4rem);
        font-weight: 800;
        color: #fff;
        line-height: 1.1;
        margin-bottom: 20px;
        letter-spacing: -0.02em;
    }
    .cyan-text { color: var(--cyan); }

    /* Subtítulo */
    .hero-subtitle {
        font-size: 1.05rem;
        color: var(--text-dim);
        margin-bottom: 36px;
        max-width: 600px;
        line-height: 1.6;
    }

    /* Search box */
    .search-area { width: 100%; max-width: 680px; margin-bottom: 40px; }
    .search-box {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255,255,255,0.96);
        border: 2px solid #ddd;
        border-radius: var(--radius);
        padding: 8px 8px 8px 18px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        transition: border-color 0.2s;
    }
    .search-box:focus-within { border-color: var(--cyan); }
    .search-icon { flex-shrink: 0; }
    .search-input {
        flex: 1;
        border: none;
        background: transparent;
        color: #111;
        font-size: 0.95rem;
        font-weight: 500;
        outline: none;
    }
    .search-input::placeholder { color: #888; }
    .search-btn {
        background: var(--cyan);
        color: #000;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 12px 28px;
        border-radius: var(--radius-sm);
        transition: all 0.25s;
        white-space: nowrap;
    }
    .search-btn:hover { background: #00ffff; transform: translateY(-2px); }

    /* Stats */
    .hero-stats { display: flex; gap: 48px; }
    .hero-stat { display: flex; flex-direction: column; gap: 4px; }
    .stat-num { font-size: 2rem; font-weight: 800; color: #fff; line-height: 1; }
    .stat-label { font-size: 0.78rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.06em; }

    /* ════════════════════════════════════
       PRODUCTS SECTION
    ════════════════════════════════════ */
    .products-section {
        background: var(--bg-dark);
        min-height: 100vh;
        padding: 60px 0 100px;
    }
    .products-container {
        max-width: 1480px;
        margin: 0 auto;
        padding: 0 24px;
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 40px;
        align-items: start;
    }

    /* ── SIDEBAR ── */
    .filters-sidebar {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 28px;
        position: sticky;
        top: 100px;
    }
    .filters-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
    }
    .filters-header h3 { color: #fff; font-size: 1rem; font-weight: 700; }
    .clear-filters {
        background: transparent;
        color: var(--cyan-bright);
        border: 1px solid rgba(0,242,255,0.4);
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.78rem;
        font-weight: 600;
        transition: all 0.2s;
    }
    .clear-filters:hover { background: var(--cyan); color: #000; }

    .filter-group { margin-bottom: 24px; }
    .filter-label {
        display: block;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--text-dim);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 10px;
    }
    .filter-options { display: flex; flex-wrap: wrap; gap: 8px; }
    .filter-chip {
        background: rgba(255,255,255,0.04);
        color: var(--text-dim);
        border: 1px solid var(--border);
        padding: 6px 14px;
        border-radius: 100px;
        font-size: 0.82rem;
        font-weight: 500;
        transition: all 0.2s;
    }
    .filter-chip:hover { border-color: var(--cyan); color: var(--cyan); }
    .filter-chip.active {
        background: rgba(0,242,255,0.12);
        border-color: var(--cyan);
        color: var(--cyan-bright);
        font-weight: 700;
    }

    /* Range slider */
    .range-slider {
        width: 100%;
        -webkit-appearance: none;
        height: 4px;
        background: rgba(255,255,255,0.12);
        border-radius: 2px;
        outline: none;
        margin-bottom: 6px;
    }
    .range-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 18px; height: 18px;
        border-radius: 50%;
        background: var(--cyan);
        cursor: pointer;
        border: 2px solid #000;
        box-shadow: 0 0 8px var(--cyan-glow);
    }
    .range-labels {
        display: flex;
        justify-content: space-between;
        font-size: 0.72rem;
        color: var(--text-dim);
    }

    /* Select */
    .filter-select {
        width: 100%;
        background: rgba(255,255,255,0.05);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 10px 14px;
        font-size: 0.85rem;
        outline: none;
        cursor: pointer;
        transition: border-color 0.2s;
    }
    .filter-select:focus { border-color: var(--cyan); }

    /* ── RESULTS ── */
    .results-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }
    .results-count { color: var(--text-dim); font-size: 0.9rem; }
    .view-toggle { display: flex; gap: 4px; }
    .view-btn {
        background: rgba(255,255,255,0.05);
        color: var(--text-dim);
        border: 1px solid var(--border);
        width: 36px; height: 36px;
