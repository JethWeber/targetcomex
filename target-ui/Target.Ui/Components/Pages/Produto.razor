    /* Staggered reveal delays */
    .cars-grid .anim-reveal:nth-child(1) { transition-delay: 0.00s; }
    .cars-grid .anim-reveal:nth-child(2) { transition-delay: 0.07s; }
    .cars-grid .anim-reveal:nth-child(3) { transition-delay: 0.14s; }
    .cars-grid .anim-reveal:nth-child(4) { transition-delay: 0.21s; }
    .cars-grid .anim-reveal:nth-child(5) { transition-delay: 0.28s; }
    .cars-grid .anim-reveal:nth-child(6) { transition-delay: 0.35s; }
