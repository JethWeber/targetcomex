<!-- ══════════════════════════════════════════════════════
     CÓDIGO C# (LÓGICA BLAZOR)
══════════════════════════════════════════════════════ -->
@code {

    // ── Modelo ──────────────────────────────────────────
    record Veiculo(
        int    Id,
        string Nome,
        string Marca,
        string Combustivel,
        string Transmissao,
        string Motor,
        int    Potencia,
        int    Ano,
        long   Preco,
        int    ScoreIA,
        string Localizacao,
        string Imagem
    );

    // ── Estado dos filtros ───────────────────────────────
    string termoBusca   = "";
    HashSet<string> filtroCombus  = new();
    HashSet<string> filtroMarca   = new();
    HashSet<string> filtroTransm  = new();
    int    filtroAnoMin  = 2018;
    long   filtroPrecoMax = 900_000_000;
    string ordenacao     = "relevancia";
    bool   viewGrid      = true;

    HashSet<int> favoritos = new();

    void Navegar(int id) => Nav.NavigateTo($"/detalhes-veiculo/{id}");


    // ── Opções dos filtros ───────────────────────────────
    List<string> opcoesCombus = new() { "Elétrico", "Híbrido", "Gasolina", "Diesel" };
    List<string> opcoesMarca  = new() { "BMW", "Mercedes", "Toyota", "Audi", "Tesla", "Hyundai" };
    List<string> opcoesTransm = new() { "Automática", "Manual" };

    // ── Dados carregados da API ───────────────────────────
    List<Veiculo> veiculos = new();
    List<Veiculo> veiculosFiltrados = new();
    List<MaisComprado> maisComprados = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadVeiculosAsync();
        await LoadMaisCompradosAsync();
        AplicarFiltros();
    }

    async Task LoadMaisCompradosAsync()
    {
        var result = await Api.GetMaisCompradosAsync(6);
        if (result.Success)
        {
            maisComprados = result.Data.Select(v => new MaisComprado(
                v.Id,
                v.Marca ?? string.Empty,
                v.Modelo ?? string.Empty,
                v.Ano,
                v.ImagemUrl ?? "img/cars/default.jpg",
                v.Preco,
                v.TotalCompras
            )).ToList();
        }
        else
        {
            maisComprados = new();
        }
    }

    async Task LoadVeiculosAsync()
    {
        var result = await Api.GetVeiculosAsync();
        if (result.Success)
        {
            veiculos = result.Data.Select(MapVeiculo).ToList();
        }
        else
        {
            veiculos = new();
        }
    }

    static Veiculo MapVeiculo(VeiculoDto v)
        => new(
            v.Id,
            $"{v.Marca} {v.Modelo}",
            v.Marca,
            v.Combustivel ?? "N/A",
            v.Transmissao ?? "N/A",
            v.Motor ?? "N/A",
            v.Potencia ?? 0,
            v.Ano,
            (long)Math.Round(v.Preco),
            v.Disponivel ? 92 : 74,
            v.Localizacao ?? "Localização não disponível",
            v.ImagemUrl ?? "img/cars/default.jpg"
        );

    void AplicarFiltros()
    {
        var q = veiculos.AsEnumerable();

        // Busca por texto
        if (!string.IsNullOrWhiteSpace(termoBusca))
        {
            var t = termoBusca.ToLower();
            q = q.Where(v => v.Nome.ToLower().Contains(t) ||
                              v.Marca.ToLower().Contains(t) ||
                              v.Motor.ToLower().Contains(t));
        }

        // Combustível
        if (filtroCombus.Any())
            q = q.Where(v => filtroCombus.Contains(v.Combustivel));

        // Marca
        if (filtroMarca.Any())
            q = q.Where(v => filtroMarca.Contains(v.Marca));

        // Transmissão
        if (filtroTransm.Any())
            q = q.Where(v => filtroTransm.Contains(v.Transmissao));

        // Ano
        q = q.Where(v => v.Ano >= filtroAnoMin);

        // Preço
        q = q.Where(v => v.Preco <= filtroPrecoMax);

        // Ordenação
        q = ordenacao switch
        {
            "preco-asc"  => q.OrderBy(v => v.Preco),
            "preco-desc" => q.OrderByDescending(v => v.Preco),
            "ano-desc"   => q.OrderByDescending(v => v.Ano),
            "nome-asc"   => q.OrderBy(v => v.Nome),
            _            => q.OrderByDescending(v => v.ScoreIA)
        };

        veiculosFiltrados = q.ToList();
    }

    void LimparFiltros()
    {
        termoBusca    = "";
        filtroCombus  = new();
        filtroMarca   = new();
        filtroTransm  = new();
        filtroAnoMin  = 2018;
        filtroPrecoMax = 900_000_000;
        ordenacao     = "relevancia";
        AplicarFiltros();
    }

    void ToggleFiltro(HashSet<string> set, string valor)
    {
        if (!set.Add(valor)) set.Remove(valor);
        AplicarFiltros();
    }

    void ToggleFavorito(int id)
    {
        if (!favoritos.Add(id)) favoritos.Remove(id);
    }

    record MaisComprado
    (
        int Id,
        string Marca,
        string Modelo,
        int Ano,
        string ImagemUrl,
        decimal Preco,
        int TotalCompras
    );

    // Scroll reveal via JS interop (inicializado uma vez)
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Task.Delay(100); // pequena pausa para DOM estar pronto
    }
}

<!-- Scroll Reveal (JavaScript) -->
<script>
(function () {
    'use strict';
    var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
            if (e.isIntersecting) e.target.classList.add('visible');
        });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

    function observe() {
        document.querySelectorAll('.anim-reveal').forEach(function(el) {
            io.observe(el);
        });
    }

    // Observa imediatamente e re-observa quando Blazor re-renderiza
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', observe);
    } else {
        observe();
    }

    // Re-observa após navegações Blazor (componente já montado)
    var mo = new MutationObserver(function() { observe(); });
    mo.observe(document.body, { childList: true, subtree: true });
})();
</script>