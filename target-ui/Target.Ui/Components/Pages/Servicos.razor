@page "/servicos"

<!-- ══════════════════════════════════════════════════════
     HERO
══════════════════════════════════════════════════════ -->
<section class="sv-hero">
    <div class="sv-hero-bg"></div>
    <div class="sv-hero-overlay"></div>
    <div class="sv-grid-dots"></div>
    <div class="sv-scan-line"></div>

    <div class="sv-hero-content">
        <div class="sv-badge anim-up" style="--d:0.1s">
            <span class="sv-badge-dot"></span>
            Motores Alvo — Centro de Serviço
        </div>
        <h1 class="sv-hero-title anim-up" style="--d:0.25s">
            A Oficina Mais<br/>
            <span class="sv-cyan sv-glitch" data-text="Avançada de Angola">Avançada de Angola</span>
        </h1>
        <p class="sv-hero-sub anim-up" style="--d:0.4s">
            Mais de 150.000 pés quadrados de tecnologia automotiva premium,<br/>
            movimentando 50+ veículos por dia com precisão cirúrgica.
        </p>

        <div class="sv-hero-stats anim-up" style="--d:0.6s">
            <div class="sv-stat">
                <span class="sv-stat-num">150K</span>
                <span class="sv-stat-label">pés quadrados</span>
            </div>
            <div class="sv-stat-sep"></div>
            <div class="sv-stat">
                <span class="sv-stat-num sv-cyan">50<span class="sv-stat-plus">+</span></span>
                <span class="sv-stat-label">veículos/dia</span>
            </div>
            <div class="sv-stat-sep"></div>
            <div class="sv-stat">
                <span class="sv-stat-num">All</span>
                <span class="sv-stat-label">marcas cobertas</span>
            </div>
            <div class="sv-stat-sep"></div>
            <div class="sv-stat">
                <span class="sv-stat-num sv-cyan">EV</span>
                <span class="sv-stat-label">ready</span>
            </div>
        </div>

        <a href="#servicos" class="sv-scroll-cta anim-up" style="--d:0.8s">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M12 5v14M5 12l7 7 7-7"/>
            </svg>
            Ver Serviços
        </a>
    </div>
</section>

<!-- ══════════════════════════════════════════════════════
     SERVIÇOS PRINCIPAIS
══════════════════════════════════════════════════════ -->
<section class="sv-section" id="servicos">
    <div class="sv-container">
        <div class="sv-section-header">
            <div class="sv-section-eyebrow">O que oferecemos</div>
            <h2 class="sv-section-title">Serviços Completos<br/><span class="sv-cyan">de Reparação</span></h2>
            <p class="sv-section-desc">
                Uma gama completa de serviços pós-venda para todas as marcas,
                com técnicos certificados e equipamento de última geração.
            </p>
        </div>

        <div class="sv-services-grid">
            @foreach (var s in servicos)
            {
                <div class="sv-service-card anim-reveal">
                    <div class="sv-service-icon">@((MarkupString)s.Icon)</div>
                    <div class="sv-service-body">
                        <h3 class="sv-service-name">@s.Nome</h3>
                        <p class="sv-service-desc">@s.Descricao</p>
                    </div>
                    <div class="sv-service-arrow">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ══════════════════════════════════════════════════════
     DIVISÃO DE SERVIÇOS AUTOMÓVEIS (PREMIUM)
══════════════════════════════════════════════════════ -->
<section class="sv-premium-section">
    <div class="sv-container">
        <div class="sv-premium-grid">
            <!-- Texto -->
            <div class="sv-premium-text">
                <div class="sv-section-eyebrow">Divisão Premium</div>
                <h2 class="sv-premium-title">
                    Divisão de Serviços<br/>
                    <span class="sv-cyan">Automóveis</span>
                </h2>
                <p class="sv-premium-desc">
                    Uma instalação automotiva premium dedicada ao atendimento high-end
                    para veículos de luxo e elétricos. Diagnósticos avançados, manutenção
                    de rotina, reparos mecânicos e elétricos, carroceria e detalhamento
                    completo — tudo com padrões do fabricante.
                </p>

                <div class="sv-premium-features">
                    @foreach (var f in premiumFeatures)
                    {
                        <div class="sv-pf-item">
                            <div class="sv-pf-dot"></div>
                            <span>@f</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Cards de destaque -->
            <div class="sv-premium-cards">
                <div class="sv-pc-card sv-pc-top">
                    <div class="sv-pc-icon">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                            <path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="sv-pc-title">Scanners Avançados</div>
                        <div class="sv-pc-sub">Última tecnologia em diagnóstico</div>
                    </div>
                </div>
                <div class="sv-pc-card sv-pc-mid">
                    <div class="sv-pc-icon">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                        </svg>
                    </div>
                    <div>
                        <div class="sv-pc-title">Luxo + EV Ready</div>
                        <div class="sv-pc-sub">Ferramentas exclusivas para elétricos</div>
                    </div>
                </div>
                <div class="sv-pc-card sv-pc-bot">
                    <div class="sv-pc-icon">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="sv-pc-title">Padrão do Fabricante</div>
                        <div class="sv-pc-sub">Serviço especial para todas as marcas</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ══════════════════════════════════════════════════════
     CONTACTO
══════════════════════════════════════════════════════ -->
<section class="sv-contact-section">
    <div class="sv-container">
        <div class="sv-contact-grid">
            <div class="sv-contact-text">
                <div class="sv-section-eyebrow">Fale Connosco</div>
                <h2 class="sv-contact-title">Entre Em<br/><span class="sv-cyan">Contacto</span></h2>
                <p class="sv-contact-desc">
                    A nossa equipa está pronta para receber o seu veículo
                    e oferecer o serviço que merece.
                </p>
            </div>

            <div class="sv-contact-cards">
                <div class="sv-contact-card">
                    <div class="sv-cc-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                        </svg>
                    </div>
                    <div>
                        <div class="sv-cc-label">Endereço</div>
                        <div class="sv-cc-value">Rua Villa De Gamek, Morobento<br/>Luanda, Angola</div>
                    </div>
                </div>

                <div class="sv-contact-card">
                    <div class="sv-cc-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.58 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.55a16 16 0 0 0 6.55 6.55l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="sv-cc-label">Telefone</div>
                        <div class="sv-cc-value">+244 959 288 88<br/>+244 944 615 961</div>
                    </div>
                </div>

                <div class="sv-contact-card sv-contact-cta">
                    <div class="sv-cta-text">
                        <div class="sv-cc-label">Marcar Serviço</div>
                        <div class="sv-cc-value">Agende a sua visita online</div>
                    </div>
                    <button class="sv-btn-agendar">
                        Agendar Agora
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ══════════════════════════════════════════════════════
     ESTILOS
══════════════════════════════════════════════════════ -->
<style>
    :root {
        --cyan: #00f2ff;
        --cyan-bright: #40f8ff;
        --cyan-glow: rgba(0,242,255,0.22);
        --bg: #080808;
        --bg-card: #111111;
        --bg-card2: #161616;
        --border: rgba(255,255,255,0.07);
        --border-c: rgba(0,242,255,0.25);
        --text: #f0f0f0;
        --text-dim: #999;
        --radius: 16px;
        --radius-sm: 10px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    button { border: none; cursor: pointer; font-family: inherit; }
    a { text-decoration: none; }

    /* ── ANIMAÇÕES ── */
    @@keyframes scanMove  { 0% { top: -2px; } 100% { top: 100%; } }
    @@keyframes pulseGlow { 0%,100% { opacity:1; } 50% { opacity:0.35; } }
    @@keyframes slideUp   { from { opacity:0; transform:translateY(28px); } to { opacity:1; transform:translateY(0); } }
    @@keyframes glitch {
        0%   { clip-path:inset(0 0 98% 0); transform:translate(-3px,0); }
        15%  { clip-path:inset(40% 0 40% 0); transform:translate(3px,0); }
        30%  { clip-path:inset(70% 0 10% 0); transform:translate(-2px,0); }
        50%  { clip-path:inset(0 0 0 0); transform:translate(0,0); }
        100% { clip-path:inset(0 0 0 0); transform:translate(0,0); }
    }
    @@keyframes barReveal { from { width:0 !important; } }

    .anim-up {
        opacity: 0;
        animation: slideUp 0.7s cubic-bezier(0.22,1,0.36,1) forwards;
        animation-delay: var(--d, 0s);
    }
    .anim-reveal {
        opacity: 0;
        transform: translateY(36px);
        transition: opacity 0.6s cubic-bezier(0.22,1,0.36,1), transform 0.6s cubic-bezier(0.22,1,0.36,1);
    }
    .anim-reveal.visible { opacity: 1; transform: translateY(0); }

    .sv-cyan { color: var(--cyan); }

    /* Glitch */
    .sv-glitch { position: relative; display: inline-block; }
    .sv-glitch::before, .sv-glitch::after {
        content: attr(data-text);
        position: absolute; left: 0; top: 0;
        color: var(--cyan); width: 100%;
    }
    .sv-glitch::before {
        text-shadow: 2px 0 #ff00ea;
        animation: glitch 5s infinite linear alternate-reverse;
        opacity: 0.6;
    }
    .sv-glitch::after {
        text-shadow: -2px 0 var(--cyan);
        animation: glitch 4s infinite linear alternate;
        opacity: 0.45;
    }

    /* ════════════ HERO ════════════ */
    .sv-hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        overflow: hidden;
        z-index: 0;
    }
    .sv-hero-bg {
        position: absolute; inset: 0;
        background: url('img/banner2.jpeg') center / cover no-repeat;
        z-index: 0;
    }
    .sv-hero-overlay {
        position: absolute; inset: 0;
        background: linear-gradient(135deg, rgba(0,0,0,0.93) 0%, rgba(0,0,0,0.7) 55%, rgba(0,0,0,0.85) 100%);
        z-index: 1;
    }
    .sv-grid-dots {
        position: absolute; inset: 0;
        background-image: radial-gradient(circle, rgba(0,242,255,0.07) 1px, transparent 1px);
        background-size: 44px 44px;
        z-index: 2; pointer-events: none;
    }
    .sv-scan-line {
        position: absolute; left: 0; right: 0; height: 2px;
        background: linear-gradient(90deg, transparent, var(--cyan), transparent);
        opacity: 0.2; z-index: 3;
        animation: scanMove 8s linear infinite;
    }
    .sv-hero-content {
        position: relative; z-index: 4;
        padding: 140px 60px 80px;
        max-width: 860px;
    }

    /* Badge */
    .sv-badge {
        display: inline-flex; align-items: center; gap: 10px;
        background: rgba(0,242,255,0.08);
        border: 1px solid rgba(0,242,255,0.3);
        color: var(--cyan-bright);
        font-size: 0.75rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.1em;
        padding: 8px 20px; border-radius: 100px;
        margin-bottom: 28px;
    }
    .sv-badge-dot {
        width: 8px; height: 8px;
        background: var(--cyan); border-radius: 50%;
        animation: pulseGlow 1.8s ease-in-out infinite;
    }

    .sv-hero-title {
        font-size: clamp(2.6rem, 6vw, 5rem);
        font-weight: 900; color: #fff;
        line-height: 1.05; letter-spacing: -0.025em;
        margin-bottom: 22px;
    }
    .sv-hero-sub {
        font-size: 1.05rem; color: var(--text-dim);
        line-height: 1.7; margin-bottom: 44px;
        max-width: 620px;
    }

    /* Stats */
    .sv-hero-stats {
        display: flex; align-items: center; gap: 32px;
        margin-bottom: 44px;
    }
    .sv-stat { display: flex; flex-direction: column; gap: 4px; }
    .sv-stat-num {
        font-size: 2.2rem; font-weight: 900; color: #fff; line-height: 1;
    }
    .sv-stat-plus { font-size: 1.4rem; }
    .sv-stat-label { font-size: 0.7rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.07em; }
    .sv-stat-sep { width: 1px; height: 44px; background: rgba(255,255,255,0.12); }

    /* Scroll CTA */
    .sv-scroll-cta {
        display: inline-flex; align-items: center; gap: 10px;
        color: rgba(255,255,255,0.5); font-size: 0.82rem; font-weight: 600;
        border: 1px solid rgba(255,255,255,0.14);
        padding: 12px 22px; border-radius: 100px;
        transition: all 0.25s;
    }
    .sv-scroll-cta:hover { color: var(--cyan); border-color: var(--cyan); }

    /* ════════════ LAYOUT ════════════ */
    .sv-container {
        max-width: 1380px;
        margin: 0 auto;
        padding: 0 32px;
    }
    .sv-section {
        background: var(--bg);
        padding: 90px 0;
    }
    .sv-section-header {
        text-align: center;
        margin-bottom: 60px;
    }
    .sv-section-eyebrow {
        font-size: 0.72rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.14em;
        color: var(--cyan); margin-bottom: 12px;
    }
    .sv-section-title {
        font-size: clamp(2rem, 3.5vw, 3rem);
        font-weight: 900; color: #fff;
        line-height: 1.1; letter-spacing: -0.02em;
        margin-bottom: 18px;
    }
    .sv-section-desc {
        font-size: 0.95rem; color: var(--text-dim);
        line-height: 1.7; max-width: 560px; margin: 0 auto;
    }

    /* ════════════ SERVICES GRID ════════════ */
    .sv-services-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }
    .sv-service-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 26px 24px;
        display: flex; align-items: flex-start; gap: 16px;
        position: relative; overflow: hidden;
        transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s;
        cursor: default;
    }
    .sv-service-card::before {
        content: '';
        position: absolute; inset: 0;
        background: linear-gradient(135deg, rgba(0,242,255,0.04) 0%, transparent 60%);
        opacity: 0; transition: opacity 0.3s;
    }
    .sv-service-card:hover {
        border-color: var(--border-c);
        box-shadow: 0 0 28px var(--cyan-glow);
        transform: translateY(-4px);
    }
    .sv-service-card:hover::before { opacity: 1; }

    /* Stagger delays */
    .sv-services-grid .anim-reveal:nth-child(1) { transition-delay: 0.00s; }
    .sv-services-grid .anim-reveal:nth-child(2) { transition-delay: 0.07s; }
    .sv-services-grid .anim-reveal:nth-child(3) { transition-delay: 0.14s; }
    .sv-services-grid .anim-reveal:nth-child(4) { transition-delay: 0.21s; }
    .sv-services-grid .anim-reveal:nth-child(5) { transition-delay: 0.28s; }
    .sv-services-grid .anim-reveal:nth-child(6) { transition-delay: 0.35s; }
    .sv-services-grid .anim-reveal:nth-child(7) { transition-delay: 0.42s; }
    .sv-services-grid .anim-reveal:nth-child(8) { transition-delay: 0.49s; }
    .sv-services-grid .anim-reveal:nth-child(9) { transition-delay: 0.56s; }

    .sv-service-icon {
        width: 46px; height: 46px; flex-shrink: 0;
        background: rgba(0,242,255,0.08);
        border: 1px solid rgba(0,242,255,0.2);
        border-radius: 12px;
        display: grid; place-items: center;
        color: var(--cyan);
    }
    .sv-service-body { flex: 1; }
    .sv-service-name {
        font-size: 0.95rem; font-weight: 700; color: #fff;
        margin-bottom: 6px; line-height: 1.3;
    }
    .sv-service-desc {
        font-size: 0.8rem; color: var(--text-dim); line-height: 1.6;
    }
    .sv-service-arrow {
        color: rgba(0,242,255,0.3);
        flex-shrink: 0; align-self: center;
        transition: color 0.2s, transform 0.2s;
    }
    .sv-service-card:hover .sv-service-arrow {
        color: var(--cyan); transform: translateX(4px);
    }

    /* ════════════ PREMIUM ════════════ */
    .sv-premium-section {
        background: var(--bg-card2);
        padding: 100px 0;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
    }
    .sv-premium-grid {
        display: grid;
        grid-template-columns: 1fr 420px;
        gap: 80px;
        align-items: center;
    }
    .sv-premium-title {
        font-size: clamp(2rem, 3.5vw, 3rem);
        font-weight: 900; color: #fff;
        line-height: 1.1; letter-spacing: -0.02em;
        margin-bottom: 20px;
    }
    .sv-premium-desc {
        font-size: 0.92rem; color: var(--text-dim);
        line-height: 1.8; margin-bottom: 32px;
    }
    .sv-premium-features {
        display: flex; flex-direction: column; gap: 12px;
    }
    .sv-pf-item {
        display: flex; align-items: center; gap: 14px;
        font-size: 0.88rem; color: var(--text);
    }
    .sv-pf-dot {
        width: 7px; height: 7px; flex-shrink: 0;
        background: var(--cyan); border-radius: 50%;
        box-shadow: 0 0 8px var(--cyan-glow);
    }

    /* Premium cards */
    .sv-premium-cards { display: flex; flex-direction: column; gap: 14px; }
    .sv-pc-card {
        display: flex; align-items: center; gap: 18px;
        padding: 22px 24px;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        transition: border-color 0.25s, box-shadow 0.25s;
    }
    .sv-pc-card:hover {
        border-color: var(--border-c);
        box-shadow: 0 0 22px var(--cyan-glow);
    }
    .sv-pc-top { background: linear-gradient(135deg, rgba(0,242,255,0.1), rgba(0,242,255,0.03)); border-color: rgba(0,242,255,0.25); }
    .sv-pc-mid { background: var(--bg-card); }
    .sv-pc-bot { background: var(--bg-card); }
    .sv-pc-icon {
        width: 52px; height: 52px; flex-shrink: 0;
        background: rgba(0,242,255,0.1);
        border: 1px solid rgba(0,242,255,0.25);
        border-radius: 14px;
        display: grid; place-items: center;
        color: var(--cyan);
    }
    .sv-pc-title { font-size: 0.95rem; font-weight: 700; color: #fff; margin-bottom: 3px; }
    .sv-pc-sub   { font-size: 0.78rem; color: var(--text-dim); }

    /* ════════════ CONTACT ════════════ */
    .sv-contact-section {
        background: var(--bg);
        padding: 100px 0;
    }
    .sv-contact-grid {
        display: grid;
        grid-template-columns: 380px 1fr;
        gap: 80px;
        align-items: start;
    }
    .sv-contact-title {
        font-size: clamp(2rem, 3vw, 2.8rem);
        font-weight: 900; color: #fff;
        line-height: 1.1; letter-spacing: -0.02em;
        margin-bottom: 16px;
    }
    .sv-contact-desc {
        font-size: 0.9rem; color: var(--text-dim); line-height: 1.7;
    }
    .sv-contact-cards { display: flex; flex-direction: column; gap: 14px; }
    .sv-contact-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 24px;
        display: flex; align-items: flex-start; gap: 16px;
        transition: border-color 0.25s;
    }
    .sv-contact-card:hover { border-color: var(--border-c); }
    .sv-cc-icon {
        width: 44px; height: 44px; flex-shrink: 0;
        background: rgba(0,242,255,0.08);
        border: 1px solid rgba(0,242,255,0.2);
        border-radius: 10px;
        display: grid; place-items: center;
        color: var(--cyan);
    }
