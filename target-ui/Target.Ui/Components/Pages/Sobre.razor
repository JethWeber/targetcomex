    /* ── RESPONSIVE ── */
    @@media (max-width: 1100px) {
        .sb-story-grid   { grid-template-columns: 1fr; gap: 48px; }
        .sb-marcas-grid  { grid-template-columns: repeat(2, 1fr); }
        .sv-contact-grid { grid-template-columns: 1fr; gap: 40px; }
    }
    @@media (max-width: 900px) {
        .sb-values-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @@media (max-width: 768px) {
        .sv-hero-content { padding: 120px 24px 60px; }
        .sv-container    { padding: 0 20px; }
        .sv-hero-stats   { flex-wrap: wrap; gap: 20px; }
        .sv-stat-sep     { display: none; }
        .sb-values-grid  { grid-template-columns: 1fr; }
        .sb-marcas-grid  { grid-template-columns: repeat(2, 1fr); }
        .sb-tl-item      { grid-template-columns: 100px 1fr; }
        .sb-timeline::before { left: 50px; }
        .sb-tl-card      { margin-left: 20px; }
        .sb-tl-dot       { left: -26px; }
    }
    @@media (max-width: 480px) {
        .sb-marcas-grid { grid-template-columns: 1fr; }
        .sb-story-kpis  { grid-template-columns: 1fr 1fr; }
    }
</style>

